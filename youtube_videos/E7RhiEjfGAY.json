    {
      "start": 741.56,
      "end": 744.28,
      "text": "視為重量級手段的反協破工具"
    },
    {
      "start": 744.28,
      "end": 746.44,
      "text": "內容涵蓋關稅與貿易必來"
    },
    {
      "start": 746.44,
      "end": 748.04,
      "text": "暫停金融服務合作"
    },
    {
      "start": 748.04,
      "end": 750.4,
      "text": "審查中國對歐直接投資"
    },
    {
      "start": 750.4,
      "end": 753.36,
      "text": "禁止中國企業參與歐盟公共採購"
    },
    {
      "start": 753.36,
      "end": 754.72,
      "text": "暫停技術轉讓"
    },
    {
      "start": 754.72,
      "end": 756.32,
      "text": "加強出口審查"
    },
    {
      "start": 756.32,
      "end": 758.88,
      "text": "切斷中國銀行進入歐盟金融市場"
    },
    {
      "start": 758.88,
      "end": 760.48,
      "text": "對特定人員和企業"
    },
    {
      "start": 760.48,
      "end": 762.36,
      "text": "實施制裁等多項內容"
    },
    {
      "start": 762.36,
      "end": 763.04,
      "text": "此外"
    },
    {
      "start": 763.04,
      "end": 765.2,
      "text": "近期歐委會還在準備推出"
    },
    {
      "start": 765.2,
      "end": 766.64,
      "text": "產能過剩工具"
    },
    {
      "start": 766.64,
      "end": 769.16,
      "text": "進一步擴充對華政策工具箱"
    },
    {
      "start": 769.1999999999999,
      "end": 771.28,
      "text": "這一整套政策體系的邏輯"
    },
    {
      "start": 771.28,
      "end": 773.6,
      "text": "歐盟自己也有清晰的表述"
    },
    {
      "start": 773.6,
      "end": 774.36,
      "text": "他們認為"
    },
    {
      "start": 774.36,
      "end": 776.0,
      "text": "中國的出口競爭優勢"
    },
    {
      "start": 776.0,
      "end": 777.64,
      "text": "並非單純來自效率"
    },
    {
      "start": 777.64,
      "end": 779.12,
      "text": "而是與政府補貼"
    },
    {
      "start": 779.12,
      "end": 780.92,
      "text": "國內市場消費相對不足"
    },
    {
      "start": 780.92,
      "end": 782.36,
      "text": "導致的產能過剩"
    },
    {
      "start": 782.36,
      "end": 783.8399999999999,
      "text": "以及人民幣匯率偏低"
    },
    {
      "start": 783.8399999999999,
      "end": 785.28,
      "text": "共同作用的結果"
    },
    {
      "start": 785.28,
      "end": 786.56,
      "text": "在這種判斷下"
    },
    {
      "start": 786.56,
      "end": 788.8399999999999,
      "text": "單純的關稅手段已經不夠了"
    },
    {
      "start": 788.8399999999999,
      "end": 790.1999999999999,
      "text": "還需要從匯率"
    },
    {
      "start": 790.1999999999999,
      "end": 790.9599999999999,
      "text": "供應鏈"
    },
    {
      "start": 790.9599999999999,
      "end": 791.92,
      "text": "技術管控"
    },
    {
      "start": 791.92,
      "end": 794.68,
      "text": "投資審查等多個圍堵同步施壓"
    },
    {
      "start": 794.68,
      "end": 797.0799999999999,
      "text": "才能形成有效的在平衡機制"
    },
    {
      "start": 797.0799999999999,
      "end": 798.28,
      "text": "而在歐洲政界"
    },
    {
      "start": 798.28,
      "end": 800.24,
      "text": "和部分經濟界人士看來"
    },
    {
      "start": 800.24,
      "end": 801.92,
      "text": "人民幣的低估狀態"
    },
    {
      "start": 801.92,
      "end": 803.0799999999999,
      "text": "正是中國產品"
    },
    {
      "start": 803.0799999999999,
      "end": 805.36,
      "text": "在歐洲市場取得價格優勢的"
    },
    {
      "start": 805.36,
      "end": 806.6,
      "text": "重要因素之一"
    },
    {
      "start": 806.6,
      "end": 809.3199999999999,
      "text": "這種優勢並非完全來自市場競爭"
    },
    {
      "start": 809.3199999999999,
      "end": 810.72,
      "text": "而是與貨幣政策"
    },
    {
      "start": 810.72,
      "end": 812.4,
      "text": "導向密切相關"
    },
    {
      "start": 812.4,
      "end": 812.92,
      "text": "此時"
    },
    {
      "start": 812.92,
      "end": 815.24,
      "text": "莫詞和拉加德相繼發聲"
    },
    {
      "start": 815.24,
      "end": 816.52,
      "text": "代表歐洲在面對"
    },
    {
      "start": 816.52,
      "end": 818.0,
      "text": "自身產業壓力時"
    },
    {
      "start": 818.0,
      "end": 820.64,
      "text": "正在形成新的政策共識的信號"
    },
    {
      "start": 820.64,
      "end": 822.88,
      "text": "廣場協議被拿出來作為參照"
    },
    {
      "start": 822.88,
      "end": 823.72,
      "text": "折射出的是"
    },
    {
      "start": 823.72,
      "end": 826.0,
      "text": "歐洲對於如何在多邊框架內"
    },
    {
      "start": 826.0,
      "end": 828.6,
      "text": "尋求對話與在平衡的一種思考"
    },
    {
      "start": 828.6,
      "end": 829.24,
      "text": "不過"
    },
    {
      "start": 829.24,
      "end": 831.96,
      "text": "廣場協議之所以在當年能夠實施"
    },
    {
      "start": 831.96,
      "end": 833.8,
      "text": "有其特定的歷史條件"
    },
    {
      "start": 833.8,
      "end": 834.88,
      "text": "今天的中國"
    },
    {
      "start": 834.88,
      "end": 836.36,
      "text": "無論在經濟體諒"
    },
    {
      "start": 836.36,
      "end": 836.92,
      "text": "政策"
    },
    {
      "start": 836.92,
      "end": 837.64,
      "text": "工具儲備"
    },
    {
      "start": 837.64,
      "end": 839.2,
      "text": "還是外交獨立性上"
    },
    {
      "start": 839.2,
      "end": 841.04,
      "text": "都與1985年的日本"
    },
    {
      "start": 841.04,
      "end": 842.8,
      "text": "處於截然不同的位置"
    },
    {
      "start": 842.8,
      "end": 844.84,
      "text": "拉加德自己也承認了這一點"
    },
    {
      "start": 844.84,
      "end": 846.68,
      "text": "但歐洲提出這個議題本身"
    },
    {
      "start": 846.68,
      "end": 848.12,
      "text": "說明在會律"
    },
    {
      "start": 848.12,
      "end": 850.64,
      "text": "補貼產能這些核心議題上"
    },
    {
      "start": 850.64,
      "end": 853.64,
      "text": "歐盟尋求系統性在平衡的政策意願"
    },
    {
      "start": 853.64,
      "end": 855.68,
      "text": "正在從幕後走向台前"
    },
    {
      "start": 855.6800000000001,
      "end": 857.1600000000001,
      "text": "並逐步轉化為一套"
    },
    {
      "start": 857.1600000000001,
      "end": 858.6800000000001,
      "text": "從倡議到立法"
    },
    {
      "start": 858.6800000000001,
      "end": 861.84,
      "text": "從關稅到規則的完整政策體系"
    },
    {
      "start": 861.84,
      "end": 862.6400000000001,
      "text": "這個趨勢"
    },
    {
      "start": 862.6400000000001,
      "end": 864.5200000000001,
      "text": "無論最終走到哪個地步"
    },
    {
      "start": 864.5200000000001,
      "end": 866.36,
      "text": "都將在相當長的時間裡"
    },
    {
      "start": 866.36,
      "end": 868.6400000000001,
      "text": "持續影響中歐經貿關係的走向"
    }
  ]
}