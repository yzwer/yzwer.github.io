    {
      "start": 270.3,
      "end": 272.9,
      "text": "用於擴展AI基礎設施和算力"
    },
    {
      "start": 272.9,
      "end": 274.5,
      "text": "博客系二就是通過這輪"
    },
    {
      "start": 274.5,
      "end": 276.7,
      "text": "私募配受參與進去的"
    },
    {
      "start": 276.7,
      "end": 278.5,
      "text": "投的這100億美元里"
    },
    {
      "start": 278.5,
      "end": 280.5,
      "text": "一般是A類普通谷"
    },
    {
      "start": 280.5,
      "end": 282.6,
      "text": "一般是C類股票"
    },
    {
      "start": 282.6,
      "end": 285.2,
      "text": "這次操作被市場認為是格雷格"
    },
    {
      "start": 285.2,
      "end": 287.2,
      "text": "Alphabet出任CEO以來"
    },
    {
      "start": 287.2,
      "end": 288.8,
      "text": "最有份量的一筆投資"
