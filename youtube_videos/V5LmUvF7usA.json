    {
      "start": 247.8,
      "end": 249.3,
      "text": "前五大池商合計"
    },
    {
      "start": 249.3,
      "end": 252.3,
      "text": "佔了整個股票組合的66%"
    },
    {
      "start": 252.3,
      "end": 254.8,
      "text": "要知道2025年3季度"
    },
    {
      "start": 254.8,
      "end": 257.4,
      "text": "博客系二才第一次建倉股哥"
    },
    {
      "start": 257.4,
      "end": 260.1,
      "text": "當時谷歌還只是第十大重倉股"
    },
    {
      "start": 260.1,
      "end": 262.5,
      "text": "短短幾個季度就衝進前五"
    },
    {
      "start": 262.5,
      "end": 263.9,
      "text": "速度相當快"
    },
    {
      "start": 263.9,
      "end": 266.3,
      "text": "這比投資的背景也挺有意思"
    },
    {
      "start": 266.3,
      "end": 267.5,
      "text": "今年6月初"
