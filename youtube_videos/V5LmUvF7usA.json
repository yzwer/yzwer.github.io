    {
      "start": 241.0,
      "end": 242.0,
      "text": "排在蘋果"
    },
    {
      "start": 242.0,
      "end": 243.1,
      "text": "美國運通"
    },
    {
      "start": 243.1,
      "end": 244.0,
      "text": "可可可樂"
