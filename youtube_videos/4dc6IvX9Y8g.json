      "text": "這麼一個聽局級幹部"
    },
    {
      "start": 84.12,
      "end": 86.12,
      "text": "從來沒當過黨政一把手"
    },
    {
      "start": 86.12,
      "end": 88.64,
      "text": "是怎麼能貪到22個億的呢"
    },
    {
      "start": 88.64,
      "end": 90.24000000000001,
      "text": "這就得說說開發區"
    },
    {
      "start": 90.24000000000001,
      "end": 92.04,
      "text": "這個特殊的存在了"
    },
    {
      "start": 92.04,
      "end": 93.80000000000001,
      "text": "開發區在很多地方"
    },
    {
      "start": 93.80000000000001,
      "end": 96.0,
      "text": "被稱為經濟發展主陣地"
    },
    {
      "start": 96.0,
      "end": 97.60000000000001,
      "text": "權力高度集中"
    },
    {
      "start": 97.60000000000001,
      "end": 99.64,
      "text": "財政收入封閉運行"
    },
    {
      "start": 99.64,
      "end": 101.52000000000001,
      "text": "用人權 審批權"
    },
    {
      "start": 101.52000000000001,
      "end": 103.2,
      "text": "基本都是自己說了算"
    },
    {
      "start": 103.2,
      "end": 105.36000000000001,
      "text": "用體制內具流行語講"
    },
    {
      "start": 105.36000000000001,
      "end": 108.04,
      "text": "叫開發區的錢自己花"
    },
    {
      "start": 108.04,
      "end": 109.80000000000001,
      "text": "開發區的人自己用"
    },
    {
      "start": 109.80000000000001,
      "end": 111.84,
      "text": "開發區的項目自己批"
    },
    {
      "start": 111.84,
      "end": 113.32000000000001,
      "text": "楊有林長期扎根"
    },
    {
      "start": 113.32000000000001,
      "end": 115.32000000000001,
      "text": "南京 江寧開發區系統"
    },
    {
      "start": 115.32000000000001,
      "end": 117.52000000000001,
      "text": "一手掌管著江寧開發區"
    },
    {
      "start": 117.52000000000001,
      "end": 118.68,
      "text": "江寧科學員"
    },
    {
      "start": 118.68,
      "end": 121.32000000000001,
      "text": "陸口華商員三大園區"
    },
    {
      "start": 121.32000000000001,
      "end": 123.60000000000001,
      "text": "這三塊地方的財政收入"
    },
    {
      "start": 123.60000000000001,
      "end": 125.84,
      "text": "佔了整個江寧區財政收入的"
    },
    {
      "start": 125.84,
      "end": 127.32000000000001,
      "text": "70%以上"
    },
    {
      "start": 127.32000000000001,
      "end": 129.76000000000002,
      "text": "人稱江寧區的第一號人物"
    },
    {
      "start": 129.76000000000002,
      "end": 130.92000000000002,
      "text": "一個人手裡賺著"
    },
    {
      "start": 130.92000000000002,
      "end": 133.28,
      "text": "一個區七成的財政命賣"
    },
    {
      "start": 133.28,
      "end": 136.76000000000002,
      "text": "工程呈接 土地出讓資金周轉"
    },
    {
      "start": 136.76000000000002,
      "end": 138.36,
      "text": "樣樣都能插一手"
    },
    {
      "start": 138.36,
      "end": 139.96,
      "text": "心理稍微一動念"
    },
    {
      "start": 139.96,
      "end": 142.24,
      "text": "那真是想不貪都難"
    },
    {
      "start": 142.24,
      "end": 144.44,
      "text": "而這個22.14億"
    },
    {
      "start": 144.56,
      "end": 146.68,
      "text": "也讓楊有林正式登頂"
    },
    {
      "start": 146.68,
      "end": 149.07999999999998,
      "text": "成為1949年以來"
    },
    {
      "start": 149.07999999999998,
      "end": 150.92,
      "text": "全國公開判決中"
    },
    {
      "start": 150.92,
      "end": 154.07999999999998,
      "text": "受惠罪法院認定金額最高的幹部"
    },
    {
      "start": 154.07999999999998,
      "end": 155.72,
      "text": "彼此前的金融第一貪"
    },
    {
      "start": 155.72,
      "end": 157.12,
      "text": "華融公司原董事長"
    },
    {
      "start": 157.12,
      "end": 159.16,
      "text": "賴小明的17.88億"
    },
    {
      "start": 159.16,
      "end": 160.92,
      "text": "還多出4.26億"
    },
    {
      "start": 160.92,
      "end": 162.48,
      "text": "而內蒙古第一貪"
    },
    {
      "start": 162.48,
      "end": 163.96,
      "text": "呼和號特金開區"
    },
    {
      "start": 163.96,
      "end": 166.36,
      "text": "原黨工委書記李建平"
    },
    {
      "start": 166.36,
      "end": 168.64,
      "text": "貪污14.37億"
    },
    {
      "start": 168.64,
      "end": 170.96,
      "text": "華融原總裁白天灰"
    },
    {
      "start": 170.96,
      "end": 173.16,
      "text": "受惠11.08億"
    },
    {
      "start": 173.16,
      "end": 174.48,
      "text": "跟這幾位一筆"
    },
    {
      "start": 174.48,
      "end": 176.68,
      "text": "楊有林這22億多"
    },
    {
      "start": 176.68,
      "end": 178.92,
      "text": "算是斷層式的領先了"
    },
    {
      "start": 178.92,
      "end": 180.4,
      "text": "所以毫無疑問的"
    },
    {
      "start": 180.4,
      "end": 183.0,
      "text": "他也遠遠超過內部工人的貪官"
    },
    {
      "start": 183.0,
      "end": 183.92,
      "text": "死刑紅線"
    },
    {
      "start": 183.92,
      "end": 186.32,
      "text": "貪腐金額一旦超過10個億"
    },
    {
      "start": 186.32,
      "end": 188.56,
      "text": "基本上就是必死無疑"
    },
    {
      "start": 188.56,
      "end": 190.64,
      "text": "其實18大以來"
    },
    {
      "start": 190.64,
      "end": 193.07999999999998,
      "text": "純貪腐的死力值比較罕見"
    },
    {
      "start": 193.07999999999998,
      "end": 195.64,
      "text": "大多死緩或終身監禁"
    },
    {
      "start": 195.64,
      "end": 199.16,
      "text": "因貪腐被判除死刑的一共只有7個人"
    },
    {
      "start": 199.16,
      "end": 199.92,
      "text": "賴小明"
    },
    {
      "start": 199.92000000000002,
      "end": 201.52,
      "text": "張中生趙麗平"
    },
    {
      "start": 201.52,
      "end": 202.32000000000002,
      "text": "趙正勇"
    },
    {
      "start": 202.32000000000002,
      "end": 203.36,
      "text": "李建平"
    },
    {
      "start": 203.36,
      "end": 206.52,
      "text": "白天灰加上現在的楊有林"
    },
    {
      "start": 206.52,
      "end": 209.24,
      "text": "這7個人裡張中生改叛"
    },
    {
      "start": 209.24,
      "end": 210.12,
      "text": "趙正勇"
    },
    {
      "start": 210.12,
      "end": 212.32000000000002,
      "text": "楊有林醫神帶合准"
    },
    {
      "start": 212.32000000000002,
      "end": 214.60000000000002,
      "text": "已經被執行死刑的有4個"
    },
    {
      "start": 214.60000000000002,
      "end": 216.12,
      "text": "分別是賴小明"
    },
    {
      "start": 216.12,
      "end": 216.92000000000002,
      "text": "趙麗平"
    },
    {
      "start": 216.92000000000002,
      "end": 217.84000000000003,
      "text": "李建平"
    },
    {
      "start": 217.84000000000003,
      "end": 218.92000000000002,
      "text": "白天灰"
    },
    {
      "start": 218.92000000000002,
      "end": 220.12,
      "text": "賴小明貪污"
    },
    {
      "start": 220.12,
      "end": 221.96,
      "text": "受惠17.88億"
    },
    {
      "start": 221.96,
      "end": 224.32000000000002,
      "text": "越過紅線已經符法"
    },
    {
      "start": 224.32000000000002,
      "end": 226.96,
      "text": "白天灰貪了11.08億"
    },
    {
      "start": 226.96,
      "end": 228.32000000000002,
      "text": "也已經執行"
    },
    {
      "start": 228.35999999999999,
      "end": 231.68,
      "text": "李建平貪污受惠合計超過10億紅線"
    },
    {
      "start": 231.68,
      "end": 233.07999999999998,
      "text": "同樣被執行"
    },
    {
      "start": 233.07999999999998,
      "end": 235.2,
      "text": "趙麗平比較特殊"
    },
    {
      "start": 235.2,
      "end": 238.12,
      "text": "他貪腐金額本身不算特別誇張"
    },
    {
      "start": 238.12,
      "end": 240.4,
      "text": "但因為非法持有槍之彈藥"
    },
    {
      "start": 240.4,
      "end": 242.12,
      "text": "還跨省殺過人"
    },
    {
      "start": 242.12,
      "end": 243.51999999999998,
      "text": "情節太過惡劣"
    },
    {
      "start": 243.51999999999998,
      "end": 245.32,
      "text": "所以被判除死刑"
    },
    {
      "start": 245.32,
      "end": 246.48,
      "text": "反過來看"
    },
    {
      "start": 246.48,
      "end": 248.84,
      "text": "勞金9.43億的合則華"
    },
    {
      "start": 248.84,
      "end": 251.24,
      "text": "因為沒超過10億這條線"
    },
    {
      "start": 251.24,
      "end": 252.79999999999998,
      "text": "判的是死緩"
    },
    {
      "start": 252.79999999999998,
      "end": 255.28,
      "text": "還有孫德順9.79億"
    },
    {
      "start": 255.28,
      "end": 256.76,
      "text": "也因為沒過限"
    },
    {
      "start": 256.76,
      "end": 258.24,
      "text": "保住了一條老命"
    },
    {
      "start": 258.24,
      "end": 259.24,
      "text": "唯一的例外"
    },
    {
      "start": 259.24,
      "end": 262.24,
      "text": "是山西旅良原副市長張中生"
    },
    {
      "start": 262.24,
      "end": 263.96,
      "text": "他貪了10.4億"
    },
    {
      "start": 263.96,
      "end": 265.24,
      "text": "本來是過限的"
    },
    {
      "start": 265.24,
      "end": 266.59999999999997,
      "text": "但因為主動交代了"
    },
    {
      "start": 266.59999999999997,
      "end": 270.03999999999996,
      "text": "辦案機關上位掌握的大部分犯罪事實"
    },
    {
      "start": 270.03999999999996,
      "end": 273.28,
      "text": "家屬也積極配合追腳髒款髒物"
    },
    {
      "start": 273.28,
      "end": 275.68,
      "text": "還檢舉了他人重大收回線索"
    },
    {
      "start": 275.68,
      "end": 277.28,
      "text": "屬於重大利工"
    },
    {
      "start": 277.28,
      "end": 278.76,
      "text": "最終改叛死緩"
    },
    {
      "start": 278.76,
      "end": 279.96,
      "text": "終身監禁"
    },
    {
      "start": 279.96,
      "end": 282.15999999999997,
      "text": "這是目前唯一的一個特例"
    },
    {
      "start": 282.15999999999997,
      "end": 283.48,
      "text": "在乎第二例"
    },
    {
      "start": 283.48,
      "end": 284.68,
      "text": "也有人會說"
    },
    {
      "start": 284.68,
      "end": 287.72,
      "text": "還有比十億大的多的貪官沒判死刑"
    },
    {
      "start": 287.72,
      "end": 289.96,
      "text": "比如橫風銀行的蔡國華"
    },
    {
      "start": 289.96,
      "end": 292.52,
      "text": "賬面上貪污11.8億"
    },
    {
      "start": 292.52,
      "end": 293.96,
      "text": "但這裡要注意"
    },
    {
      "start": 293.96,
      "end": 296.6,
      "text": "這11.8億里有10.7億"
    },
    {
      "start": 296.6,
      "end": 297.76,
      "text": "其實是位歲"
    },
    {
      "start": 297.76,
      "end": 300.08,
      "text": "真正到手的只有1.1億"
    },
    {
      "start": 300.08,
      "end": 302.08,
      "text": "所以最後是死緩"
    },
    {
      "start": 302.08,
      "end": 303.12,
      "text": "所以說"
    },
    {
      "start": 303.12,
      "end": 304.4,
      "text": "這條紅線看的是"
    },
    {
      "start": 304.4,
      "end": 306.08,
      "text": "最終被官方認定"
    },
    {
      "start": 306.08,
      "end": 308.08,
      "text": "且已經計算的金額"
    },
    {
      "start": 308.08,
      "end": 309.56,
      "text": "按這個標準來看"
    },
    {
      "start": 309.56,
      "end": 312.08,
      "text": "楊有林這22.14億"
    },
    {
      "start": 312.08,
      "end": 314.28000000000003,
      "text": "全部是計算金額"
    },
    {
      "start": 314.28000000000003,
      "end": 316.48,
      "text": "遠超紅線一倍還多"
    },
    {
      "start": 316.48,
      "end": 317.56,
      "text": "被判死刑"
    },
    {
      "start": 317.56,
      "end": 320.28000000000003,
      "text": "其實也在很多人的預料之中"
    },
    {
      "start": 320.28000000000003,
      "end": 322.72,
      "text": "但是很多人不知道的一點是"
    },
    {
      "start": 322.72,
      "end": 325.00000000000006,
      "text": "楊有林其實早在17年前"
    },
    {
      "start": 325.00000000000006,
      "end": 327.32000000000005,
      "text": "就已經被媒體舉報揭發過了"
    },
    {
      "start": 327.32000000000005,
      "end": 330.36,
      "text": "我們把時間到回2008年"
    },
    {
      "start": 330.36,
      "end": 332.44000000000005,
      "text": "當時將與建設集團"
    },
    {
      "start": 332.44000000000005,
      "end": 334.16,
      "text": "財務部副部長楊海"
    },
    {
      "start": 334.16,
      "end": 336.96000000000004,
      "text": "因為拒絕在一份假材料上簽字"
    },
    {
      "start": 336.96000000000004,
      "end": 339.68,
      "text": "遭到了楊有林等人的打擊報復"
    },
    {
      "start": 339.68,
      "end": 342.52000000000004,
      "text": "甚至到了預製其餘死地的地步"
    },
    {
      "start": 342.52000000000004,
      "end": 344.04,
      "text": "2008年7月"
    },
    {
      "start": 344.08000000000004,
      "end": 346.0,
      "text": "楊海悄悄離開南京"
    },
    {
      "start": 346.0,
      "end": 348.68,
      "text": "懷傳著舉報信和17本公司內部"
    },
    {
      "start": 348.68,
      "end": 349.8,
      "text": "政策材料"
    },
    {
      "start": 349.8,
      "end": 352.36,
      "text": "向中紀委最高人民檢查院"
    },
    {
      "start": 352.36,
      "end": 353.48,
      "text": "實名舉報"
    },
    {
      "start": 353.48,
      "end": 356.08000000000004,
      "text": "只稱將與建設集團的經營層"
    },
    {
      "start": 356.08000000000004,
      "end": 357.12,
      "text": "將號等人"
    },
    {
      "start": 357.12,
      "end": 358.84000000000003,
      "text": "以及時任將您開發區"
    },
    {
      "start": 358.84000000000003,
      "end": 360.0,
      "text": "常務副主任"
    },
    {
      "start": 360.0,
      "end": 362.8,
      "text": "開發區總公司總經理的楊有林"
    },
    {
      "start": 362.8,
      "end": 365.20000000000005,
      "text": "涉嫌多項重大經濟犯罪"
    },
    {
      "start": 365.20000000000005,
      "end": 367.24,
      "text": "同年11月21日"
    },
    {
      "start": 367.24,
      "end": 368.92,
      "text": "折拒數月的楊海"
    },
    {
      "start": 368.92,
      "end": 370.44,
      "text": "本來已經和南京當地"
    },
    {
      "start": 370.44,
      "end": 371.6,
      "text": "一家媒體約好"
    },
    {
      "start": 371.6,
      "end": 373.28000000000003,
      "text": "準備把手裡全部證據"
    },
    {
      "start": 373.28000000000003,
      "end": 374.48,
      "text": "和盤拖出"
    },
    {
      "start": 374.48,
      "end": 376.20000000000005,
      "text": "結果人還沒出門"
    },
    {
      "start": 376.20000000000005,
      "end": 377.32000000000005,
      "text": "就被帶走了"
    },
    {
      "start": 377.32000000000005,
      "end": 379.16,
      "text": "理由是涉嫌濃湧資金"
    },
    {
      "start": 379.16,
      "end": 382.72,
      "text": "12月被將寧區檢查院批捕"
    },
    {
      "start": 382.72,
      "end": 384.04,
      "text": "被舉報的沒事"
    },
    {
      "start": 384.04,
      "end": 386.12,
      "text": "舉報的人自己反而先進去了"
    },
    {
      "start": 386.12,
      "end": 387.48,
      "text": "可即便如此"
    },
    {
      "start": 387.48,
      "end": 389.56000000000006,
      "text": "相關報導還是出來了"
    },
    {
      "start": 389.56000000000006,
      "end": 391.76000000000005,
      "text": "2009年3月2日"
    },
    {
      "start": 391.76000000000005,
      "end": 392.76000000000005,
      "text": "新華社旗下"
    },
    {
      "start": 392.76000000000005,
      "end": 394.04,
      "text": "廖望東方周刊"
    },
    {
      "start": 394.04,
      "end": 395.08000000000004,
      "text": "記者李衛"
    },
    {
      "start": 395.08000000000004,
      "end": 397.04,
      "text": "發表了一篇調查報導"
    },
    {
      "start": 397.04,
      "end": 400.04,
      "text": "題目較高速擴張的奇蹟背後"
    },
    {
      "start": 400.04,
      "end": 401.20000000000005,
      "text": "這篇報導裡"
    },
    {
      "start": 401.2,
      "end": 403.47999999999996,
      "text": "李衛不僅採訪了舉報人楊海"
    },
    {
      "start": 403.47999999999996,
      "end": 404.64,
      "text": "南京廣播學院"
    },
    {
      "start": 404.64,
      "end": 406.24,
      "text": "園董事長菩蘇林"
    },
    {
      "start": 406.24,
      "end": 407.96,
      "text": "還採訪了南廣學院院長"
    },
    {
      "start": 407.96,
      "end": 409.71999999999997,
      "text": "辦公室主任趙雪波"
    },
    {
      "start": 409.71999999999997,
      "end": 412.28,
      "text": "董事劉亞文進行交叉核時"
    },
    {
      "start": 412.28,
      "end": 413.56,
      "text": "甚至直接採訪了"
    },
    {
      "start": 413.56,
      "end": 414.88,
      "text": "被舉報的江羽集團"
    },
    {
      "start": 414.88,
      "end": 416.64,
      "text": "法定代表人江浩"
    },
    {
      "start": 416.64,
      "end": 417.84,
      "text": "以及被指控為"
    },
    {
      "start": 417.84,
      "end": 420.28,
      "text": "幕後操盤者的楊有林本人"
    },
    {
      "start": 420.28,
      "end": 421.56,
      "text": "報導裡披露離套"
    },
    {
      "start": 421.56,
      "end": 424.24,
      "text": "林成本化工為私的操作手法"
    },
    {
      "start": 424.24,
      "end": 425.56,
      "text": "2000年"
    },
    {
      "start": 425.56,
      "end": 426.88,
      "text": "國有的南京"
    },
    {
      "start": 426.88,
      "end": 428.59999999999997,
      "text": "江寧經濟技術開發區"
    },
    {
      "start": 428.59999999999997,
      "end": 430.15999999999997,
      "text": "市政工程公司"
    },
    {
      "start": 430.16,
      "end": 433.8,
      "text": "被作賬做成資產總額1.98億元"
    },
    {
      "start": 433.8,
      "end": 436.6,
      "text": "競資產付340萬元"
    },
    {
      "start": 436.6,
      "end": 438.04,
      "text": "照面作雄之後"
    },
    {
      "start": 438.04,
      "end": 441.24,
      "text": "公司高管從這家國企借款100萬元"
    },
    {
      "start": 441.24,
      "end": 443.48,
      "text": "另外成立一家私人公司"
    },
    {
      "start": 443.48,
      "end": 445.28000000000003,
      "text": "然後以領袁的價格"
    },
    {
      "start": 445.28000000000003,
      "end": 447.96000000000004,
      "text": "把整個國有市政公司買了下來"
    },
    {
      "start": 447.96000000000004,
      "end": 450.04,
      "text": "這就是所謂的領資產改制"
    },
    {
      "start": 450.04,
      "end": 452.12,
      "text": "說白了就是空手套白狼"
    },
    {
      "start": 452.12,
      "end": 455.64000000000004,
      "text": "把國有資產直接搗通成了私人財產"
    },
    {
      "start": 455.64000000000004,
      "end": 457.28000000000003,
      "text": "根據楊海的舉報"
    },
    {
      "start": 457.28000000000003,
      "end": 460.08000000000004,
      "text": "江羽集團通過各種名目臀基土地"
    },
    {
      "start": 460.08000000000004,
      "end": 461.84000000000003,
      "text": "至少3000目以上"
    },
    {
      "start": 461.84000000000003,
      "end": 463.84000000000003,
      "text": "成結了從淹酒銷售"
    },
    {
      "start": 463.84000000000003,
      "end": 466.52000000000004,
      "text": "到工程建設的各種政府訂單"
    },
    {
      "start": 466.52000000000004,
      "end": 468.88000000000005,
      "text": "每年營收達到30億"
    },
    {
      "start": 468.88000000000005,
      "end": 471.12,
      "text": "將號甚至毫不匯言的表示"
    },
    {
      "start": 471.12,
      "end": 472.20000000000005,
      "text": "政府答應我們"
    },
    {
      "start": 472.20000000000005,
      "end": 474.40000000000003,
      "text": "把老城改造項目都給我們"
    },
    {
      "start": 474.40000000000003,
      "end": 476.32000000000005,
      "text": "項目多的做不安"
    },
    {
      "start": 476.32000000000005,
      "end": 477.96000000000004,
      "text": "江羽集團曾和一名叫"
    },
    {
      "start": 477.96000000000004,
      "end": 479.40000000000003,
      "text": "普舒林的商人"
    },
    {
      "start": 479.40000000000003,
      "end": 482.32000000000005,
      "text": "一起和開立所民辦傳媒學院"
    },
    {
      "start": 482.32000000000005,
      "end": 484.72,
      "text": "一次學校門口要修一段路"
    },
    {
      "start": 484.72,
      "end": 486.52000000000004,
      "text": "普舒林招標後發現"
    },
    {
      "start": 486.56,
      "end": 488.52,
      "text": "別的公司報價都是20萬"
    },
    {
      "start": 488.52,
      "end": 490.84,
      "text": "而江羽報價高達80萬"
    },
    {
      "start": 490.84,
      "end": 493.52,
      "text": "普舒林在股東會上好奇的問"
    },
    {
      "start": 493.52,
      "end": 496.44,
      "text": "怎麼自己的股東連自己都坑"
    },
    {
      "start": 496.44,
      "end": 498.68,
      "text": "江羽一方的董事校道"
    },
    {
      "start": 498.68,
      "end": 499.56,
      "text": "在江寧"
    },
    {
      "start": 499.56,
      "end": 501.64,
      "text": "我們修路都是這個價"
    },
    {
      "start": 501.64,
      "end": 503.4,
      "text": "可是這麼賺錢的公司"
    },
    {
      "start": 503.4,
      "end": 506.0,
      "text": "到了稅務部門那裡卻變得很窮"
    },
    {
      "start": 506.0,
      "end": 507.15999999999997,
      "text": "2001年"
    },
    {
      "start": 507.15999999999997,
      "end": 508.91999999999996,
      "text": "市政公司和建築公司"
    },
    {
      "start": 508.91999999999996,
      "end": 511.03999999999996,
      "text": "稅後利潤只有100萬"
    },
    {
      "start": 511.03999999999996,
      "end": 512.92,
      "text": "而舉報材料顯示"
    },
    {
      "start": 512.92,
      "end": 514.16,
      "text": "楊有林本人"
    },
    {
      "start": 514.16,
      "end": 516.36,
      "text": "雖然不在江羽集團掛植"
    },
    {
      "start": 516.36,
      "end": 518.16,
      "text": "表面上也不吃股"
    },
    {
      "start": 518.16,
      "end": 520.64,
      "text": "但他才是真正的幕後操盤者"
    },
    {
      "start": 520.64,
      "end": 521.92,
      "text": "一手策劃組建了"
    },
    {
      "start": 521.92,
      "end": 524.64,
      "text": "江羽戲公司作為自己的謀利平台"
    },
    {
      "start": 524.64,
      "end": 526.2,
      "text": "利用手中的權利"
    },
    {
      "start": 526.2,
      "end": 528.96,
      "text": "為這些私人公司大量輸送利益"
    },
    {
      "start": 528.96,
      "end": 530.16,
      "text": "更關鍵的是"
    },
    {
      "start": 530.16,
      "end": 532.16,
      "text": "通過戶籍資料合時"
    },
    {
      "start": 532.16,
      "end": 534.28,
      "text": "並且基本人當面確認"
    },
    {
      "start": 534.28,
      "end": 536.44,
      "text": "楊有林還是一個裸官"
    },
    {
      "start": 536.44,
      "end": 538.24,
      "text": "他的妻子和女兒"
    },
    {
      "start": 538.24,
      "end": 541.44,
      "text": "早在2001年就已經拿到了美國國籍"
    },
    {
      "start": 541.44,
      "end": 543.44,
      "text": "並在國外構制了房產"
    },
    {
      "start": 543.44,
      "end": 546.32,
      "text": "國內戶籍資料上只剩他一個人"
    },
    {
      "start": 546.32,
      "end": 547.6400000000001,
      "text": "家人在國外"
    },
    {
      "start": 547.6400000000001,
      "end": 548.84,
      "text": "財產在國外"
    },
    {
      "start": 548.84,
      "end": 550.44,
      "text": "本人在國內當官"
    },
    {
      "start": 550.44,
      "end": 552.32,
      "text": "這就是典型的裸官"
    },
    {
      "start": 552.32,
      "end": 555.96,
      "text": "裸官這個詞是在2008年發明的"
    },
    {
      "start": 555.96,
      "end": 557.48,
      "text": "他手創於安徽省"
    },
    {
      "start": 557.48,
      "end": 559.48,
      "text": "屋服市政協常委周彭安"
    },
    {
      "start": 559.48,
      "end": 562.0,
      "text": "2008年7月3日發布的文章"
    },
    {
      "start": 562.0,
      "end": 564.6,
      "text": "還有多少貪官在裸體做官"
    },
    {
      "start": 564.6,
      "end": 565.88,
      "text": "而在這之前"
    },
    {
      "start": 565.88,
      "end": 567.6800000000001,
      "text": "最有名的裸官故事"
    },
    {
      "start": 567.6800000000001,
      "end": 571.0,
      "text": "是福建省工商局原局長周金火"
    },
    {
      "start": 571.0,
      "end": 573.7600000000001,
      "text": "早早把老婆孩子安排去了美國"
    },
    {
      "start": 573.76,
      "end": 576.0,
      "text": "情婦帶著孩子一句香港"
    },
    {
      "start": 576.0,
      "end": 578.4,
      "text": "2006年被雙規之前"
    },
    {
      "start": 578.4,
      "end": 579.72,
      "text": "他直接出逃"
    },
    {
      "start": 579.72,
      "end": 582.12,
      "text": "還在辦公桌上留了張紙條"
    },
    {
      "start": 582.12,
      "end": 583.4399999999999,
      "text": "告訴基檢部門"
    },
    {
      "start": 583.4399999999999,
      "end": 584.6,
      "text": "不用非進找我了"
    },
    {
      "start": 584.6,
      "end": 586.4,
      "text": "堪稱赤裸裸的挑釁"
    },
    {
      "start": 586.4,
      "end": 588.12,
      "text": "說回李偉這篇報導"
    },
    {
      "start": 588.12,
      "end": 589.28,
      "text": "沒發出多久"
    },
    {
      "start": 589.28,
      "end": 592.2,
      "text": "很快就從各大網路平台上消失了"
    },
    {
      "start": 592.2,
      "end": 594.2,
      "text": "只在一些貼拔角落裡"
    },
    {
      "start": 594.2,
      "end": 596.56,
      "text": "殘留下零星的轉發文本"
    },
    {
      "start": 596.56,
      "end": 597.68,
      "text": "但半年之後"
    },
    {
      "start": 597.68,
      "end": 600.3199999999999,
      "text": "同屬新華社旗下的經濟參考報"
    },
    {
      "start": 600.32,
      "end": 602.4000000000001,
      "text": "在2009年8月12日"
    },
    {
      "start": 602.4000000000001,
      "end": 604.2800000000001,
      "text": "又接力發理篇報導"
    },
    {
      "start": 604.2800000000001,
      "end": 604.96,
      "text": "標題是"
    },
    {
      "start": 604.96,
      "end": 606.48,
      "text": "一個畫功為私"
    },
    {
      "start": 606.48,
      "end": 608.6,
      "text": "精吞國資的典型樣本"
    },
    {
      "start": 608.6,
      "end": 610.88,
      "text": "南京將與集團全體股東"
    },
    {
      "start": 610.88,
      "end": 613.08,
      "text": "被指射罪的事件調查"
    },
    {
      "start": 613.08,
      "end": 615.32,
      "text": "內容和李偉的報導基本呼應"
    },
    {
      "start": 615.32,
      "end": 616.32,
      "text": "只是這一次"
    },
    {
      "start": 616.32,
      "end": 618.5600000000001,
      "text": "沒有再提裸官這個細節"
    },
    {
      "start": 618.5600000000001,
      "end": 620.0,
      "text": "報導發布的時候"
    },
    {
      "start": 620.0,
      "end": 621.5600000000001,
      "text": "有關部門也表態說"
    },
    {
      "start": 621.5600000000001,
      "end": 623.9200000000001,
      "text": "已經對此展開了外圍調查"
    },
    {
      "start": 623.9200000000001,
      "end": 625.0,
      "text": "可這之後"
    },
    {
      "start": 625.0,
      "end": 626.32,
      "text": "就在沒有燃後了"
    },
    {
      "start": 626.32,
      "end": 629.1600000000001,
      "text": "成了一條撤頭撤尾的爛尾新聞"
    },
    {
      "start": 629.16,
      "end": 630.4399999999999,
      "text": "也是在這年"
    },
    {
      "start": 630.4399999999999,
      "end": 633.48,
      "text": "圍繞羅官現象的輿論熱度持續發酵"
    },
    {
      "start": 633.48,
      "end": 636.04,
      "text": "推動了制度層面的一些動作"
    },
    {
      "start": 636.04,
      "end": 637.1999999999999,
      "text": "2010年"
    },
    {
      "start": 637.1999999999999,
      "end": 638.56,
      "text": "中半國辦印發"
    },
    {
      "start": 638.56,
      "end": 640.9599999999999,
      "text": "關於對配偶子女軍以移居國"
    },
    {
      "start": 640.9599999999999,
      "end": 642.7199999999999,
      "text": "境外的國家工作人員"
    },
    {
      "start": 642.7199999999999,
      "end": 644.6,
      "text": "加強管理的贊行規定"
    },
    {
      "start": 644.6,
      "end": 645.92,
      "text": "2014年2月"
    },
    {
      "start": 645.92,
      "end": 647.1999999999999,
      "text": "中組部又印發"
    },
    {
      "start": 647.1999999999999,
      "end": 648.36,
      "text": "配偶以移居"
    },
    {
      "start": 648.36,
      "end": 650.24,
      "text": "國境外的國家工作人員"
    },
    {
      "start": 650.24,
      "end": 652.0,
      "text": "任職港位管理辦法"
    },
    {
      "start": 652.0,
      "end": 652.8,
      "text": "明確規定"
    },
    {
      "start": 652.8,
      "end": 656.04,
      "text": "羅官不能擔任黨政機關領導成員港位"
    },
    {
      "start": 656.04,
      "end": 657.3199999999999,
      "text": "國有企事業單位"
    },
    {
      "start": 657.3199999999999,
      "end": 658.6,
      "text": "主要負責人港位"
    },
    {
      "start": 658.6,
      "end": 661.0,
      "text": "以及涉及軍事外交"
    },
    {
      "start": 661.0,
      "end": 662.0400000000001,
      "text": "國家安全"
    },
    {
      "start": 662.0400000000001,
      "end": 663.88,
      "text": "雞藥等重要港位"
    },
    {
      "start": 663.88,
      "end": 665.84,
      "text": "可就是在這樣的制度背景下"
    },
    {
      "start": 665.84,
      "end": 667.88,
      "text": "擁有臨被曝光之後"
    },
    {
      "start": 667.88,
      "end": 669.44,
      "text": "不僅沒有被追責"
    },
    {
      "start": 669.44,
      "end": 670.84,
      "text": "反而在2009年"
    },
    {
      "start": 670.84,
      "end": 673.9200000000001,
      "text": "調任了南京市貿促會分會副會長"
    },
    {
      "start": 673.9200000000001,
      "end": 675.96,
      "text": "業內一般管這種操作"
    },
    {
      "start": 675.96,
      "end": 677.9200000000001,
      "text": "叫一地平調必封頭"
    },
    {
      "start": 677.9200000000001,
      "end": 678.76,
      "text": "在往後"
    },
    {
      "start": 678.76,
      "end": 680.84,
      "text": "他還擔任過南京市屬國企"
    },
    {
      "start": 680.84,
      "end": 684.4,
      "text": "牛首山文化旅遊發展有限公司的董事長"
    },
    {
      "start": 684.4,
      "end": 686.6,
      "text": "牛首山是4A級警區"
    },
    {
      "start": 686.6,
      "end": 690.2,
      "text": "佛頂公里供奉著施加模擬佛頂股設立"
    },
    {
      "start": 690.2,
      "end": 692.64,
      "text": "一個被實名指責化工為私"
    },
    {
      "start": 692.64,
      "end": 694.6,
      "text": "被爆出羅官身份的人"
    },
    {
      "start": 694.6,
      "end": 697.6,
      "text": "轉頭去管理供奉佛股的旅遊項目"
    },
    {
      "start": 697.6,
      "end": 700.8000000000001,
      "text": "這中間的反差確實挺而無語的"
    },
    {
      "start": 700.8000000000001,
      "end": 702.76,
      "text": "讓我們把事情梳理一下"
    },
    {
      "start": 702.76,
      "end": 704.96,
      "text": "一個2008年就已經被舉報"
    },
    {
      "start": 704.96,
      "end": 707.08,
      "text": "證據確早本該落馬的人"
    },
    {
      "start": 707.08,
      "end": 709.9200000000001,
      "text": "一直拖到2023年才真正被查"
    },
    {
      "start": 709.9200000000001,
      "end": 711.6,
      "text": "中間整整15年"
    },
    {
      "start": 711.6,
      "end": 713.44,
      "text": "他是在被公開舉報"
    },
    {
      "start": 713.44,
      "end": 714.84,
      "text": "公開報導之後"
    },
    {
      "start": 714.84,
      "end": 717.44,
      "text": "有安安穩穩地多摊了十幾年"
    },
    {
      "start": 717.44,
      "end": 719.96,
      "text": "而那位最早提供證據的舉報人"
    },
    {
      "start": 719.96,
      "end": 720.84,
      "text": "楊海"
    },
    {
      "start": 720.84,
      "end": 723.84,
      "text": "換來的是涉嫌挪用資金的罪名"
    },
    {
      "start": 723.84,
      "end": 725.12,
      "text": "公開可查信息"
    },
    {
      "start": 725.12,
      "end": 727.96,
      "text": "僅到2009年初的批譜階段"
    },
    {
      "start": 727.96,
      "end": 731.36,
      "text": "後續並無法院判決或釋放的消息"
    },
    {
      "start": 731.36,
      "end": 733.64,
      "text": "楊海當年30歲出頭"
    },
    {
      "start": 733.64,
      "end": 735.9200000000001,
      "text": "現在贏於50歲左右了"
    },
    {
      "start": 735.9200000000001,
      "end": 737.84,
      "text": "這案子公開宣判之後"
    },
    {
      "start": 737.84,
      "end": 739.44,
      "text": "網上也有一些評論"
    },
    {
      "start": 739.44,
      "end": 741.8000000000001,
      "text": "提了幾個挺尖銳的問題"
    },
    {
      "start": 741.8000000000001,
      "end": 744.2,
      "text": "比如判決書理六個罪名中"
    },
    {
      "start": 744.2,
      "end": 745.6800000000001,
      "text": "有一條是行會罪"
    },
    {
      "start": 745.6800000000001,
      "end": 747.72,
      "text": "涉案2500萬宇元"
    },
    {
      "start": 747.72,
      "end": 748.76,
      "text": "那麼問題來了"
    },
    {
      "start": 748.76,
      "end": 750.9200000000001,
      "text": "楊有林到底給誰行會了"
    },
    {
      "start": 750.9200000000001,
      "end": 753.32,
      "text": "收錢的這些人後來是什麼下場"
    },
    {
      "start": 753.32,
      "end": 755.5200000000001,
      "text": "有沒有被同步追責"
    },
    {
      "start": 755.5200000000001,
      "end": 756.6400000000001,
      "text": "還有一個細節"
    },
    {
      "start": 756.6400000000001,
      "end": 758.44,
      "text": "也被不少評論提到"
    },
    {
      "start": 758.44,
      "end": 761.2,
      "text": "這麼一起刷新全國紀錄的巨探答案"
    },
    {
      "start": 761.2,
      "end": 762.44,
      "text": "官方通報說"
    },
    {
      "start": 762.44,
      "end": 765.08,
      "text": "停審是2026年3月18日"
    },
    {
      "start": 765.08,
      "end": 767.76,
      "text": "和4月28日公開開庭審理的"
    },
    {
      "start": 767.76,
      "end": 770.1600000000001,
      "text": "人大代表和各界群眾30予人"
    },
    {
      "start": 770.1600000000001,
      "end": 771.44,
      "text": "旁聽了停審"
    },
    {
      "start": 771.44,
      "end": 772.44,
      "text": "有評論說"
    },
    {
      "start": 772.5600000000001,
      "end": 775.6,
      "text": "從法院公布的宣判現場照片來看"
    },
    {
      "start": 775.6,
      "end": 777.96,
      "text": "旁聽習上還有不少空位"
    },
    {
      "start": 777.96,
      "end": 779.9200000000001,
      "text": "這就讓人有點鬧闷了"
    },
    {
      "start": 779.9200000000001,
      "end": 781.12,
      "text": "這麼大的案子"
    },
    {
      "start": 781.12,
      "end": 782.2800000000001,
      "text": "公開審理"
    },
    {
      "start": 782.2800000000001,
      "end": 784.6,
      "text": "為什麼現場旁聽的人這麼少"
    },
    {
      "start": 784.6,
      "end": 787.6400000000001,
      "text": "是大家對巨探案件已經神仇疲勞了"
    },
    {
      "start": 787.6400000000001,
      "end": 790.1600000000001,
      "text": "還是說真正想去旁聽的人"
    },
    {
      "start": 790.1600000000001,
      "end": 792.4000000000001,
      "text": "實際上很難靠近現場"
    },
    {
      "start": 792.4000000000001,
      "end": 795.6800000000001,
      "text": "如果真有認真關注慘的人在場旁聽"
    },
    {
      "start": 795.6800000000001,
      "end": 797.0,
      "text": "那麼很多細節"
    },
    {
      "start": 797.0,
      "end": 800.5600000000001,
      "text": "比如楊有林到底是怎麼攤到這22億的"
    },
    {
      "start": 800.5600000000001,
      "end": 802.24,
      "text": "從誰手上收的錢"
    },
    {
      "start": 802.24,
      "end": 803.6,
      "text": "給哪些人行會了"
    },
    {
      "start": 803.6,
      "end": 806.28,
      "text": "轉移到境外的資產具體有多少"
    },
    {
      "start": 806.28,
      "end": 808.08,
      "text": "本該能有更多披露"
    },
    {
      "start": 808.08,
      "end": 809.36,
      "text": "但目前來看"
    },
    {
      "start": 809.36,
      "end": 812.76,
      "text": "公開信息基本還是停留在法院通報層面"
    },
    {
      "start": 812.76,
      "end": 814.0,
      "text": "叫為概括"
    },
    {
      "start": 814.0,
      "end": 815.08,
      "text": "更細的東西"
    },
    {
      "start": 815.08,
      "end": 816.88,
      "text": "我們就不得而知了"
    },
    {
      "start": 816.88,
      "end": 817.76,
      "text": "據了解"
    },
    {
      "start": 817.76,
      "end": 819.28,
      "text": "2025年以來"
    },
    {
      "start": 819.28,
      "end": 822.36,
      "text": "全國不少體制內單位付出機以上"
    },
    {
      "start": 822.36,
      "end": 825.24,
      "text": "部分單位甚至擴展到中層幹部"
    },
    {
      "start": 825.24,
      "end": 827.24,
      "text": "被組織集中觀看過一步"
    },
    {
      "start": 827.24,
      "end": 830.92,
      "text": "叫楊有林嚴重危機違法案警失路的片子"
    },
    {
      "start": 830.9200000000001,
      "end": 833.84,
      "text": "目的大概是以案為見強化正設"
    },
    {
      "start": 833.84,
      "end": 837.1200000000001,
      "text": "裡面肯定涉及更多不為人知的細節"
    },
    {
      "start": 837.1200000000001,
      "end": 838.6,
      "text": "所以有評論提出"
    },
    {
      "start": 838.6,
      "end": 841.08,
      "text": "這個案子涉及重大公共利益"
    },
    {
      "start": 841.08,
      "end": 842.32,
      "text": "又是公開審理"
    },
    {
      "start": 842.32,
      "end": 844.5200000000001,
      "text": "那麼審判和判決的想法"
    },
    {
      "start": 844.5200000000001,
      "end": 846.8000000000001,
      "text": "至少應該向全社會公開"
    },
    {
      "start": 846.8000000000001,
      "end": 849.48,
      "text": "而不只是公佈一個最終結果"
    },
    {
      "start": 849.48,
      "end": 850.6400000000001,
      "text": "司法公開"
    },
    {
      "start": 850.6400000000001,
      "end": 852.2,
      "text": "本來應該是原則"
    },
    {
      "start": 852.2,
      "end": 853.8800000000001,
      "text": "保密才是例外"
    },
    {
      "start": 853.8800000000001,
      "end": 857.7600000000001,
      "text": "所以說到底楊有林這個案子"
    },
    {
      "start": 857.7600000000001,
      "end": 859.96,
      "text": "真正值得咱們記住的"
    },
    {
      "start": 859.96,
      "end": 863.88,
      "text": "可能不只是22.14億這個刷新記錄的數字"
    },
    {
      "start": 863.88,
      "end": 865.9200000000001,
      "text": "而是那個恆更了17年"
    },
    {
      "start": 865.9200000000001,
      "end": 868.08,
      "text": "都沒能被回答的問題"
    },
    {
      "start": 868.08,
      "end": 869.9200000000001,
      "text": "為什麼早在2008年"
    },
    {
      "start": 869.9200000000001,
      "end": 871.24,
      "text": "2009年"
    },
    {
      "start": 871.24,
      "end": 872.5600000000001,
      "text": "舉報和媒體報導"
    },
    {
      "start": 872.5600000000001,
      "end": 874.36,
      "text": "就已經擺在明面上了"
    },
    {
      "start": 874.36,
      "end": 875.52,
      "text": "公眾監督"
    },
    {
      "start": 875.52,
      "end": 876.64,
      "text": "輿論監督"
    },
    {
      "start": 876.64,
      "end": 878.64,
      "text": "最後還是沒能攔住他"
    },
    {
      "start": 878.64,
      "end": 881.24,
      "text": "反而是舉報人先進了看守所"
    },
    {
      "start": 881.24,
      "end": 883.6,
      "text": "報導被從網上撤了下來"
    },
    {
      "start": 883.6,
      "end": 886.72,
      "text": "這中間到底是監督機制本身失領了"
    },
    {
      "start": 886.72,
      "end": 889.9200000000001,
      "text": "還是背後存在某種沒有被揭開的力量"
    },
    {
      "start": 890.08,
      "end": 891.9200000000001,
      "text": "必須欲何 slice"
    },
    {
      "start": 892.48,
      "end": 893.8000000000001,
      "text": "と"
    },
    {
      "start": 895.32,
      "end": 895.8000000000001,
      "text": "我們女主人"
    },
    {
      "start": 895.8000000000001,
      "end": 896.6800000000001,
      "text": "與每位外出"
    },
    {
      "start": 896.6800000000001,
      "end": 897.4000000000001,
      "text": "攤尘"
    },
    {
      "start": 897.4000000000001,
      "end": 900.5600000000001,
      "text": "讓大家自政"
    },
    {
      "start": 902.72,
      "end": 904.2,
      "text": "讓大家自政"
    },
    {
      "start": 904.2,
      "end": 905.0400000000001,
      "text": "讓大家自政"
    },
    {
      "start": 905.0400000000001,
      "end": 905.44,
      "text": "讓大家自政"
    },
    {
      "start": 905.44,
      "end": 906.5600000000001,
      "text": "讓大家自政"
    },
    {
      "start": 906.5600000000001,
      "end": 909.2,
      "text": "讓大家自政"
    },
    {
      "start": 910.2,
      "end": 910.96,
      "text": "讓大家自政"
    },
    {
      "start": 910.96,
      "end": 912.2,
      "text": "讓大家自政"
    },
    {
      "start": 912.2,
      "end": 912.6,
      "text": "讓大家自政"
    },
    {
      "start": 912.6,
      "end": 913.5200000000001,
      "text": "讓大家自政"
    },
    {
      "start": 913.72,
      "end": 915.0000000000001,
      "text": "被述生力"
    },
    {
      "start": 915.0000000000001,
      "end": 917.82,
      "text": "被述勾"
    },
    {
      "start": 917.82,
      "end": 919.44,
      "text": "被述勾"
    },
    {
      "start": 919.44,
      "end": 919.8800000000001,
      "text": "被述勾"
    }
  ]
