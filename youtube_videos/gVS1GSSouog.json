    },
    {
      "start": 712.4,
      "end": 713.96,
      "text": "同时海量拋售"
    },
    {
      "start": 713.96,
      "end": 715.0,
      "text": "美元贬值"
    },
    {
      "start": 715.2,
      "end": 716.4399999999999,
      "text": "通脏继续上升"
    },
    {
      "start": 716.68,
      "end": 717.68,
      "text": "不断自我强化"
    },
    {
      "start": 717.68,
      "end": 719.08,
      "text": "形成恶性循环"
    },
    {
      "start": 719.32,
      "end": 720.4,
      "text": "那很可能会是"
    },
    {
      "start": 720.4,
      "end": 722.72,
      "text": "下一场全球金融危机的导火所"
    },
    {
      "start": 723.12,
      "end": 723.6,
      "text": "当然"
    },
    {
      "start": 724.04,
      "end": 725.76,
      "text": "这一切都有个前提变量"
    },
    {
      "start": 725.76,
      "end": 726.96,
      "text": "或是沐斯海峡"
    },
    {
      "start": 726.96,
      "end": 728.76,
      "text": "什么时候能重新唱通"
    },
    {
      "start": 729.24,
      "end": 731.24,
      "text": "如果每一突然握手延合"
    },
    {
      "start": 731.24,
      "end": 732.28,
      "text": "油架落下来"
    },
    {
      "start": 732.28,
      "end": 733.56,
      "text": "通脏预期降温"
    },
    {
      "start": 733.56,
      "end": 735.6,
      "text": "市场情绪必然快速逆转"
    },
    {
      "start": 735.88,
      "end": 738.16,
      "text": "但如果局势一直就这样僵着"
    },
    {
      "start": 738.4399999999999,
      "end": 739.08,
      "text": "那么各位"
    },
    {
      "start": 739.24,
      "end": 740.08,
      "text": "今年之内"
    },
    {
      "start": 740.08,
      "end": 742.2,
      "text": "这场风暴很可能就要降临"
