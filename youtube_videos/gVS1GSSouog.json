    {
      "start": 701.92,
      "end": 703.76,
      "text": "一旦日本真的大复加息"
    },
    {
      "start": 704.0,
      "end": 705.0,
      "text": "这些套利交易"
    },
    {
      "start": 705.0,
      "end": 706.4399999999999,
      "text": "就会大规模平仓"
    },
    {
      "start": 706.72,
      "end": 707.4399999999999,
      "text": "卖美股"
    },
    {
      "start": 707.4399999999999,
      "end": 708.2,
      "text": "卖美债"
    },
    {
      "start": 708.36,
      "end": 709.32,
      "text": "换回日元"
    },
    {
      "start": 709.68,
      "end": 711.36,
      "text": "大家想象一下那个场面"
    },
    {
      "start": 711.36,
      "end": 712.4,
