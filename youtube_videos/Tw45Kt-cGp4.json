    {
      "start": 511.12,
      "end": 513.84,
      "text": "传导到出场价格只剩1%"
    },
    {
      "start": 513.84,
      "end": 516.64,
      "text": "再传导到CPI消费品价格"
    },
    {
      "start": 516.64,
      "end": 518.36,
      "text": "只有0.3%"
    },
    {
      "start": 518.36,
      "end": 519.44,
      "text": "到了4月份"
    },
    {
      "start": 519.44,
      "end": 521.6,
      "text": "购金价格涨2.1%"
    },
    {
      "start": 521.6,
      "end": 524.96,
      "text": "出场价格涨幅缩小到1.7%"
    },
    {
      "start": 524.96,
      "end": 528.7600000000001,
      "text": "消费品价格涨幅进一步缩小到0.1%"
    },
    {
      "start": 528.7600000000001,
      "end": 529.6800000000001,
      "text": "5月份"
    },
    {
      "start": 529.6800000000001,
      "end": 532.0400000000001,
      "text": "购金价格涨1.3%"
    },
    {
      "start": 532.0400000000001,
      "end": 534.5600000000001,
      "text": "出场价格只涨0.5%"
    },
    {
      "start": 534.5600000000001,
      "end": 537.8800000000001,
      "text": "消费品价格反而跌了0.2%"
    },
    {
      "start": 537.8800000000001,
      "end": 538.96,
      "text": "到了6月份"
    },
    {
      "start": 538.96,
      "end": 542.6800000000001,
      "text": "购金价格已经转为环比下跌0.2%"
    },
    {
      "start": 542.6800000000001,
      "end": 545.6400000000001,
      "text": "出场价格跌幅扩大到0.3%"
    },
    {
      "start": 545.6400000000001,
      "end": 547.12,
      "text": "消费品价格跌幅"
    },
    {
      "start": 547.12,
      "end": 549.5600000000001,
      "text": "进一步扩大到0.6%"
    },
    {
      "start": 549.5600000000001,
      "end": 551.68,
      "text": "这条链条清楚地告诉我们"
    },
    {
      "start": 551.68,
      "end": 553.04,
      "text": "涨价传不下去"
    },
    {
      "start": 553.04,
      "end": 555.24,
      "text": "可一跌价去传得很快"
    },
    {
      "start": 555.24,
      "end": 558.04,
      "text": "说明攻击过剩需求不足的问题"
    },
    {
      "start": 558.04,
      "end": 560.48,
      "text": "仍然是当前中国物价体系里"
    },
    {
      "start": 560.48,
      "end": 561.88,
      "text": "最核心的矛盾"
    },
    {
      "start": 561.88,
      "end": 564.08,
      "text": "为什么国内需求持续不足呢"
    },
    {
      "start": 564.08,
      "end": 567.08,
      "text": "前两天世界银行刚发布了一份报告"
    },
    {
      "start": 567.08,
      "end": 570.28,
      "text": "中国经济简报卖向增长在平衡"
    },
    {
      "start": 570.28,
      "end": 571.5600000000001,
      "text": "里面那一组数据"
    },
    {
      "start": 571.5600000000001,
      "end": 573.4,
      "text": "或许能回答这个问题"
    },
    {
      "start": 573.4,
      "end": 574.84,
      "text": "中国财政之处理"
    },
    {
      "start": 574.84,
      "end": 575.5600000000001,
      "text": "修路"
    },
    {
      "start": 575.5600000000001,
      "end": 578.8000000000001,
      "text": "建乔 高产也元区 上大项目"
    },
    {
      "start": 578.8000000000001,
      "end": 580.1600000000001,
      "text": "这些资本性之处"
    },
    {
      "start": 580.1600000000001,
      "end": 582.1600000000001,
      "text": "占比大概43%"
    },
    {
      "start": 582.1600000000001,
      "end": 583.72,
      "text": "而OECD发达国家"
    },
    {
      "start": 583.72,
      "end": 586.48,
      "text": "这个比例只有13.5%"
    },
    {
      "start": 586.48,
      "end": 587.5600000000001,
      "text": "反过来"
    },
    {
      "start": 587.5600000000001,
      "end": 589.32,
      "text": "全国财政之处理"
    },
    {
      "start": 589.32,
      "end": 591.84,
      "text": "卫生 教育 社保这三项"
    },
    {
      "start": 591.84,
      "end": 594.0000000000001,
      "text": "加起来大概28%"
    },
    {
      "start": 594.0000000000001,
      "end": 597.2,
      "text": "OECD国家平均超过60%"
    },
    {
      "start": 597.2,
      "end": 598.0400000000001,
      "text": "也就是说"
    },
    {
      "start": 598.0400000000001,
      "end": 600.0000000000001,
      "text": "目前扔把大量资源"
    },
    {
      "start": 600.0000000000001,
      "end": 601.5200000000001,
      "text": "砸向了硬件建设"
    },
    {
      "start": 601.5200000000001,
      "end": 603.4000000000001,
      "text": "但再让老百姓赶花钱的那些"
    },
    {
      "start": 603.4000000000001,
      "end": 605.5200000000001,
      "text": "软件投入上 明显不够"
    },
    {
      "start": 605.88,
      "end": 608.04,
      "text": "很多人习惯把中国人爱存钱"
    },
    {
      "start": 608.04,
      "end": 609.76,
      "text": "规则为文化问题"
    },
    {
      "start": 609.76,
      "end": 611.76,
      "text": "消费相对比较保守"
    },
    {
      "start": 611.76,
      "end": 613.0799999999999,
      "text": "但真相是"
    },
    {
      "start": 613.0799999999999,
      "end": 614.6,
      "text": "谁天生就愿意把钱"
    },
    {
      "start": 614.6,
      "end": 616.36,
      "text": "压在银行里不花呢"
    },
    {
      "start": 616.36,
      "end": 617.96,
      "text": "是因为不敢不存"
    },
    {
      "start": 617.96,
      "end": 620.0799999999999,
      "text": "养老 医疗 失业"
    },
    {
      "start": 620.0799999999999,
      "end": 621.12,
      "text": "哪一样不是得"
    },
    {
      "start": 621.12,
      "end": 623.48,
      "text": "考自己都理提前背着"
    },
    {
      "start": 623.48,
      "end": 625.6,
      "text": "再看今年具体的数字"
    },
    {
      "start": 625.6,
      "end": 629.24,
      "text": "今年安排了4.4万亿元的新增专项债"
    },
    {
      "start": 629.24,
      "end": 630.4399999999999,
      "text": "截至7月初"
    },
    {
      "start": 630.4399999999999,
      "end": 632.56,
      "text": "已经发行超过2万亿"
    },
    {
      "start": 632.56,
      "end": 634.3199999999999,
      "text": "那么这笔钱去哪儿了呢"
    },
    {
      "start": 634.32,
      "end": 635.8000000000001,
      "text": "市政和产业员区"
    },
    {
      "start": 635.8000000000001,
      "end": 638.2,
      "text": "基础设施占了将近三成"
    },
    {
      "start": 638.2,
      "end": 641.08,
      "text": "交通基础设施占了大概两成"
    },
    {
      "start": 641.08,
      "end": 642.4000000000001,
      "text": "更扎心的是"
    },
    {
      "start": 642.4000000000001,
      "end": 644.2800000000001,
      "text": "这4.4万亿里边"
    },
    {
      "start": 644.2800000000001,
      "end": 648.5200000000001,
      "text": "还有8000亿是专门用来化解存量债务的"
    },
    {
      "start": 648.5200000000001,
      "end": 649.7600000000001,
      "text": "钱刚发出来"
    },
    {
      "start": 649.7600000000001,
      "end": 652.0,
      "text": "转手就填了以前的坑"
    },
    {
      "start": 652.0,
      "end": 653.8000000000001,
      "text": "跟老百姓的日常消费"
    },
    {
      "start": 653.8000000000001,
      "end": 655.5600000000001,
      "text": "一毛钱关系都没有"
    },
    {
      "start": 655.5600000000001,
      "end": 658.48,
      "text": "结果就是 产能进一步扩大"
    },
    {
      "start": 658.48,
      "end": 661.48,
      "text": "但谁来买这些生产出来的商品呢"
    },
    {
      "start": 661.48,
      "end": 663.5200000000001,
      "text": "你都理的工资该涨不涨"
    },
    {
      "start": 663.52,
      "end": 665.48,
      "text": "需求自然也起不来"
    },
    {
      "start": 665.48,
      "end": 667.72,
      "text": "世界银行还给算了一笔账"
    },
    {
      "start": 667.72,
      "end": 670.48,
      "text": "如果把居民养老金提高一倍"
    },
    {
      "start": 670.48,
      "end": 674.0,
      "text": "大概需要占用GDP的0.6%"
    },
    {
      "start": 674.0,
      "end": 676.52,
      "text": "但换来的可能是居民消费"
    },
    {
      "start": 676.52,
      "end": 679.16,
      "text": "提高2%到4%"
    },
    {
      "start": 679.16,
      "end": 683.0799999999999,
      "text": "将居民医疗保险水平提升至职工一宝水平"
    },
    {
      "start": 683.0799999999999,
      "end": 684.52,
      "text": "可分别提升受影响"
    },
    {
      "start": 684.52,
      "end": 686.64,
      "text": "承振家庭和农村家庭消费"
    },
    {
      "start": 686.64,
      "end": 689.52,
      "text": "3.3个百分点和5.6个百分点"
    },
    {
      "start": 689.52,
      "end": 691.52,
      "text": "几千亿到万亿的投入"
    },
    {
      "start": 691.52,
      "end": 694.4399999999999,
      "text": "如果能直接进到老百姓口袋里"
    },
    {
      "start": 694.4399999999999,
      "end": 696.04,
      "text": "拉动的消费效果"
    },
    {
      "start": 696.04,
      "end": 699.56,
      "text": "会远远高于投到基建里的同等资金"
    },
    {
      "start": 699.56,
      "end": 700.48,
      "text": "往后看"
    },
    {
      "start": 700.48,
      "end": 703.92,
      "text": "下半年多数机构的判断比较一致"
    },
    {
      "start": 703.92,
      "end": 705.16,
      "text": "6月份大概率"
    },
    {
      "start": 705.16,
      "end": 708.0,
      "text": "就是今年PPI同比的年内高点了"
    },
    {
      "start": 708.0,
      "end": 709.56,
      "text": "理由主要有两条"
    },
    {
      "start": 709.56,
      "end": 712.6,
      "text": "第一条油架快速下跌的影响"
    },
    {
      "start": 712.6,
      "end": 715.48,
      "text": "在PPI里还没有完全体现出来"
    },
    {
      "start": 715.48,
      "end": 718.76,
      "text": "后续几个月的拖累效应会更加明显"
    },
    {
      "start": 718.8,
      "end": 721.76,
      "text": "第二条低级数效应正在消退"
    },
    {
      "start": 721.76,
      "end": 724.84,
      "text": "油架下跌会把年内简升的七月份"
    },
    {
      "start": 724.84,
      "end": 726.88,
      "text": "低级数效应给抵消掉"
    },
    {
      "start": 726.88,
      "end": 728.3199999999999,
      "text": "从八月份开始"
    },
    {
      "start": 728.3199999999999,
      "end": 729.4399999999999,
      "text": "几数走高"
    },
    {
      "start": 729.4399999999999,
      "end": 732.56,
      "text": "到四季度反而会转为小腹脱累"
    },
    {
      "start": 732.56,
      "end": 734.56,
      "text": "当然这里面也存在变数"
    },
    {
      "start": 734.56,
      "end": 737.08,
      "text": "如果地缘冲突再度距离升级"
    },
    {
      "start": 737.08,
      "end": 739.16,
      "text": "导致不轮特原油现货价格"
    },
    {
      "start": 739.16,
      "end": 741.88,
      "text": "重新冲上每统一百美元左右"
    },
    {
      "start": 741.88,
      "end": 743.56,
      "text": "PPI同比在下半年"
    },
    {
      "start": 743.56,
      "end": 745.56,
      "text": "也有可能再度小腹上行"
    },
    {
      "start": 745.56,
      "end": 748.16,
      "text": "但目前看这个概率并不算高"
    },
    {
      "start": 748.16,
      "end": 750.68,
      "text": "随着美国中期选举日件临近"
    },
    {
      "start": 750.68,
      "end": 751.9599999999999,
      "text": "大规模冲突再起"
    },
    {
      "start": 751.9599999999999,
      "end": 754.48,
      "text": "似乎不太符合川普政府的利益"
    },
    {
      "start": 754.48,
      "end": 756.7199999999999,
      "text": "CPI这边有机构预测"
    },
    {
      "start": 756.7199999999999,
      "end": 759.4399999999999,
      "text": "七月份同比涨幅可能会进一步回落"
    },
    {
      "start": 759.4399999999999,
      "end": 762.0,
      "text": "到百分之零点五到百分之零点七"
    },
    {
      "start": 762.0,
      "end": 763.0799999999999,
      "text": "这个区间"
    },
    {
      "start": 763.0799999999999,
      "end": 763.8399999999999,
      "text": "二月份"
    },
    {
      "start": 763.8399999999999,
      "end": 766.92,
      "text": "中东冲突带来的内波物价扩大行情"
    },
    {
      "start": 766.92,
      "end": 768.4,
      "text": "已经基本消退"
    },
    {
      "start": 768.4,
      "end": 770.56,
      "text": "核心原因除了油架传导之外"
    },
    {
      "start": 770.56,
      "end": 773.76,
      "text": "还有珠州期继续处于低价整理阶段"
    },
    {
      "start": 773.76,
      "end": 776.24,
      "text": "加上去年同期技术台高"
    },
    {
      "start": 776.24,
      "end": 779.48,
      "text": "零售端物价环比大概率会继续下跌"
    },
    {
      "start": 779.48,
      "end": 781.76,
      "text": "同比涨幅会持续回落"
    },
    {
      "start": 781.76,
      "end": 782.92,
      "text": "还有观点认为"
    },
    {
      "start": 782.92,
      "end": 785.4,
      "text": "即便下半年扩内需政策加码"
    },
    {
      "start": 785.4,
      "end": 787.24,
      "text": "鼠期国庆价期"
    },
    {
      "start": 787.24,
      "end": 788.72,
      "text": "带动旅游住宿餐饮"
    },
    {
      "start": 788.72,
      "end": 791.04,
      "text": "这些服务消费价格回升"
    },
    {
      "start": 791.04,
      "end": 792.6800000000001,
      "text": "在迪加设备更新"
    },
    {
      "start": 792.6800000000001,
      "end": 794.8,
      "text": "已就换新政策对加电汽车"
    },
    {
      "start": 794.8,
      "end": 797.28,
      "text": "这些奈用消费品价格的提震"
    },
    {
      "start": 797.28,
      "end": 801.0,
      "text": "也很难从根本上扭转CPI的走势"
    },
    {
      "start": 801.0,
      "end": 803.16,
      "text": "因为在居民收入预期"
    },
    {
      "start": 803.16,
      "end": 804.72,
      "text": "还没有根本改善"
    },
    {
      "start": 804.72,
      "end": 806.0,
      "text": "企业普遍采取"
    },
    {
      "start": 806.0,
      "end": 808.16,
      "text": "已加换量策略的大背景下"
    },
    {
      "start": 808.16,
      "end": 809.36,
      "text": "零售端消费品"
    },
    {
      "start": 809.36,
      "end": 811.76,
      "text": "缺乏持续涨价的基础"
    },
    {
      "start": 811.76,
      "end": 814.44,
      "text": "长价消费带来的零食性影响"
    },
    {
      "start": 814.44,
      "end": 816.88,
      "text": "改变不了长期的价格趋势"
    },
    {
      "start": 816.88,
      "end": 817.56,
      "text": "总之"
    },
    {
      "start": 817.56,
      "end": 819.92,
      "text": "6月的物价数据给我们提了个醒"
    },
    {
      "start": 819.92,
      "end": 821.92,
      "text": "经济复苏的路还很长"
    },
    {
      "start": 821.92,
      "end": 824.56,
      "text": "下半年有可能重回通缩预期"
    },
    {
      "start": 824.56,
      "end": 826.36,
      "text": "想让需求真正回暖"
    },
    {
      "start": 826.36,
      "end": 828.6,
      "text": "光靠零食性的刺激政策"
    },
    {
      "start": 828.6,
      "end": 830.08,
      "text": "是撑不起来的"
    },
    {
      "start": 830.08,
      "end": 831.28,
      "text": "真正的钥匙"
    },
    {
      "start": 831.28,
      "end": 833.52,
      "text": "还是得看财政的支出流量"
    },
    {
      "start": 833.52,
      "end": 836.16,
      "text": "什么时候能多往老百姓的洋牢"
    },
    {
      "start": 836.16,
      "end": 836.88,
      "text": "医疗"
    },
    {
      "start": 836.88,
      "end": 838.72,
      "text": "教育这些地方清血"
    },
    {
      "start": 838.72,
      "end": 840.76,
      "text": "什么时候居民收入预期"
    },
    {
      "start": 840.76,
      "end": 842.0799999999999,
      "text": "能真正扭转"
    },
    {
      "start": 842.0799999999999,
      "end": 843.8,
      "text": "消费和经济增长"
    },
    {
      "start": 843.8,
      "end": 845.64,
      "text": "才有可能进入一个更稳定"
    },
    {
      "start": 845.64,
      "end": 846.96,
      "text": "更可持续的轨道"
    }
  ]
}