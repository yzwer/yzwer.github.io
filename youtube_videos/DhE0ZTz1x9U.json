    {
      "start": 749.36,
      "end": 754.16,
      "text": "就可能需要把iPhone 18 Pro的售價上條大約270美元"
    },
    {
      "start": 754.16,
      "end": 756.6800000000001,
      "text": "這本就引起了不少的負面輿論"
    },
    {
      "start": 756.6800000000001,
      "end": 757.6,
      "text": "另一方面"
    },
    {
      "start": 757.6,
      "end": 761.76,
      "text": "iPhone 18 Pro預計將於2026年9月發布"
    },
    {
      "start": 761.76,
      "end": 763.72,
      "text": "在這個機固眼上發生了史上"
