    {
      "start": 630.16,
      "end": 632.12,
      "text": "已經超過上百億美元"
    },
    {
      "start": 632.16,
      "end": 636.04,
      "text": "直接把印度組裝的iPhone產量提升到了5500萬部"
    },
    {
      "start": 636.04,
      "end": 638.76,
      "text": "佔到了全球總產量的1%"
    },
    {
      "start": 638.76,
      "end": 640.4,
      "text": "而塔塔在這次事件中"
    },
    {
      "start": 640.4,
      "end": 643.36,
      "text": "卻讓蘋果最不想被外界看到的核心機密"
    },
    {
      "start": 643.36,
      "end": 644.76,
      "text": "流向了全世界"
    },
    {
      "start": 644.76,
      "end": 647.72,
      "text": "蘋果對印度供應鏈的信任度"
    },
    {
      "start": 647.72,
      "end": 650.92,
      "text": "大概率會因此打上一個不小的折扣"
    },
    {
      "start": 650.92,
      "end": 652.28,
      "text": "而蘋果自身內套"
    },
    {
      "start": 652.28,
      "end": 654.6,
      "text": "堪稱疊戰級別的防線密體系"
    },
    {
      "start": 654.6,
      "end": 657.2,
      "text": "到了印度工廠卻被輕鬆攻破"
