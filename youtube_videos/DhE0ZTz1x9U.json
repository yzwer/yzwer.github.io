    {
      "start": 692.7600000000001,
      "end": 695.1600000000001,
      "text": "並聘請了全球專業的資訊機構"
    },
    {
      "start": 695.1600000000001,
      "end": 697.08,
      "text": "來開展取證審計"
    },
    {
      "start": 697.08,
      "end": 698.4000000000001,
      "text": "在公開層面"
