      "start": 787.36,
      "end": 789.4,
      "text": "面临的风险非常大"
    },
    {
      "start": 789.4,
      "end": 792.4,
      "text": "说到底这是美国版本的国产替代"
    },
    {
      "start": 792.4,
      "end": 794.76,
      "text": "正在紧罗密谷的推进"
    },
    {
      "start": 794.76,
      "end": 796.84,
      "text": "新一轮的中美科技脱钩"
    },
    {
      "start": 796.84,
      "end": 798.6,
      "text": "只会越来越激烈"
    },
    {
      "start": 798.6,
      "end": 800.04,
      "text": "这一系列变化"
    },
    {
      "start": 800.04,
      "end": 802.16,
      "text": "会对整个股市的定价逻辑"
    },
    {
      "start": 802.16,
      "end": 804.0,
      "text": "带来两个层面的重够"
    },
    {
      "start": 804.0,
      "end": 805.08,
      "text": "第一个层面"
    },
    {
      "start": 805.08,
      "end": 809.08,
      "text": "中国本土光模块企业依赖的海外市场链条"
    },
    {
      "start": 809.08,
      "end": 811.88,
      "text": "会形成长期的利空压制"
    },
    {
      "start": 811.88,
      "end": 814.24,
      "text": "而美国本土的光模块概念"
    },
    {
      "start": 814.24,
      "end": 816.96,
      "text": "会进一步获得力多支撑"
    },
    {
      "start": 816.96,
      "end": 818.04,
      "text": "第二个层面"
    },
    {
      "start": 818.04,
      "end": 820.28,
      "text": "这种压力会从光模块"
    },
    {
      "start": 820.28,
      "end": 821.84,
      "text": "这一个细分领域"
    },
    {
      "start": 821.84,
      "end": 824.48,
      "text": "逐渐蔓延到所有依赖海外市场"
    },
    {
      "start": 824.48,
      "end": 827.0,
      "text": "尤其是依赖美国市场的整条"
    },
    {
      "start": 827.0,
      "end": 828.52,
      "text": "AI产业链上"
    },
    {
      "start": 828.52,
      "end": 830.96,
      "text": "如果新一轮的中美科技脱钩"
    },
    {
      "start": 830.96,
      "end": 833.84,
      "text": "继续朝着预演预列的方向发展"
    },
    {
      "start": 833.84,
      "end": 837.04,
      "text": "那么中国经济长期依赖的外需增长"
    },
    {
      "start": 837.04,
      "end": 839.68,
      "text": "很可能会受到实质性的阻碍"
    },
    {
      "start": 839.68,
      "end": 841.4,
      "text": "毕竟今年上半年"
    },
    {
      "start": 841.4,
      "end": 843.92,
      "text": "中国经济最大的亮点之一"
    },
    {
      "start": 843.92,
      "end": 846.32,
      "text": "恰恰就是出口表现强劲"
    },
    {
      "start": 846.32,
      "end": 848.44,
      "text": "一旦这个亮点受到冲击"
    },
    {
      "start": 848.44,
      "end": 849.84,
      "text": "内需的重要性"
    },
    {
      "start": 849.84,
      "end": 852.24,
      "text": "就必须进一步被抬高"
    },
    {
      "start": 852.24,
      "end": 855.6,
      "text": "消费端的份量也必须进一步被提升"
    },
    {
      "start": 855.6,
      "end": 856.64,
      "text": "否则的话"
    },
    {
      "start": 856.64,
      "end": 859.96,
      "text": "大家现在这种集体性偏冷的经济体感"
    },
    {
      "start": 859.96,
      "end": 862.36,
      "text": "恐怕还要持续很长一段时间"
    }
  ],
  "language": "zh"
}