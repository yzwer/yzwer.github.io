      "start": 448.12,
      "end": 450.52000000000004,
      "text": "重帮银行在官网也同步发布了"
    },
    {
      "start": 450.52000000000004,
      "end": 453.72,
      "text": "存款和同业复债保障安排的公告"
    },
    {
      "start": 453.72,
      "end": 455.20000000000005,
      "text": "个人存款方面"
    },
    {
      "start": 455.20000000000005,
      "end": 456.68,
      "text": "本席全额保障"
    },
    {
      "start": 456.68,
      "end": 458.40000000000003,
      "text": "各项业务照常办理"
    },
    {
      "start": 458.40000000000003,
      "end": 460.12,
      "text": "完全不受影响"
    },
    {
      "start": 460.12,
      "end": 463.0,
      "text": "对公存款和同业复债方面"
    },
    {
      "start": 463.0,
      "end": 465.32,
      "text": "接管钱本席5000万元"
    },
    {
      "start": 465.32,
      "end": 467.44,
      "text": "含5000万元以下的部分"
    },
    {
      "start": 467.44,
      "end": 469.32,
      "text": "本席全额保障"
    },
    {
      "start": 469.32,
      "end": 471.44,
      "text": "超过5000万元的部分"
    },
    {
      "start": 471.44,
      "end": 473.68,
      "text": "需要主币办理登记手续"
    },
    {
      "start": 473.68,
      "end": 476.52,
      "text": "5000万元以内的部分全额保障"
    },
    {
      "start": 476.52,
      "end": 477.56,
      "text": "超出的部分"
    },
    {
      "start": 477.56,
      "end": 479.68,
      "text": "则按照保障方案来处理"
    },
    {
      "start": 479.68,
      "end": 481.0,
      "text": "未备保障的债权"
    },
    {
      "start": 481.0,
      "end": 482.96,
      "text": "依法参与后续受伤"
    },
    {
      "start": 482.96,
      "end": 483.96,
      "text": "同一个债权人"
    },
    {
      "start": 483.96,
      "end": 487.12,
      "text": "在重帮银行的债权要合并计算"
    },
    {
      "start": 487.12,
      "end": 487.88,
      "text": "另外"
    },
    {
      "start": 487.88,
      "end": 490.96,
      "text": "接管之后新增加的存款和同业复债"
    },
    {
      "start": 490.96,
      "end": 492.92,
      "text": "本席也是全额保障"
    },
    {
      "start": 492.92,
      "end": 494.48,
      "text": "不受任何影响"
    },
    {
      "start": 494.48,
      "end": 496.28,
      "text": "有很多人拿重帮银行"
    },
    {
      "start": 496.28,
      "end": 497.96,
      "text": "跟包商银行作对比"
    },
    {
      "start": 497.96,
      "end": 500.64,
      "text": "认为两者的处理方式高度相似"
    },
    {
      "start": 500.64,
      "end": 503.04,
      "text": "但其中有几个不一样的地方在于"
    },
    {
      "start": 503.04,
      "end": 506.0,
      "text": "跟当年包商银行的接管方式相比"
    },
    {
      "start": 506.0,
      "end": 508.84,
      "text": "这次的接管组构成是不一样的"
    },
    {
      "start": 508.84,
      "end": 510.8,
      "text": "包商银行当年的处置"
    },
    {
      "start": 510.8,
      "end": 513.28,
      "text": "是金管总局主导的更多"
    },
    {
      "start": 513.28,
      "end": 515.04,
      "text": "而重帮银行这次"
    },
    {
      "start": 515.04,
      "end": 517.68,
      "text": "是湖北地方金融监管局"
    },
    {
      "start": 517.6800000000001,
      "end": 520.6800000000001,
      "text": "加武汉市人民政府签投作主角"
    },
    {
      "start": 520.6800000000001,
      "end": 522.1600000000001,
      "text": "金管总局湖北局"
    },
    {
      "start": 522.1600000000001,
      "end": 523.72,
      "text": "人行湖北分行"
    },
    {
      "start": 523.72,
      "end": 526.5200000000001,
      "text": "从款保险基金反而是参与单位"
    },
    {
      "start": 526.5200000000001,
      "end": 528.44,
      "text": "这其实体现了地方政府"
    },
    {
      "start": 528.44,
      "end": 530.0000000000001,
      "text": "在化解金融风险中"
    },
    {
      "start": 530.0000000000001,
      "end": 532.0000000000001,
      "text": "承担主体责任的思路"
    },
    {
      "start": 532.0000000000001,
      "end": 534.84,
      "text": "最新的金融法草案里也有明确规定"
    },
    {
      "start": 534.84,
      "end": 536.48,
      "text": "地方中小金融机构"
    },
    {
      "start": 536.48,
      "end": 538.2800000000001,
      "text": "地方金融控股公司"
    },
    {
      "start": 538.2800000000001,
      "end": 540.5600000000001,
      "text": "地方金融组织的风险处置"
    },
    {
      "start": 540.5600000000001,
      "end": 544.2800000000001,
      "text": "由注册地所在省级地方签投组织实施"
    },
    {
      "start": 544.2800000000001,
      "end": 545.6800000000001,
      "text": "国务院金融管理部门"
    },
    {
      "start": 545.6800000000001,
      "end": 548.5600000000001,
      "text": "主要是负责指导和跨去协调"
    },
    {
      "start": 548.5600000000001,
      "end": 551.44,
      "text": "而且重帮银行本身规模并不大"
    },
    {
      "start": 551.44,
      "end": 555.96,
      "text": "总体资产复债规模在2024年底是1200多亿"
    },
    {
      "start": 555.96,
      "end": 558.9200000000001,
      "text": "到了2026年应该还有收缩"
    },
    {
      "start": 558.9200000000001,
      "end": 561.1600000000001,
      "text": "它的同业存单规模也很小"
    },
    {
      "start": 561.1600000000001,
      "end": 563.4000000000001,
      "text": "单比大概就是一个议左右"
    },
    {
      "start": 563.4000000000001,
      "end": 569.36,
      "text": "比如最新一期265汉重帮银行CD002是2026年1月发行的"
    },
    {
      "start": 569.36,
      "end": 571.8800000000001,
      "text": "总级5000万的同业存单规模"
    },
    {
      "start": 571.8800000000001,
      "end": 575.6400000000001,
      "text": "265汉重帮银行CD003总级发行规模是"
    },
    {
      "start": 575.64,
      "end": 580.6,
      "text": "一个议它全部的同业存单加起来也就21亿元左右"
    },
    {
      "start": 580.6,
      "end": 583.4,
      "text": "也没有永续债或者二级资本债"
    },
    {
      "start": 583.4,
      "end": 588.28,
      "text": "有分析认为很少有机构的风险暴露会超过5000万"
    },
    {
      "start": 588.28,
      "end": 592.08,
      "text": "但一旦超过超出部分大概率会打折扣"
    },
    {
      "start": 592.08,
      "end": 594.56,
      "text": "最终还是要看处置结果"
    },
    {
      "start": 594.56,
      "end": 595.52,
      "text": "作为参照"
    },
    {
      "start": 595.52,
      "end": 598.0,
      "text": "包商银行当年的接管70"
    },
    {
      "start": 598.0,
      "end": 602.3199999999999,
      "text": "2019年5月24日到2020年5月23日"
    },
    {
      "start": 602.36,
      "end": 606.8000000000001,
      "text": "后续在2020年11月23日进入了破产程序"
    },
    {
      "start": 606.8000000000001,
      "end": 608.6,
      "text": "另外从评级角度看"
    },
    {
      "start": 608.6,
      "end": 613.4000000000001,
      "text": "此前主流评级机构给重帮银行的评级都是2a级"
    },
    {
      "start": 613.4000000000001,
      "end": 617.24,
      "text": "但有民间评级机构给出的评分只有7分"
    },
    {
      "start": 617.24,
      "end": 620.4000000000001,
      "text": "对照来看五分是投资级的零借点"
    },
    {
      "start": 620.4000000000001,
      "end": 625.6,
      "text": "7分则类比目的评级体系里的B3属于很低的水平"
    },
    {
      "start": 625.6,
      "end": 626.6800000000001,
      "text": "课级点说"
    },
    {
      "start": 626.6800000000001,
      "end": 629.8800000000001,
      "text": "国内传统评级机构在这类风险世界上"
    },
    {
      "start": 629.8800000000001,
      "end": 632.1600000000001,
      "text": "还存在明显的智后性"
    },
    {
      "start": 632.16,
      "end": 633.4399999999999,
      "text": "要是不客气的说"
    },
    {
      "start": 633.4399999999999,
      "end": 636.1999999999999,
      "text": "那这些评级根本就不能看"
    },
    {
      "start": 636.1999999999999,
      "end": 637.52,
      "text": "再把视角扩大"
    },
    {
      "start": 637.52,
      "end": 639.8,
      "text": "重帮银行被接管这件事"
    },
    {
      "start": 639.8,
      "end": 644.7199999999999,
      "text": "折射出的是整个民营银行行业正在经历巨烈的分化"
    },
    {
      "start": 644.7199999999999,
      "end": 646.7199999999999,
      "text": "截至2025年末"
    },
    {
      "start": 646.7199999999999,
      "end": 649.9599999999999,
      "text": "除重帮银行之外的18家民营银行"
    },
    {
      "start": 649.9599999999999,
      "end": 653.16,
      "text": "总资产规模已经突破2.21万亿元"
    },
    {
      "start": 653.16,
      "end": 656.76,
      "text": "合计实现经历轮約186亿元"
    },
    {
      "start": 656.76,
      "end": 659.52,
      "text": "但28效应表现得非常突出"
    },
    {
      "start": 659.52,
      "end": 663.48,
      "text": "尽微众银行和网商银行这两家头部机构"
    },
    {
      "start": 663.48,
      "end": 666.4,
      "text": "就占据了行业总资产的进利用场"
    },
    {
      "start": 666.4,
      "end": 668.6,
      "text": "经历轮超过7成"
    },
    {
      "start": 668.6,
      "end": 673.0799999999999,
      "text": "微众银行2025年经历轮达到110.12亿元"
    },
    {
      "start": 673.0799999999999,
      "end": 676.52,
      "text": "网商银行经历轮32.93亿元"
    },
    {
      "start": 676.52,
      "end": 677.56,
      "text": "与此同时"
    },
    {
      "start": 677.56,
      "end": 680.8,
      "text": "伟部的民营银行进行压力越来越明显"
    },
    {
      "start": 680.8,
      "end": 682.24,
      "text": "2024年以来"
    },
    {
      "start": 682.24,
      "end": 683.24,
      "text": "欲民银行"
    },
    {
      "start": 683.24,
      "end": 687.0799999999999,
      "text": "新银行已经先后引入国资成为低大股东"
    },
    {
      "start": 687.08,
      "end": 688.96,
      "text": "华通银行一连银行等"
    },
    {
      "start": 688.96,
      "end": 691.36,
      "text": "也出现了利润的大幅下滑"
    },
    {
      "start": 691.36,
      "end": 693.84,
      "text": "从行业整体的风险突进来看"
    },
    {
      "start": 693.84,
      "end": 696.24,
      "text": "这次的事情也不是孤立的"
    },
    {
      "start": 696.24,
      "end": 700.72,
      "text": "据央行2025年上半年对3,529家银行"
    },
    {
      "start": 700.72,
      "end": 702.08,
      "text": "做的评级"
    },
    {
      "start": 702.08,
      "end": 703.1600000000001,
      "text": "处于红区"
    },
    {
      "start": 703.1600000000001,
      "end": 706.08,
      "text": "也就是8到地级高风险区间的"
    },
    {
      "start": 706.08,
      "end": 708.1600000000001,
      "text": "一共有312家"
    },
    {
      "start": 708.1600000000001,
      "end": 710.0,
      "text": "占比2.1%"
    },
    {
      "start": 710.0,
      "end": 712.36,
      "text": "这个比例其实并不低"
    },
    {
      "start": 712.36,
      "end": 714.72,
      "text": "其中成商行有14家"
    },
    {
      "start": 714.72,
      "end": 717.48,
      "text": "農村金融机构有191家"
    },
    {
      "start": 717.48,
      "end": 719.9200000000001,
      "text": "村镇银行有132家"
    },
    {
      "start": 719.9200000000001,
      "end": 722.44,
      "text": "要说哪些省市相对最安全"
    },
    {
      "start": 722.44,
      "end": 724.5600000000001,
      "text": "红区清零的地区有北京"
    },
    {
      "start": 724.5600000000001,
      "end": 727.72,
      "text": "天津 上海 重庆 浙江"
    },
    {
      "start": 727.72,
      "end": 731.88,
      "text": "江苏 江西 福建 西藏这九个省市"
    },
    {
      "start": 731.88,
      "end": 735.48,
      "text": "而在各类银行内部分化也非常严重"
    },
    {
      "start": 735.48,
      "end": 737.12,
      "text": "就拿成商行来说"
    },
    {
      "start": 737.12,
      "end": 741.1600000000001,
      "text": "2025年末整体不良率是1.82%"
    },
    {
      "start": 741.16,
      "end": 743.0799999999999,
      "text": "到2026年一级度"
    },
    {
      "start": 743.0799999999999,
      "end": 745.68,
      "text": "威生到1.85%"
    },
    {
      "start": 745.68,
      "end": 748.92,
      "text": "从区域上看 江这一代整体比较稳"
    },
    {
      "start": 748.92,
      "end": 750.36,
      "text": "全部是绿区"
    },
    {
      "start": 750.36,
      "end": 753.1999999999999,
      "text": "而东北 中西部有39家银行"
    },
    {
      "start": 753.1999999999999,
      "end": 755.3199999999999,
      "text": "处于红区或者红区"
    },
    {
      "start": 755.3199999999999,
      "end": 758.64,
      "text": "另一个令人担忧的是进息差的问题"
    },
    {
      "start": 758.64,
      "end": 762.0799999999999,
      "text": "根据国家金融监督管理总局数据显示"
    },
    {
      "start": 762.0799999999999,
      "end": 764.56,
      "text": "商业银行进息差在2025年"
    },
    {
      "start": 764.56,
      "end": 767.8,
      "text": "连续3个级度持平于1.42%"
    },
    {
      "start": 767.8000000000001,
      "end": 771.96,
      "text": "一级度进一步下探质1.40%的历史心低"
    },
    {
      "start": 771.96,
      "end": 774.9200000000001,
      "text": "其中 六大国有银行进息差"
    },
    {
      "start": 774.9200000000001,
      "end": 776.6800000000001,
      "text": "从高到第一次为"
    },
    {
      "start": 776.6800000000001,
      "end": 778.8800000000001,
      "text": "由处银行1.65%"
    },
    {
      "start": 778.8800000000001,
      "end": 780.9200000000001,
      "text": "建设银行1.36%"
    },
    {
      "start": 780.9200000000001,
      "end": 783.0000000000001,
      "text": "工商银行1.29%"
    },
    {
      "start": 783.0000000000001,
      "end": 785.1600000000001,
      "text": "农业银行1.26%"
    },
    {
      "start": 785.1600000000001,
      "end": 787.4000000000001,
      "text": "中国银行1.26%"
    },
    {
      "start": 787.4000000000001,
      "end": 789.72,
      "text": "交通银行1.23%"
    },
    {
      "start": 789.72,
      "end": 793.0400000000001,
      "text": "全部大幅低于1.8%的警戒线"
    },
    {
      "start": 793.0400000000001,
      "end": 794.84,
      "text": "国有大银行都如此"
    },
    {
      "start": 794.84,
      "end": 797.2400000000001,
      "text": "其他中小银行就更别说了"
    },
    {
      "start": 797.28,
      "end": 799.2,
      "text": "进息差低迫警戒线"
    },
    {
      "start": 799.2,
      "end": 800.5600000000001,
      "text": "之所以令人担忧"
    },
    {
      "start": 800.5600000000001,
      "end": 802.96,
      "text": "当然不是因为银行少赚了多少钱"
    },
    {
      "start": 802.96,
      "end": 806.5600000000001,
      "text": "而是他们的风险抵御能力被敲燃轻始"
    },
    {
      "start": 806.5600000000001,
      "end": 808.12,
      "text": "银行处置不良债权"
    },
    {
      "start": 808.12,
      "end": 810.32,
      "text": "需要寄替剥备和消坏账"
    },
    {
      "start": 810.32,
      "end": 813.08,
      "text": "这些都需要充足的利润来支撑"
    },
    {
      "start": 813.08,
      "end": 814.92,
      "text": "当进息差持续下滑"
    },
    {
      "start": 814.92,
      "end": 817.24,
      "text": "利润空间被不断压缩使"
    },
    {
      "start": 817.24,
      "end": 819.72,
      "text": "银行可用于消化风险的资金"
    },
    {
      "start": 819.72,
      "end": 820.96,
      "text": "就会越来越少"
    },
    {
      "start": 820.96,
      "end": 822.5600000000001,
      "text": "金融体系的稳定性"
    },
    {
      "start": 822.5600000000001,
      "end": 824.96,
      "text": "就会面临根本性挑战"
    },
    {
      "start": 825.0,
      "end": 827.0,
      "text": "这是目前央行持持不愿"
    },
    {
      "start": 827.0,
      "end": 828.9200000000001,
      "text": "降息的重要原因之一"
    },
    {
      "start": 828.9200000000001,
      "end": 831.08,
      "text": "中帮银行出事之前"
    },
    {
      "start": 831.08,
      "end": 832.84,
      "text": "其实已经有过语言"
    },
    {
      "start": 832.84,
      "end": 835.1600000000001,
      "text": "之前有包商银行的线力"
    },
    {
      "start": 835.1600000000001,
      "end": 837.8000000000001,
      "text": "也有中原村镇银行的线力"
    },
    {
      "start": 837.8000000000001,
      "end": 840.2,
      "text": "当年中原村镇银行出事"
    },
    {
      "start": 840.2,
      "end": 842.72,
      "text": "还闹出过给储户富宏马"
    },
    {
      "start": 842.72,
      "end": 845.12,
      "text": "以阻止来访的恶劣事件"
    },
    {
      "start": 845.12,
      "end": 846.24,
      "text": "如今看来"
    },
    {
      "start": 846.24,
      "end": 849.4000000000001,
      "text": "类似的教训并没有真正被吸取"
    },
    {
      "start": 849.4000000000001,
      "end": 851.64,
      "text": "不少人提到一个判断标准"
    },
    {
      "start": 851.64,
      "end": 853.08,
      "text": "在金融这件事上"
    },
    {
      "start": 853.08,
      "end": 855.84,
      "text": "确认资产价值的真实增减变化"
    },
    {
      "start": 855.84,
      "end": 859.12,
      "text": "最好以国际货币而不是人民币来定价"
    },
    {
      "start": 859.12,
      "end": 860.84,
      "text": "对于个人资金安全"
    },
    {
      "start": 860.84,
      "end": 862.24,
      "text": "如果图个安稳"
    },
    {
      "start": 862.24,
      "end": 864.64,
      "text": "尤其是超过50万元的存款"
    },
    {
      "start": 864.64,
      "end": 866.64,
      "text": "尽量往大银行走"
    },
    {
      "start": 866.64,
      "end": 868.2,
      "text": "这倒不是说地方小航"
    },
    {
      "start": 868.2,
      "end": 869.4000000000001,
      "text": "经营能力不行"
    },
    {
      "start": 869.4000000000001,
      "end": 871.6800000000001,
      "text": "而是因为受到大航的挤压"
    },
    {
      "start": 871.6800000000001,
      "end": 873.88,
      "text": "地方小航能争取到的客户"
    },
    {
      "start": 873.88,
      "end": 875.72,
      "text": "信用质量相对较弱"
    },
    {
      "start": 875.72,
      "end": 878.0400000000001,
      "text": "或许资金的成本有比较高"
    },
    {
      "start": 878.0400000000001,
      "end": 880.24,
      "text": "这是他们天然的历史"
    },
    {
      "start": 880.24,
      "end": 881.6400000000001,
      "text": "在铭银银行里"
    },
    {
      "start": 881.64,
      "end": 884.48,
      "text": "众邦本身素质已经算是不错的了"
    },
    {
      "start": 884.48,
      "end": 887.68,
      "text": "可惜欲上了古东层面的系统性风险"
    },
    {
      "start": 887.68,
      "end": 889.88,
      "text": "人力终究难以盛天"
    },
    {
      "start": 889.88,
      "end": 893.68,
      "text": "就连之前一些表现亮眼的长三角地方银行"
    },
    {
      "start": 893.68,
      "end": 896.04,
      "text": "银利能力现在也在下滑"
    },
    {
      "start": 896.04,
      "end": 898.64,
      "text": "这条消息就跟大家聊到这儿"
    },
    {
      "start": 898.64,
      "end": 901.4399999999999,
      "text": "众邦银行事件是全国民营银行"
    },
    {
      "start": 901.4399999999999,
      "end": 902.96,
      "text": "这个序列里的手力"
    },
    {
      "start": 902.96,
      "end": 905.52,
      "text": "作为湖北首家民营银行"
    },
    {
      "start": 905.52,
      "end": 906.8,
      "text": "开业时风光"
    },
    {
      "start": 906.8,
      "end": 910.12,
      "text": "后来在监管区言经济下行中挣扎"
    },
    {
      "start": 910.12,
      "end": 911.36,
      "text": "最终被结管"
    },
    {
      "start": 911.36,
      "end": 914.8000000000001,
      "text": "有人细称银行是湖北民营资本的试验厂"
    },
    {
      "start": 914.8000000000001,
      "end": 917.4,
      "text": "最后确成了风险集中营"
    },
    {
      "start": 917.4,
      "end": 919.52,
      "text": "这件事背后签出来的"
    },
    {
      "start": 919.52,
      "end": 920.8000000000001,
      "text": "是古东风险"
    },
    {
      "start": 920.8000000000001,
      "end": 921.84,
      "text": "资产质量"
    },
    {
      "start": 921.84,
      "end": 924.64,
      "text": "公司治理多重问题叠加的结果"
    },
    {
      "start": 924.64,
      "end": 928.52,
      "text": "同时也是给国内整个金融系统的右翼机景中"
    }
  ]
}