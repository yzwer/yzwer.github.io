    {
      "start": 509.64,
      "end": 511.92,
      "text": "女性恐惧生育的核心原因"
    },
    {
      "start": 511.92,
      "end": 513.92,
      "text": "在于随之而来的职业断荡"
    },
    {
      "start": 513.92,
      "end": 516.24,
      "text": "以及独自承担预而重认"
