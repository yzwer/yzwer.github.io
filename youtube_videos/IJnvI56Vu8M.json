    {
      "start": 437.76,
      "end": 439.88,
      "text": "在生育初期的经济较率"
    },
    {
      "start": 439.88,
      "end": 440.76,
      "text": "与此同时"
    },
    {
      "start": 440.76,
      "end": 443.24,
      "text": "我们必须提到一个前置背景"
    },
    {
      "start": 443.24,
      "end": 445.56,
      "text": "韩国人前些年的年军劳动时间"
    },
    {
      "start": 445.56,
      "end": 448.0,
      "text": "高达1874小时"
    },
    {
      "start": 448.0,
      "end": 449.92,
      "text": "超出金和组织平均水平"
    },
    {
      "start": 449.92,
      "end": 451.72,
      "text": "整整157个小时"
    },
    {
      "start": 451.72,
      "end": 454.04,
      "text": "平均一周高达36小时"
    },
    {
      "start": 454.04,
      "end": 456.04,
      "text": "如果一个劳动者的所有时间"
    },
    {
      "start": 456.04,
      "end": 457.76,
      "text": "都被工业化体系炸干"
    },
    {
      "start": 457.76,
      "end": 460.24,
      "text": "他连基本的消费欲望都会伪缩"
    },
    {
      "start": 460.24,
      "end": 462.08,
      "text": "更讨论投入巨大的经历"
