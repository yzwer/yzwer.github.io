    {
      "start": 462.08,
      "end": 464.2,
      "text": "去组建家庭和反演后代"
    },
    {
      "start": 464.2,
      "end": 465.6,
      "text": "为了解决这个问题"
    },
    {
      "start": 465.6,
      "end": 467.32,
      "text": "政策开始在龙头企业"
    },
    {
      "start": 467.32,
      "end": 469.48,
      "text": "推行上次修三的工作制"
    },
    {
      "start": 469.48,
      "end": 472.64,
      "text": "并启动了每周4.5天工作制的试点"
    },
    {
      "start": 472.64,
      "end": 473.64,
      "text": "硬性前提示"
    },
    {
      "start": 473.64,
      "end": 475.8,
      "text": "员工工资一分不讲"
    },
    {
      "start": 475.8,
      "end": 477.16,
      "text": "更具颠覆性的是"
    },
    {
      "start": 477.16,
      "end": 479.36,
      "text": "立法确立了下班断联权"
    },
    {
      "start": 479.36,
      "end": 481.04,
      "text": "这意味着在下班时间"
    },
    {
      "start": 481.04,
      "end": 482.72,
      "text": "周末和法定结架日"
    },
    {
      "start": 482.72,
      "end": 484.72,
      "text": "员工拥有绝对合法的权力"
    },
    {
      "start": 484.72,
      "end": 486.6,
      "text": "去无视工作指令"
    },
    {
      "start": 486.6,
      "end": 488.84,
      "text": "如果有企业试图通过调稿"
    },
    {
      "start": 488.84,
      "end": 490.64,
      "text": "扣发奖奸来进行惩罚"
    },
    {
      "start": 490.64,
      "end": 492.24,
      "text": "将面临高额重罚"
    },
    {
      "start": 492.24,
      "end": 493.48,
      "text": "且相关劳动纠纷"
    },
    {
      "start": 493.48,
      "end": 495.2,
      "text": "走优先处理同道"
    },
    {
      "start": 495.2,
      "end": 498.84,
      "text": "这其实就是在职场引入了强制融断机制"
