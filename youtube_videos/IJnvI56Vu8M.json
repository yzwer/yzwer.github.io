    {
      "start": 744.88,
      "end": 746.12,
      "text": "当年亲人觉得明天"
    },
    {
      "start": 746.12,
      "end": 748.24,
      "text": "只会更卷更累更窮"
    },
    {
      "start": 748.24,
      "end": 749.56,
      "text": "他们连婚都懒得结"
    },
    {
      "start": 749.56,
      "end": 751.0,
      "text": "更别说生娃了"
    },
    {
      "start": 751.0,
      "end": 752.88,
      "text": "看看销量暴增的承认玩具"
    },
    {
      "start": 752.88,
      "end": 754.44,
      "text": "说明大家的欲望都还在"
    },
    {
      "start": 754.44,
      "end": 756.4,
      "text": "只不过是条件不允许"
    },
    {
      "start": 756.4,
      "end": 758.44,
      "text": "所以别再说什么年轻人不愿意了"
    },
    {
      "start": 758.44,
      "end": 759.48,
      "text": "不是不愿意"
    },
    {
      "start": 759.48,
      "end": 760.84,
      "text": "是成本太高"
    },
    {
      "start": 760.84,
      "end": 761.6,
      "text": "时间太少"
    },
    {
      "start": 761.6,
      "end": 762.68,
      "text": "压力太大"
    },
    {
      "start": 762.68,
      "end": 763.92,
      "text": "韩国那套做法"
    },
    {
      "start": 763.92,
      "end": 765.44,
      "text": "未必能完全召唤"
    },
    {
      "start": 765.44,
      "end": 767.4,
      "text": "但核心逻辑非常清晰"
    },
    {
      "start": 767.4,
      "end": 769.16,
      "text": "财政直接对准名声"
    },
    {
      "start": 769.16,
      "end": 770.36,
      "text": "大力出奇迹"
    },
    {
      "start": 770.36,
      "end": 773.04,
      "text": "把结婚成本和工作时场往下压抑"
    },
    {
      "start": 773.04,
      "end": 774.52,
      "text": "效果肯定会有"
    },
    {
      "start": 774.52,
      "end": 775.6,
      "text": "生娃给钱"
    },
    {
      "start": 775.6,
      "end": 776.84,
      "text": "买房补贴"
    },
    {
      "start": 776.84,
      "end": 777.88,
      "text": "免费脱育"
    },
    {
      "start": 777.88,
      "end": 778.96,
      "text": "锁短工时"
    },
    {
      "start": 778.96,
      "end": 781.4,
      "text": "保障休息权等等都是可行的"
    },
    {
      "start": 781.4,
      "end": 783.44,
      "text": "总之能帮上忙的政策"
    },
    {
      "start": 783.44,
      "end": 784.8,
      "text": "应该密集出了"
    },
    {
      "start": 784.8,
      "end": 787.4,
      "text": "不然真到了连年轻人都没几个的时候"
    },
    {
      "start": 787.4,
      "end": 788.24,
      "text": "再想往回拉"
    },
    {
      "start": 788.24,
      "end": 789.24,
      "text": "就真的晚了"
    }
  ],
  "language": "zh"
}