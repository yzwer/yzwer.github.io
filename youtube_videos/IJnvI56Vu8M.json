    {
      "start": 529.84,
      "end": 531.8,
      "text": "完全并气了道德说脚"
    },
    {
      "start": 531.8,
      "end": 535.2,
      "text": "纯粹用利益最大化来倒逼行为改变"
    },
    {
      "start": 535.2,
      "end": 537.0,
      "text": "在孩子出生18个月内"
