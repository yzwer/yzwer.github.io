    {
      "start": 136.16,
      "end": 138.0,
      "text": "这就是散户的宿命"
    },
    {
      "start": 138.0,
      "end": 139.24,
      "text": "高尾接盘"
    },
    {
      "start": 139.24,
      "end": 140.56,
      "text": "低尾割肉"
    },
    {
      "start": 140.6,
      "end": 142.52,
      "text": "另一位金融圈从业者说"
    },
    {
      "start": 142.52,
      "end": 144.76,
      "text": "骨灾过后地铁里静悄悄的"
    },
    {
      "start": 144.76,
      "end": 146.32,
      "text": "餐厅咖啡管理"
    },
    {
      "start": 146.32,
      "end": 148.52,
      "text": "谈股票的声音明显减少"
