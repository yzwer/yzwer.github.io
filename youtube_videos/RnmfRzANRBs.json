      "start": 673.76,
      "end": 676.3199999999999,
      "text": "有網友在微博上出了到思考題"
    },
    {
      "start": 676.3199999999999,
      "end": 678.36,
      "text": "假設一家民營上市公司"
    },
    {
      "start": 678.36,
      "end": 680.72,
      "text": "組織幾百名員工虛假出資"
    },
    {
      "start": 680.72,
      "end": 682.0,
      "text": "批量開力賬戶"
    },
    {
      "start": 682.0,
      "end": 682.96,
      "text": "偽造資料"
    },
    {
      "start": 682.96,
      "end": 684.04,
      "text": "防害監管"
    },
    {
      "start": 684.04,
      "end": 685.24,
      "text": "巨額逃稅"
    },
    {
      "start": 685.24,
      "end": 685.96,
      "text": "董事長"
    },
    {
      "start": 685.96,
      "end": 686.68,
      "text": "總經理"
    },
    {
      "start": 686.68,
      "end": 687.6,
