      "start": 626.5600000000001,
      "end": 628.2,
      "text": "就算將來被查出來"
    },
    {
      "start": 628.2,
      "end": 629.6800000000001,
      "text": "大概率是不腳稅款"
    },
    {
      "start": 629.6800000000001,
      "end": 630.8000000000001,
      "text": "焦點發款"
    },
    {
      "start": 630.8000000000001,
      "end": 632.6400000000001,
      "text": "責任由單位承擔"
    },
    {
      "start": 632.6400000000001,
      "end": 634.6,
      "text": "個人頂多是一個紀律處分"
