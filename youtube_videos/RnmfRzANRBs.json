    },
    {
      "start": 121.96000000000001,
      "end": 125.16000000000001,
      "text": "他們把國家專門剝給農田的錢"
    },
    {
      "start": 125.16000000000001,
      "end": 127.88000000000001,
      "text": "拿去朝理財 還欠款了"
    },
    {
      "start": 127.88000000000001,
      "end": 131.60000000000002,
      "text": "而且類似的問題也不是第一次出現了"
    },
    {
      "start": 131.60000000000002,
      "end": 134.44,
      "text": "審計數早在2016年就曾通報"
    },
    {
      "start": 134.44,
      "end": 137.76000000000002,
      "text": "農行把367億元非社農貸款"
    },
    {
      "start": 137.76000000000002,
      "end": 141.0,
      "text": "按社農貸款統計 數字做了手腳"
    },
    {
      "start": 141.0,
      "end": 143.0,
      "text": "2018年再次發現"
    },
    {
      "start": 143.04,
      "end": 147.4,
      "text": "有227億元非社農貸款被記入社農統計"
    },
    {
      "start": 147.4,
      "end": 152.68,
      "text": "367億 227億到現在的110億為歸放貸"
    },
    {
      "start": 152.68,
      "end": 157.2,
      "text": "同一個病造 不同年份 不同形式 反覆發作"
    },
    {
      "start": 157.2,
      "end": 160.08,
      "text": "這說明跟子上的問題依然沒變"
    },
    {
      "start": 160.08,
      "end": 163.76,
      "text": "基層分支機構有硬性的社農貸款投放指標"
    },
    {
      "start": 163.76,
      "end": 166.32,
      "text": "玩不成任務就考核不達標"
    },
    {
      "start": 166.32,
      "end": 169.36,
      "text": "所以部分往點刻意放寬審核門檻"
    },
    {
      "start": 169.36,
      "end": 171.20000000000002,
      "text": "前放出去了就算完"
    },
    {
      "start": 171.20000000000002,
      "end": 172.96,
      "text": "至於最終留到哪裡"
    },
    {
      "start": 172.96,
      "end": 174.8,
      "text": "他們根本不關心"
    },
    {
      "start": 174.8,
      "end": 177.32000000000002,
      "text": "接下來再說光大集團的事情"
    },
    {
      "start": 177.32000000000002,
      "end": 181.52,
      "text": "光大集團是國內最早一批持牌金融控股集團"
    },
    {
      "start": 181.52,
      "end": 184.4,
      "text": "手下有光大銀行 光大證券"
    },
    {
      "start": 184.4,
      "end": 189.12,
      "text": "光大信托 中青旅等數十家上市及持牌子公司"
    },
    {
      "start": 189.12,
      "end": 193.72000000000003,
      "text": "横跨銀行 證券 保險 資管 文律多個賽道"
    },
    {
      "start": 193.72000000000003,
      "end": 196.68,
      "text": "案例說集團總部應該牢牢掌握"
    },
    {
      "start": 196.68,
      "end": 201.24,
      "text": "旗下公司的重大決策權 人士權 品牌管控權"
    },
    {
      "start": 201.24,
      "end": 204.56,
      "text": "但審計數核查的結果是根本管不住"
    },
    {
      "start": 204.56,
      "end": 209.76000000000002,
      "text": "具體表現是對部分100%絕對控股的子公司"
    },
    {
      "start": 209.76000000000002,
      "end": 212.8,
      "text": "總部已經完全喪失了實際決策權"
    },
    {
      "start": 212.8,
      "end": 215.96,
      "text": "重大投資 人士任免 業務拓展"
    },
    {
      "start": 215.96,
      "end": 219.60000000000002,
      "text": "總部無法有效約束子公司的董事會"
    },
    {
      "start": 219.60000000000002,
      "end": 222.08,
      "text": "只管一級子公司的經營事項不上報"
    },
    {
      "start": 222.16000000000003,
      "end": 224.92000000000002,
      "text": "不僅是 總部既沒有事前審批"
    },
    {
      "start": 224.92000000000002,
      "end": 226.88000000000002,
      "text": "也沒有事後復盤"
    },
    {
      "start": 226.88000000000002,
      "end": 230.4,
      "text": "還有個別下屬機構直接打著光大的招牌"
    },
    {
      "start": 230.4,
      "end": 233.08,
      "text": "對外展業一旦出現對付風險"
    },
    {
      "start": 233.08,
      "end": 236.76000000000002,
      "text": "違約風險全部返向傳導到集團主體"
    },
    {
      "start": 236.76000000000002,
      "end": 239.16000000000003,
      "text": "審計數之所以點名光大"
    },
    {
      "start": 239.16000000000003,
      "end": 241.24,
      "text": "主要是光大集團近10年來"
    },
    {
      "start": 241.24,
      "end": 245.0,
      "text": "接連爆發多起高管和子公司風險事件"
    },
    {
      "start": 245.0,
      "end": 248.0,
      "text": "先是光大證券2013年烏龍紙事件"
    },
    {
      "start": 248.0,
      "end": 249.68,
      "text": "轟動資本市場"
    },
    {
      "start": 249.68,
      "end": 252.44,
      "text": "此後NPS跨境收購彩雷"
    },
    {
      "start": 252.44,
      "end": 254.84,
      "text": "2018年項目宣告破產"
    },
    {
      "start": 254.84,
      "end": 257.68,
      "text": "當年就記提了約15億的簡直"
    },
    {
      "start": 257.68,
      "end": 259.88,
      "text": "經歷論斷牙施下跌"
    },
    {
      "start": 259.88,
      "end": 262.92,
      "text": "還有光大信托批量地產項目爆雷"
    },
    {
      "start": 262.92,
      "end": 265.72,
      "text": "光大控股巨額虧損接連爆發"
    },
    {
      "start": 265.72,
      "end": 267.6,
      "text": "利潤多家子公司董事長"
    },
    {
      "start": 267.6,
      "end": 270.0,
      "text": "CEO被記委立案調查"
    },
    {
      "start": 270.0,
      "end": 272.32,
      "text": "歷年審計詢視也多次指出"
    },
    {
      "start": 272.32,
      "end": 275.36,
      "text": "光大多層級子公司的三重一大決策制度"
    },
    {
      "start": 275.36,
      "end": 276.52,
      "text": "形同虛設"
    },
    {
      "start": 276.52,
      "end": 279.0,
      "text": "大量重大資產構制和對外投資"
    },
    {
      "start": 279.0,
      "end": 281.12,
      "text": "繞過集團總部自行決策"
    },
    {
      "start": 281.12,
      "end": 283.68,
      "text": "問題年年整改年年復發"
    },
    {
      "start": 283.68,
      "end": 286.64,
      "text": "其實金融控股公司最核心的命脈"
    },
    {
      "start": 286.64,
      "end": 287.96,
      "text": "就是統一管控"
    },
    {
      "start": 287.96,
      "end": 291.24,
      "text": "連全資控股企業都無法掌控決策權"
    },
    {
      "start": 291.24,
      "end": 294.0,
      "text": "資金違規調波關聯利益輸送"
    },
    {
      "start": 294.0,
      "end": 296.84,
      "text": "品牌無需濫用的問題就會接連出現"
    },
    {
      "start": 296.84,
      "end": 299.12,
      "text": "一旦某家子公司爆雷"
    },
    {
      "start": 299.12,
      "end": 302.16,
      "text": "極容易引發全集團系統性風險"
    },
    {
      "start": 302.16,
      "end": 304.68,
      "text": "接下來是這次全網熱度最高"
    },
    {
      "start": 304.68,
      "end": 306.16,
      "text": "討論最多的案例"
    },
    {
      "start": 306.16,
      "end": 308.96000000000004,
      "text": "中國銀行逃稅二十三點六七億"
    },
    {
      "start": 308.96000000000004,
      "end": 311.6,
      "text": "中國銀行一九一二年正式成立"
    },
    {
      "start": 311.6,
      "end": 313.24,
      "text": "先後行使中央銀行"
    },
    {
      "start": 313.24,
      "end": 315.28000000000003,
      "text": "國際會對銀行只能"
    },
    {
      "start": 315.28000000000003,
      "end": 317.76000000000005,
      "text": "是六大國有行之一"
    },
    {
      "start": 317.76000000000005,
      "end": 320.04,
      "text": "2006年成為國內首家"
    },
    {
      "start": 320.04,
      "end": 322.28000000000003,
      "text": "A加H同步上市的銀行"
    },
    {
      "start": 322.28000000000003,
      "end": 325.6,
      "text": "二零二五年總資產突破三十八萬億"
    },
    {
      "start": 325.6,
      "end": 327.68,
      "text": "但就是這麼一家百年老店"
    },
    {
      "start": 327.68,
      "end": 329.12,
      "text": "萬一級國有大行"
    },
    {
      "start": 329.12,
      "end": 332.04,
      "text": "居然利用政策優惠逃避稅款"
    },
    {
      "start": 332.04,
      "end": 333.92,
      "text": "那是什麼政策優惠呢"
    },
    {
      "start": 333.92,
      "end": 334.76000000000005,
      "text": "要知道"
    },
    {
      "start": 334.76,
      "end": 337.0,
      "text": "中國現行稅法對公務基金"
    },
    {
      "start": 337.0,
      "end": 340.08,
      "text": "和私務基金是完全不同的待遇"
    },
    {
      "start": 340.08,
      "end": 341.24,
      "text": "公務基金"
    },
    {
      "start": 341.24,
      "end": 342.92,
      "text": "就是你在手機銀行"
    },
    {
      "start": 342.92,
      "end": 343.8,
      "text": "支付寶"
    },
    {
      "start": 343.8,
      "end": 346.2,
      "text": "各類理財平台能買到的基金"
    },
    {
      "start": 346.2,
      "end": 347.36,
      "text": "一塊錢起頭"
    },
    {
      "start": 347.36,
      "end": 349.76,
      "text": "面向所有普通投資者"
    },
    {
      "start": 349.76,
      "end": 351.8,
      "text": "根據財政部和事務總局"
    },
    {
      "start": 351.8,
      "end": 353.8,
      "text": "2004年發布的政策"
    },
    {
      "start": 353.8,
      "end": 356.96,
      "text": "公務基金買賣股票債券的差價收入"
    },
    {
      "start": 356.96,
      "end": 358.76,
      "text": "獲得的股息紅利"
    },
    {
      "start": 358.76,
      "end": 360.88,
      "text": "免徵企業所得稅"
    },
    {
      "start": 360.88,
      "end": 363.28,
      "text": "這個政策的出發點是普惠"
    },
    {
      "start": 363.28000000000003,
      "end": 365.84000000000003,
      "text": "是讓老百姓也能參與資本市場"
    },
    {
      "start": 365.84000000000003,
      "end": 367.84000000000003,
      "text": "享受這塊制度紅利"
    },
    {
      "start": 367.84000000000003,
      "end": 368.88000000000005,
      "text": "與之對應"
    },
    {
      "start": 368.88000000000005,
      "end": 371.64000000000004,
      "text": "私務基金則完全是另一套邏輯"
    },
    {
      "start": 371.64000000000004,
      "end": 374.36,
      "text": "他只面向高競職合格投資者"
    },
    {
      "start": 374.36,
      "end": 376.16,
      "text": "門檻100萬起步"
    },
    {
      "start": 376.16,
      "end": 377.96000000000004,
      "text": "不對普通公眾開放"
    },
    {
      "start": 377.96000000000004,
      "end": 380.44000000000005,
      "text": "屬於有錢人玩的遊戲"
    },
    {
      "start": 380.44000000000005,
      "end": 381.52000000000004,
      "text": "對應的"
    },
    {
      "start": 381.52000000000004,
      "end": 385.36,
      "text": "他的投資收益需要腳納25%的企業所得稅"
    },
    {
      "start": 385.36,
      "end": 387.08000000000004,
      "text": "沒有任何免稅待遇"
    },
    {
      "start": 387.08000000000004,
      "end": 388.76000000000005,
      "text": "而中航幹的這件事"
    },
    {
      "start": 388.76000000000005,
      "end": 390.8,
      "text": "本質上就是掛羊頭賣狗肉"
    },
    {
      "start": 390.8,
      "end": 393.0,
      "text": "把私務套上了公務的壳子"
    },
    {
      "start": 393.04,
      "end": 394.92,
      "text": "操作方式是這樣的"
    },
    {
      "start": 394.92,
      "end": 396.28,
      "text": "按照監管規定"
    },
    {
      "start": 396.28,
      "end": 398.28,
      "text": "公務基金在持有人人數上"
    },
    {
      "start": 398.28,
      "end": 399.84,
      "text": "有最低門檻要求"
    },
    {
      "start": 399.84,
      "end": 402.16,
      "text": "投資者數量得達到一定規模"
    },
    {
      "start": 402.16,
      "end": 404.52,
      "text": "才能被認定為公務產品"
    },
    {
      "start": 404.52,
      "end": 406.48,
      "text": "中航的突破口就在這兒"
    },
    {
      "start": 406.48,
      "end": 409.12,
      "text": "他們通過兩家下屬金融機構當通道"
    },
    {
      "start": 409.12,
      "end": 411.24,
      "text": "動員大量本航員工"
    },
    {
      "start": 411.24,
      "end": 413.44,
      "text": "每人出資議員到100元"
    },
    {
      "start": 413.44,
      "end": 415.44,
      "text": "掛名成為基金持有人"
    },
    {
      "start": 415.44,
      "end": 417.96,
      "text": "這些員工不參與任何投資決策"
    },
    {
      "start": 417.96,
      "end": 420.16,
      "text": "不承擔任何虧損風險"
    },
    {
      "start": 420.16,
      "end": 422.96,
      "text": "唯一的作用就是田中持有人名單"
    },
    {
      "start": 422.96000000000004,
      "end": 424.56000000000006,
      "text": "湊購公務基金備案"
    },
    {
      "start": 424.56000000000006,
      "end": 428.00000000000006,
      "text": "所要求的面向公眾目擊的人數應門檻"
    },
    {
      "start": 428.00000000000006,
      "end": 429.32000000000005,
      "text": "真實的資金來源"
    },
    {
      "start": 429.32000000000005,
      "end": 430.28000000000003,
      "text": "運作模式"
    },
    {
      "start": 430.28000000000003,
      "end": 432.84000000000003,
      "text": "投資對象還是私務那一套"
    },
    {
      "start": 432.84000000000003,
      "end": 434.40000000000003,
      "text": "但因為持有人數量"
    },
    {
      "start": 434.40000000000003,
      "end": 436.40000000000003,
      "text": "滿足了公務的形式要求"
    },
    {
      "start": 436.40000000000003,
      "end": 438.16,
      "text": "產品就以公務身份"
    },
    {
      "start": 438.16,
      "end": 441.44000000000005,
      "text": "去申報享受公務的免稅待遇"
    },
    {
      "start": 441.44000000000005,
      "end": 444.12000000000006,
      "text": "總共11支產品29個月"
    },
    {
      "start": 444.12000000000006,
      "end": 447.40000000000003,
      "text": "累計少角稅款23.67億元"
    },
    {
      "start": 447.40000000000003,
      "end": 449.88000000000005,
      "text": "但整件事讓人感到震驚的"
    },
    {
      "start": 449.88000000000005,
      "end": 451.16,
      "text": "不只是驚惡"
    },
    {
      "start": 451.16,
      "end": 452.56000000000006,
      "text": "還有他的系統性"
    },
    {
      "start": 452.56,
      "end": 454.16,
      "text": "各位可以想一想"
    },
    {
      "start": 454.16,
      "end": 455.72,
      "text": "要完成這套操作"
    },
    {
      "start": 455.72,
      "end": 458.16,
      "text": "需要動用多少層級的資源"
    },
    {
      "start": 458.16,
      "end": 461.44,
      "text": "首先要安排下屬金融機構配合"
    },
    {
      "start": 461.44,
      "end": 463.16,
      "text": "這可不是一家子公司"
    },
    {
      "start": 463.16,
      "end": 465.12,
      "text": "能自己拍板的事情"
    },
    {
      "start": 465.12,
      "end": 465.88,
      "text": "其次"
    },
    {
      "start": 465.88,
      "end": 468.8,
      "text": "要組織大量本行員工掛名入貨"
    },
    {
      "start": 468.8,
      "end": 472.12,
      "text": "涉及人士行政多條線的協調"
    },
    {
      "start": 472.12,
      "end": 473.04,
      "text": "再往下"
    },
    {
      "start": 473.04,
      "end": 475.6,
      "text": "產品立向要過內部審查"
    },
    {
      "start": 475.6,
      "end": 477.44,
      "text": "合規部門得放行"
    },
    {
      "start": 477.44,
      "end": 479.76,
      "text": "財務部門處理稅務申報時"
    },
    {
      "start": 479.76,
      "end": 481.4,
      "text": "得默認這套口徑"
    },
    {
      "start": 481.40000000000003,
      "end": 483.44000000000005,
      "text": "整個鏈條一路綠燈"
    },
    {
      "start": 483.44000000000005,
      "end": 484.92,
      "text": "再一家制度完善"
    },
    {
      "start": 484.92,
      "end": 487.36,
      "text": "內控體系健全的國有大行李"
    },
    {
      "start": 487.36,
      "end": 489.32000000000005,
      "text": "這種是能順利落敵"
    },
    {
      "start": 489.32000000000005,
      "end": 492.88000000000005,
      "text": "意味著它不可能是某個業務經理的私下決定"
    },
    {
      "start": 492.88000000000005,
      "end": 495.68000000000006,
      "text": "也不可能是某條線的暗箱操作"
    },
    {
      "start": 495.68000000000006,
      "end": 497.24,
      "text": "這是一場跨部門"
    },
    {
      "start": 497.24,
      "end": 500.56000000000006,
      "text": "跨子公司全鏈條協同的系統性行為"
    },
    {
      "start": 500.56000000000006,
      "end": 503.20000000000005,
      "text": "沒有足夠高層級的墨許或受益"
    },
    {
      "start": 503.20000000000005,
      "end": 505.8,
      "text": "這套流程可能一天都跑不起來"
    },
    {
      "start": 505.8,
      "end": 507.96000000000004,
      "text": "中國銀行作為一家副部級"
    },
    {
      "start": 507.96000000000004,
      "end": 510.64000000000004,
      "text": "跟證苗紅的國有大型商業銀行"
    },
    {
      "start": 510.68,
      "end": 513.3199999999999,
      "text": "居然為了區區23.67億元"
    },
    {
      "start": 513.3199999999999,
      "end": 515.28,
      "text": "而去觸碰法律紅線"
    },
    {
      "start": 515.28,
      "end": 516.6,
      "text": "他們為什麼要這麼幹"
    },
    {
      "start": 516.6,
      "end": 518.1999999999999,
      "text": "又為什麼敢這麼幹"
    },
    {
      "start": 518.1999999999999,
      "end": 520.88,
      "text": "這還得從銀行的業務壓力說起"
    },
    {
      "start": 520.88,
      "end": 522.72,
      "text": "中國銀行這幾年的日子"
    },
    {
      "start": 522.72,
      "end": 524.84,
      "text": "比表面上看起來難多了"
    },
    {
      "start": 524.84,
      "end": 529.1999999999999,
      "text": "2023年中行規模淨利潤2319億"
    },
    {
      "start": 529.1999999999999,
      "end": 531.6,
      "text": "同比增速2.38%"
    },
    {
      "start": 531.6,
      "end": 534.6,
      "text": "2024年2378億"
    },
    {
      "start": 534.6,
      "end": 536.4399999999999,
      "text": "增速2.56%"
    },
    {
      "start": 536.48,
      "end": 538.96,
      "text": "2025年2431%"
    },
    {
      "start": 538.96,
      "end": 541.12,
      "text": "增速2.18%"
    },
    {
      "start": 541.12,
      "end": 542.8000000000001,
      "text": "數字雖然都是正的"
    },
    {
      "start": 542.8000000000001,
      "end": 545.9200000000001,
      "text": "但這個增速在六大行里屬於調車尾"
    },
    {
      "start": 545.9200000000001,
      "end": 548.0400000000001,
      "text": "更要命的是營收端"
    },
    {
      "start": 548.0400000000001,
      "end": 552.2,
      "text": "2024年全年營收增速只有1.16%"
    },
    {
      "start": 552.2,
      "end": 553.8000000000001,
      "text": "幾乎原地踏步"
    },
    {
      "start": 553.8000000000001,
      "end": 554.96,
      "text": "原因很簡單"
    },
    {
      "start": 554.96,
      "end": 556.6400000000001,
      "text": "靜息差持續收斬"
    },
    {
      "start": 556.6400000000001,
      "end": 558.0400000000001,
      "text": "靠存貸款立差"
    },
    {
      "start": 558.0400000000001,
      "end": 560.6800000000001,
      "text": "吃飯的傳統模式越來越難走"
    },
    {
      "start": 560.6800000000001,
      "end": 564.36,
      "text": "整個銀行業都在向資管財富管理轉型"
    },
    {
      "start": 564.36,
      "end": 565.44,
      "text": "靠賣理財"
    },
    {
      "start": 565.48,
      "end": 567.1600000000001,
      "text": "管資產賺管理費"
    },
    {
      "start": 567.1600000000001,
      "end": 569.0,
      "text": "不放貸不單壞賬"
    },
    {
      "start": 569.0,
      "end": 570.36,
      "text": "穩定創收"
    },
    {
      "start": 570.36,
      "end": 572.6400000000001,
      "text": "但資管這碗飯也不好吃"
    },
    {
      "start": 572.6400000000001,
      "end": 575.0400000000001,
      "text": "全市場幾十萬億的理財規模"
    },
    {
      "start": 575.0400000000001,
      "end": 576.6400000000001,
      "text": "幾百家機構競爭"
    },
    {
      "start": 576.6400000000001,
      "end": 578.48,
      "text": "產品高度同之化"
    },
    {
      "start": 578.48,
      "end": 580.6,
      "text": "最終拼的就是收益率"
    },
    {
      "start": 580.6,
      "end": 582.4000000000001,
      "text": "同樣是穩健行產品"
    },
    {
      "start": 582.4000000000001,
      "end": 583.48,
      "text": "你給2%"
    },
    {
      "start": 583.48,
      "end": 585.2800000000001,
      "text": "我給2.1%"
    },
    {
      "start": 585.2800000000001,
      "end": 586.8800000000001,
      "text": "客戶用腳投票"
    },
    {
      "start": 586.8800000000001,
      "end": 588.32,
      "text": "資金立刻就走"
    },
    {
      "start": 588.32,
      "end": 589.48,
      "text": "在這種壓力下"
    },
    {
      "start": 589.48,
      "end": 590.7600000000001,
      "text": "有沒有一條路"
    },
    {
      "start": 590.7600000000001,
      "end": 592.72,
      "text": "不需要提升投延能力"
    },
    {
      "start": 592.72,
      "end": 594.24,
      "text": "不需要降低成本"
    },
    {
      "start": 594.24,
      "end": 597.5600000000001,
      "text": "就能平空把產品收益率拉高一節"
    },
    {
      "start": 597.5600000000001,
      "end": 598.16,
      "text": "有"
    },
    {
      "start": 598.16,
      "end": 599.48,
      "text": "就是把稅省掉"
    },
    {
      "start": 599.48,
      "end": 600.72,
      "text": "私募產品收益"
    },
    {
      "start": 600.72,
      "end": 602.76,
      "text": "腳百分之二十五所得稅"
    },
    {
      "start": 602.76,
      "end": 604.04,
      "text": "公募免稅"
    },
    {
      "start": 604.04,
      "end": 605.24,
      "text": "如果私募產品"
    },
    {
      "start": 605.24,
      "end": 607.12,
      "text": "能以公募身份納稅"
    },
    {
      "start": 607.12,
      "end": 609.12,
      "text": "那同樣的投資組合"
    },
    {
      "start": 609.12,
      "end": 611.2,
      "text": "到手收益就高出一節"
    },
    {
      "start": 611.2,
      "end": 612.36,
      "text": "產品在市場上"
    },
    {
      "start": 612.36,
      "end": 614.76,
      "text": "立刻擁有掩壓級的競爭力"
    },
    {
      "start": 614.76,
      "end": 615.84,
      "text": "規模做大"
    },
    {
      "start": 615.84,
      "end": 617.32,
      "text": "管理費收入上漲"
    },
    {
      "start": 617.32,
      "end": 619.2,
      "text": "中間業務指標好看"
