    {
      "start": 725.3199999999999,
      "end": 727.8399999999999,
      "text": "普惠禮財免稅政策被套禮"
    },
    {
      "start": 727.8399999999999,
      "end": 728.8399999999999,
      "text": "國家給的東西"
    },
    {
      "start": 728.8399999999999,
      "end": 731.0,
      "text": "沒有用在國家要求的地方"
    },
    {
      "start": 731.0,
      "end": 733.16,
      "text": "第二類是治理形勢化"
    },
    {
      "start": 733.16,
      "end": 735.4,
      "text": "經控集團對子公司的管控"
    },
    {
      "start": 735.4,
      "end": 736.7199999999999,
      "text": "形同虛設"
    },
    {
      "start": 736.7199999999999,
      "end": 738.1999999999999,
      "text": "大航內部的合規"
    },
    {
      "start": 738.2,
      "end": 741.12,
      "text": "封控稅務多條線集體施手"
    },
    {
      "start": 741.12,
      "end": 742.4000000000001,
      "text": "內部制衡機制"
    },
    {
      "start": 742.4000000000001,
      "end": 744.96,
      "text": "無法約束規模化為規行為"
    },
    {
      "start": 744.96,
      "end": 747.5200000000001,
      "text": "還能持續運行將近三年"
