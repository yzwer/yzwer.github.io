    {
      "start": 662.16,
      "end": 663.04,
      "text": "有組織"
    },
    {
      "start": 663.04,
      "end": 665.64,
      "text": "跨部門歷時29個月"
    },
    {
      "start": 665.64,
      "end": 667.04,
      "text": "系統性逃避角納"
    },
    {
      "start": 667.04,
      "end": 669.12,
      "text": "23.67億元稅款"
    },
    {
      "start": 669.12,
      "end": 671.28,
      "text": "最後的處理只是補腳稅款"
    },
    {
      "start": 671.28,
      "end": 672.36,
      "text": "內部整改"
