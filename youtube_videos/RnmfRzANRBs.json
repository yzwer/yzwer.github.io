    {
      "start": 638.2,
      "end": 639.32,
      "text": "時打時的"
    },
    {
      "start": 639.32,
      "end": 640.6800000000001,
      "text": "風險是遠期的"
    },
    {
      "start": 640.6800000000001,
      "end": 641.48,
      "text": "模糊的"
    },
    {
      "start": 641.48,
      "end": 643.4000000000001,
      "text": "大概率集體被割的"
    },
    {
      "start": 643.4000000000001,
      "end": 644.96,
      "text": "理性計算的結果"
    },
    {
      "start": 644.96,
      "end": 646.76,
      "text": "就是挺而走險"
    },
    {
      "start": 646.76,
      "end": 647.88,
      "text": "事發之後"
    },
    {
      "start": 647.88,
      "end": 649.6400000000001,
      "text": "中國銀行發表聲明"
    },
    {
      "start": 649.6400000000001,
      "end": 651.8000000000001,
      "text": "表示將足額不腳稅款"
    },
    {
      "start": 651.8000000000001,
      "end": 653.6400000000001,
      "text": "嚴肅開展內部問責"
    },
    {
      "start": 653.64,
      "end": 655.96,
      "text": "全面排查同類資管業務"
    },
    {
      "start": 655.96,
      "end": 659.16,
      "text": "不齊稅務封控與合規審核短板"
    },
    {
      "start": 659.16,
      "end": 660.16,
      "text": "但這個聲明"
