    {
      "start": 767.5600000000001,
      "end": 769.6,
      "text": "密集發布補稅公告"
    },
    {
      "start": 769.6,
      "end": 771.24,
      "text": "公開披露的補腳金額"
    },
    {
      "start": 771.24,
      "end": 773.5200000000001,
      "text": "以累積超過四十億元"
    },
    {
      "start": 773.5200000000001,
      "end": 774.5200000000001,
      "text": "需要注意"
