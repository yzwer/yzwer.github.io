    {
      "start": 717.3199999999999,
      "end": 718.56,
      "text": "和排照優勢"
    },
    {
      "start": 718.56,
      "end": 719.9599999999999,
      "text": "但金融機構的資金"
    },
    {
      "start": 719.9599999999999,
      "end": 721.9599999999999,
      "text": "和經歷完全跑偏"
    },
    {
      "start": 721.9599999999999,
      "end": 723.68,
      "text": "高標準農田建設資金"
