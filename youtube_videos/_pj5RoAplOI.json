    },
    {
      "start": 661.46,
      "end": 664.18,
      "text": "一年下來能有大幾百億歐元"
    },
    {
      "start": 664.18,
      "end": 668.34,
      "text": "所以說歐盟為什麼盯上中國跨境電商"
    },
    {
      "start": 668.34,
      "end": 669.42,
      "text": "在他們眼裡"
    },
    {
      "start": 669.42,
      "end": 671.7,
      "text": "不恩死中國跨境電商"
    },
    {
      "start": 671.7,
      "end": 674.22,
      "text": "那2600萬人的就業怎麼辦"
    },
    {
      "start": 674.22,
      "end": 677.34,
      "text": "靠層層分銷吃飯的中間商怎麼辦"
    },
    {
      "start": 677.34,
      "end": 681.02,
      "text": "被關稅養著的監管機構和執法隊伍怎麼辦"
    },
    {
      "start": 681.02,
      "end": 684.02,
      "text": "現在歐委會通過重罰中國企業"
    },
    {
      "start": 684.02,
      "end": 686.14,
      "text": "收緊對華出海監管"
    },
    {
      "start": 686.14,
      "end": 688.7,
      "text": "技能安撫本土虧損的零售資本"
    },
    {
      "start": 688.7,
      "end": 691.7,
      "text": "又能快速轉移內部的經濟矛盾"
    },
    {
      "start": 691.7,
      "end": 694.58,
      "text": "實現政治和經濟的雙重收益"
    },
    {
      "start": 694.58,
      "end": 697.26,
      "text": "這比仗其實並不難算"
    },
    {
      "start": 697.26,
      "end": 699.74,
      "text": "而且這一輪監管收緊"
    },
    {
      "start": 699.74,
      "end": 702.42,
      "text": "也不只是電商行業單獨在挨打"
    },
    {
      "start": 702.42,
      "end": 704.66,
      "text": "這兩年出海的中國企業"
    },
    {
      "start": 704.66,
      "end": 706.78,
      "text": "幾乎航航都踩過雷"
    },
    {
      "start": 706.78,
      "end": 708.86,
      "text": "前幾年出海的老闆眼裡"
    },
    {
      "start": 708.86,
      "end": 710.62,
      "text": "海外全是南海"
    },
    {
      "start": 710.62,
      "end": 712.26,
      "text": "辯地都是訂單"
    },
    {
      "start": 712.26,
      "end": 713.46,
      "text": "誰也沒料到"
    },
    {
      "start": 713.46,
      "end": 716.06,
      "text": "現在市場分額越做越大"
    },
    {
      "start": 716.06,
      "end": 719.38,
      "text": "各國監管的大棒也落得越來越勤"
    },
    {
      "start": 719.38,
      "end": 723.34,
      "text": "TikTok 大江 小米 三一 四摩爾"
    },
    {
      "start": 723.34,
      "end": 725.74,
      "text": "從電商 數碼到電子顏"
    },
    {
      "start": 725.74,
      "end": 727.7,
      "text": "各航各業的中國企業"
    },
    {
      "start": 727.7,
      "end": 729.86,
      "text": "近兩年在歐美和東南亞等地"
    },
    {
      "start": 729.86,
      "end": 731.58,
      "text": "都收到過監管罰單"
    },
    {
      "start": 731.58,
      "end": 733.06,
      "text": "二零二五年八月"
    },
    {
      "start": 733.06,
      "end": 736.14,
      "text": "印尼繁壟斷機構KPPU給三億集團"
    },
    {
      "start": 736.14,
      "end": 739.38,
      "text": "開出了4491印尼頓的罰單"
    },
    {
      "start": 739.38,
      "end": 741.78,
      "text": "折合人民幣約1.97億"
    },
    {
      "start": 741.78,
      "end": 744.9,
      "text": "創下了KPPU 史上最高罰單紀錄"
    },
    {
      "start": 744.9,
      "end": 747.38,
      "text": "印尼官方給出的處罰原因是"
    },
    {
      "start": 747.38,
      "end": 749.34,
      "text": "三一逼著本地經銷商"
    },
    {
      "start": 749.34,
      "end": 751.38,
      "text": "只能從自家渠道拿貨"
    },
    {
      "start": 751.38,
      "end": 753.62,
      "text": "還繞開中間商職工客戶"
    },
    {
      "start": 753.62,
      "end": 755.58,
      "text": "本地商家根本沒活路"
    },
    {
      "start": 755.58,
      "end": 757.94,
      "text": "直接做實了壟斷嫌疑"
    },
    {
      "start": 757.94,
      "end": 759.18,
      "text": "同在東南亞"
    },
    {
      "start": 759.18,
      "end": 760.82,
      "text": "TikTok也沒躲過"
    },
    {
      "start": 760.82,
      "end": 763.62,
      "text": "因為海外子公司收購本土電商"
    },
    {
      "start": 763.62,
      "end": 765.98,
      "text": "收購手續沒暗示報備"
    },
    {
      "start": 765.98,
      "end": 768.02,
      "text": "被罰了90萬美元"
    },
    {
      "start": 768.02,
      "end": 769.78,
      "text": "歐美這邊也不手軟"
    },
    {
      "start": 769.78,
      "end": 771.34,
      "text": "二零二五年十月"
    },
    {
      "start": 771.34,
      "end": 773.94,
      "text": "大江在義大利被立案調查"
    },
    {
      "start": 773.98,
      "end": 776.34,
      "text": "原因是統一鎖死零售價"
    },
    {
      "start": 776.34,
      "end": 778.22,
      "text": "哪家門店私自降價"
    },
    {
      "start": 778.22,
      "end": 780.06,
      "text": "直接斷共撤授權"
    },
    {
      "start": 780.06,
      "end": 783.34,
      "text": "還不讓商家從歐盟其他國家拿低價貨"
    },
    {
      "start": 783.34,
      "end": 784.22,
      "text": "兩套操作"
    },
    {
      "start": 784.22,
      "end": 787.02,
      "text": "全採到了當地反壟斷的高壓卸"
    },
    {
      "start": 787.02,
      "end": 788.46,
      "text": "二零二四年五月"
    },
    {
      "start": 788.46,
      "end": 791.54,
      "text": "小米在波蘭直接被執法上門搜查"
    },
    {
      "start": 791.54,
      "end": 792.66,
      "text": "全系列手機"
    },
    {
      "start": 792.66,
      "end": 794.66,
      "text": "加電的經銷合同埃克番"
    },
    {
      "start": 794.66,
      "end": 796.58,
      "text": "波蘭反壟斷監管機構"
    },
    {
      "start": 796.58,
      "end": 798.54,
      "text": "懷疑小米暗中控價"
    },
    {
      "start": 798.54,
      "end": 800.1,
      "text": "不讓商家打折"
    },
    {
      "start": 800.1,
      "end": 802.18,
      "text": "案子到現在還沒省完"
    },
    {
      "start": 802.22,
      "end": 804.7,
      "text": "二零二五年四月和七月"
    },
    {
      "start": 804.7,
      "end": 806.82,
      "text": "電子煙龍頭思摸耳"
    },
    {
      "start": 806.82,
      "end": 809.66,
      "text": "在美國連吃兩場反壟斷官司"
    },
    {
      "start": 809.66,
      "end": 811.9,
      "text": "被同行起訴操縱價格"
    },
    {
      "start": 811.9,
      "end": 813.58,
      "text": "排擠競爭對手"
    },
    {
      "start": 813.58,
      "end": 815.86,
      "text": "違反聯邦反壟斷法"
    },
    {
      "start": 815.86,
      "end": 816.94,
      "text": "與此同時"
    },
    {
      "start": 816.94,
      "end": 819.9,
      "text": "中國的互聯網巨頭在海外擴張"
    },
    {
      "start": 819.9,
      "end": 821.78,
      "text": "照樣沒少吃官司"
    },
    {
      "start": 821.78,
      "end": 824.86,
      "text": "阿里早年國內那套二選一的老路子"
    },
    {
      "start": 824.86,
      "end": 826.14,
      "text": "搬到美國之後"
    },
    {
      "start": 826.14,
      "end": 828.18,
      "text": "直接引來了集體訴訟"
    },
    {
      "start": 828.18,
      "end": 831.5,
      "text": "最後掏了四億多美元才百平糾紛"
    },
    {
      "start": 831.54,
      "end": 833.54,
      "text": "騰訊手裡握著遊戲公司"
    },
    {
      "start": 833.54,
      "end": 834.94,
      "text": "埃培克的股份"
    },
    {
      "start": 834.94,
      "end": 837.78,
      "text": "旗下又運營著競品遊戲廠商"
    },
    {
      "start": 837.78,
      "end": 839.98,
      "text": "兩邊董事出現重疊"
    },
    {
      "start": 839.98,
      "end": 841.54,
      "text": "在美國監管眼裡"
    },
    {
      "start": 841.54,
      "end": 844.3,
      "text": "這就涉嫌虛弱行業競爭"
    },
    {
      "start": 844.3,
      "end": 845.78,
      "text": "最後搞的沒辦法"
    },
    {
      "start": 845.78,
      "end": 847.5,
      "text": "只能調整齒骨"
    },
    {
      "start": 847.5,
      "end": 848.7,
      "text": "退出董事會"
    },
    {
      "start": 848.7,
      "end": 850.1,
      "text": "才算過關"
    },
    {
      "start": 850.1,
      "end": 851.34,
      "text": "長期以來"
    },
    {
      "start": 851.34,
      "end": 853.62,
      "text": "很多中國企業出海"
    },
    {
      "start": 853.62,
      "end": 856.74,
      "text": "總習慣把國內做生意那套照搬過去"
    },
    {
      "start": 856.74,
      "end": 859.78,
      "text": "一些在國內早就吸以為長的操作"
    },
    {
      "start": 859.82,
      "end": 861.58,
      "text": "結果一放到海外"
    },
    {
      "start": 861.58,
      "end": 863.9,
      "text": "全都成了違規雷區"
    },
    {
      "start": 863.9,
      "end": 865.54,
      "text": "此前中國出海企業"
    },
    {
      "start": 865.54,
      "end": 867.58,
      "text": "普遍存在一種繳性心理"
    },
    {
      "start": 867.58,
      "end": 869.82,
      "text": "雖然法規條文擺在那裡"
    },
    {
      "start": 869.82,
      "end": 871.7,
      "text": "但監管執法寬鬆"
    },
    {
      "start": 871.7,
      "end": 874.42,
      "text": "先跑規模再補和規業來的計"
    },
    {
      "start": 874.42,
      "end": 876.38,
      "text": "可如今歐盟執法的邏輯"
    },
    {
      "start": 876.38,
      "end": 877.62,
      "text": "已經開始返轉"
    },
    {
      "start": 877.62,
      "end": 878.78,
      "text": "不再只看企業"
    },
    {
      "start": 878.78,
      "end": 880.98,
      "text": "有沒有指面上的和規文件"
    },
    {
      "start": 880.98,
      "end": 883.82,
      "text": "而是深挖實際運營裡的每一處漏洞"
    },
    {
      "start": 883.82,
      "end": 885.62,
      "text": "就連廣告劃數"
    },
    {
      "start": 885.62,
      "end": 886.66,
      "text": "一面設計"
    },
    {
      "start": 886.66,
      "end": 888.62,
      "text": "庫存提示這類細節"
    },
    {
      "start": 888.62,
      "end": 890.62,
      "text": "都會被納入審查範圍"
    },
    {
      "start": 890.62,
      "end": 892.42,
      "text": "過去靠低價流量"
    },
    {
      "start": 892.42,
      "end": 894.98,
      "text": "營銷套路也蠻擴張的老路子"
    },
    {
      "start": 894.98,
      "end": 898.18,
      "text": "以後在歐洲市場徹底走不通了"
    },
    {
      "start": 898.18,
      "end": 899.34,
      "text": "更重要的是"
    },
    {
      "start": 899.34,
      "end": 902.7,
      "text": "全球市場的配套政策也在同步收緊"
    },
    {
      "start": 902.7,
      "end": 905.14,
      "text": "盡斷時間以來不只歐美"
    },
    {
      "start": 905.14,
      "end": 906.5,
      "text": "許多東南亞國家"
    },
    {
      "start": 906.5,
      "end": 908.98,
      "text": "也開始限制中國電商擁入"
    },
    {
      "start": 908.98,
      "end": 910.38,
      "text": "本土企業保護"
    },
    {
      "start": 910.38,
      "end": 911.26,
      "text": "繁壟斷"
    },
    {
      "start": 911.26,
      "end": 912.42,
      "text": "環保宣傳"
    },
    {
      "start": 912.42,
      "end": 914.18,
      "text": "數據跨境傳輸"
    },
    {
      "start": 914.18,
      "end": 916.46,
      "text": "多套規則層層加碼"
    },
    {
      "start": 916.46,
      "end": 917.46,
      "text": "過去十年"
    },
    {
      "start": 917.5,
      "end": 918.9,
      "text": "中國跨境平臺"
    },
    {
      "start": 918.9,
      "end": 920.38,
      "text": "靠著完整供應鏈"
    },
    {
      "start": 920.38,
      "end": 921.5,
      "text": "極致低價"
    },
    {
      "start": 921.5,
      "end": 923.46,
      "text": "快速搶賺海外流量"
    },
    {
      "start": 923.46,
      "end": 925.66,
      "text": "這種高速擴張的背後"
    },
    {
      "start": 925.66,
      "end": 929.06,
      "text": "藏著大量被暫時擱置的合規成本"
    },
    {
      "start": 929.06,
      "end": 929.78,
      "text": "如今"
    },
    {
      "start": 929.78,
      "end": 932.1,
      "text": "一張天價罰單砸下來"
    },
    {
      "start": 932.1,
      "end": 933.34,
      "text": "可能就要吃掉"
    },
    {
      "start": 933.34,
      "end": 935.98,
      "text": "數年海外經營的全部理論"
    },
    {
      "start": 935.98,
      "end": 938.7,
      "text": "對國內的中小跨境賣價來說"
    },
    {
      "start": 938.7,
      "end": 941.26,
      "text": "日子只會一天比一天難熬"
    },
    {
      "start": 941.26,
      "end": 942.42,
      "text": "低合規成本"
    },
    {
      "start": 942.42,
      "end": 943.54,
      "text": "侵量化運營"
    },
    {
      "start": 943.54,
      "end": 944.7,
      "text": "勃利多銷"
    },
    {
      "start": 944.7,
      "end": 947.42,
      "text": "這本來就是中小賣價吃飯的根據"
    },
    {
      "start": 947.42,
      "end": 950.1,
      "text": "而歐盟持續收緊的合規體系"
    },
    {
      "start": 950.1,
      "end": 952.86,
      "text": "嚴重打擊了這套生存邏輯"
    },
    {
      "start": 952.86,
      "end": 955.18,
      "text": "高額的合規和整改成本"
    },
    {
      "start": 955.18,
      "end": 957.98,
      "text": "是中小賣價根本無法承受的"
    },
    {
      "start": 957.98,
      "end": 960.18,
      "text": "跨境電商的性價比神話"
    },
    {
      "start": 960.18,
      "end": 961.82,
      "text": "會被一點點瓦解"
    },
    {
      "start": 961.82,
      "end": 965.06,
      "text": "一大批賣價將被迫調整市場不局"
    },
    {
      "start": 965.06,
      "end": 966.98,
      "text": "甚至徹底退出"
    },
    {
      "start": 966.98,
      "end": 969.14,
      "text": "同時出海的不確定性"
    },
    {
      "start": 969.14,
      "end": 970.62,
      "text": "也在不斷增長"
    },
    {
      "start": 970.62,
      "end": 973.3,
      "text": "歐盟收緊監管最大的危害"
    },
    {
      "start": 973.3,
      "end": 974.94,
      "text": "不在於罰款本身"
    },
    {
      "start": 974.94,
      "end": 977.38,
      "text": "而在於合規的邊界無限模糊"
    },
    {
      "start": 977.66,
      "end": 979.82,
      "text": "執法及其主觀隨意"
    },
    {
      "start": 979.82,
      "end": 982.66,
      "text": "沒有一種可以量化的合規標準"
    },
    {
      "start": 982.66,
      "end": 983.78,
      "text": "是否違規"
    },
    {
      "start": 983.78,
      "end": 985.42,
      "text": "整改是否達標"
    },
    {
      "start": 985.42,
      "end": 987.06,
      "text": "是否追加處罰"
    },
    {
      "start": 987.06,
      "end": 989.7,
      "text": "全都有歐委會單方面判定"
    },
    {
      "start": 989.7,
      "end": 992.1,
      "text": "企業時刻處在焦慮之中"
    },
    {
      "start": 992.1,
      "end": 993.14,
      "text": "生怕哪天"
    },
    {
      "start": 993.14,
      "end": 995.26,
      "text": "歐委會揮舞者行政大棒"
    },
    {
      "start": 995.26,
      "end": 996.86,
      "text": "就砸到自己身上"
    },
    {
      "start": 996.86,
      "end": 998.3,
      "text": "再往深了說"
    },
    {
      "start": 998.3,
      "end": 999.22,
      "text": "這種處罰"
    },
    {
      "start": 999.22,
      "end": 1001.66,
      "text": "還會起到一種糟糕的示範效應"
    },
    {
      "start": 1001.66,
      "end": 1004.9,
      "text": "歐盟如果打壓中國跨境電商成功"
    },
    {
      "start": 1004.9,
      "end": 1007.3,
      "text": "會讓西方和其他新興經濟體"
    },
    {
      "start": 1007.3,
      "end": 1009.54,
      "text": "看到一種可以複製的路徑"
    },
    {
      "start": 1009.54,
      "end": 1012.86,
      "text": "讓單點打壓演變成全球味度"
    },
    {
      "start": 1012.86,
      "end": 1013.86,
      "text": "這就意味著"
    },
    {
      "start": 1013.86,
      "end": 1017.34,
      "text": "中國跨境電商的黃金時代將逐步終結"
    },
    {
      "start": 1017.34,
      "end": 1019.7,
      "text": "外貿行業將進入一個高風險"
    },
    {
      "start": 1019.7,
      "end": 1021.58,
      "text": "低增長的新週期"
    },
    {
      "start": 1021.58,
      "end": 1023.7,
      "text": "對於中國跨境電商來說"
    },
    {
      "start": 1023.7,
      "end": 1026.42,
      "text": "歐洲市場曾經是施核遠方"
    },
    {
      "start": 1026.42,
      "end": 1029.62,
      "text": "可現在正在變成坑和陷阱"
    },
    {
      "start": 1029.62,
      "end": 1032.18,
      "text": "海外市場正在告別紙瓶價格"
    },
    {
      "start": 1032.18,
      "end": 1034.22,
      "text": "紙瓶速度的野蠻時代"
    },
    {
      "start": 1034.22,
      "end": 1036.22,
      "text": "流量紅麗慢慢消退"
    },
    {
      "start": 1036.22,
      "end": 1038.38,
      "text": "規則門砍持續抬高"
    },
    {
      "start": 1038.38,
      "end": 1040.86,
      "text": "出海的路也許還很長"
    },
    {
      "start": 1040.86,
      "end": 1043.62,
      "text": "但路上的雷已經是越來越多了"
    }
  ],
  "language": "zh"
}