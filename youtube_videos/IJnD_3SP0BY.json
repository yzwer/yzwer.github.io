      "start": 454.16,
      "end": 457.08000000000004,
      "text": "收入分配和社会保障加利"
    },
    {
      "start": 457.12,
      "end": 458.88,
      "text": "目前中低收入群体"
    },
    {
      "start": 458.88,
      "end": 460.52,
      "text": "占总人口约6成"
    },
    {
      "start": 460.52,
      "end": 463.2,
      "text": "但收入占比只有3成左右"
    },
    {
      "start": 463.2,
      "end": 465.12,
      "text": "如果能把这个占比提高"
    },
    {
      "start": 465.12,
      "end": 466.47999999999996,
      "text": "哪怕5个百分点"
    },
    {
      "start": 466.47999999999996,
      "end": 469.52,
      "text": "对消费的拉动都是数千亿级别的"
    },
    {
      "start": 469.52,
      "end": 472.12,
      "text": "具体路径包括加快成乡居民"
    },
    {
      "start": 472.12,
      "end": 473.44,
      "text": "增收计划落地"
    },
    {
      "start": 473.44,
      "end": 475.56,
      "text": "提高农村养老金水平"
    },
    {
      "start": 475.56,
      "end": 477.15999999999997,
      "text": "扩大依保覆盖面"
    },
    {
      "start": 477.15999999999997,
      "end": 479.68,
      "text": "加大生育养育保障利度"
    },
    {
      "start": 479.68,
      "end": 480.15999999999997,
      "text": "另外"
    },
    {
      "start": 480.15999999999997,
      "end": 482.4,
      "text": "还有一个相对容易操作的办法"
    },
    {
      "start": 482.4,
      "end": 484.88,
      "text": "把住房攻击金的个人脚存部分"
    },
    {
      "start": 484.88,
      "end": 486.2,
      "text": "和单位脚存部分"
    },
    {
      "start": 486.2,
      "end": 487.92,
      "text": "都直接发给个人"
    },
    {
      "start": 487.92,
      "end": 489.24,
      "text": "越新一万的人"
    },
    {
      "start": 489.24,
      "end": 490.32,
      "text": "到手收入"
    },
    {
      "start": 490.32,
      "end": 492.47999999999996,
      "text": "可以一下提高好几千"
    },
    {
      "start": 492.47999999999996,
      "end": 494.44,
      "text": "消费能力力干建营"
    },
    {
      "start": 494.44,
      "end": 495.44,
      "text": "第四条"
    },
    {
      "start": 495.44,
      "end": 497.12,
      "text": "减少行政管控"
    },
    {
      "start": 497.12,
      "end": 499.08,
      "text": "让市场修养生息"
    },
    {
      "start": 499.08,
      "end": 500.0,
      "text": "消费领域"
    },
    {
      "start": 500.0,
      "end": 502.4,
      "text": "还有不少不合理的限制措施"
    },
    {
      "start": 502.4,
      "end": 504.0,
      "text": "该清理的清理"
    },
    {
      "start": 504.0,
      "end": 505.56,
      "text": "该放宽的放宽"
    },
    {
      "start": 505.56,
      "end": 507.76,
      "text": "尤其是服务业准入"
    },
    {
      "start": 507.76,
      "end": 509.12,
      "text": "很多小生意"
    },
    {
      "start": 509.12,
      "end": 509.84,
      "text": "争议之言"
    },
    {
      "start": 509.84,
      "end": 510.52,
      "text": "必之言"
    },
    {
      "start": 510.52,
      "end": 512.08,
      "text": "还能养家糊口"
    },
    {
      "start": 512.08,
      "end": 513.4399999999999,
      "text": "但凡事叫针"
    },
    {
      "start": 513.4399999999999,
      "end": 515.0,
      "text": "全面正照管理"
    },
    {
      "start": 515.0,
      "end": 517.12,
      "text": "营生就只能关门"
    },
    {
      "start": 517.12,
      "end": 520.04,
      "text": "把这部分压抑的民间活力释放出来"
    },
    {
      "start": 520.04,
      "end": 522.68,
      "text": "对消费的编辑供现不可小去"
    },
    {
      "start": 522.68,
      "end": 525.72,
      "text": "这几条药方方向上各有道理"
    },
    {
      "start": 525.72,
      "end": 526.56,
      "text": "那问题来了"
    },
    {
      "start": 526.56,
      "end": 528.0,
      "text": "能不能真的落地"
    },
    {
      "start": 528.0,
      "end": 530.16,
      "text": "这里我们要引入另一种声音"
    },
    {
      "start": 530.16,
      "end": 531.68,
      "text": "这是一个非常清醒"
    },
    {
      "start": 531.68,
      "end": 533.6,
      "text": "也相当悲观的观点"
    },
    {
      "start": 533.6,
      "end": 535.52,
      "text": "这个观点的核心判断是"
    },
    {
      "start": 535.52,
      "end": 536.76,
      "text": "这篇求是文章"
    },
    {
      "start": 536.76,
      "end": 538.08,
      "text": "没有实际政策"
    },
    {
      "start": 538.08,
      "end": 539.48,
      "text": "没有配套资金"
    },
    {
      "start": 539.48,
      "end": 542.12,
      "text": "本质上是一次认知框架的表态"
    },
    {
      "start": 542.12,
      "end": 544.32,
      "text": "而非政策行动的预告"
    },
    {
      "start": 544.36,
      "end": 545.5200000000001,
      "text": "这个判断的一句"
    },
    {
      "start": 545.5200000000001,
      "end": 548.2,
      "text": "在于一个近年来越来越明显的现象"
    },
    {
      "start": 548.2,
      "end": 549.8000000000001,
      "text": "官方媒体的发文"
    },
    {
      "start": 549.8000000000001,
      "end": 551.5200000000001,
      "text": "和实际政策的落地"
    },
    {
      "start": 551.5200000000001,
      "end": 554.08,
      "text": "正在出现越来越大的烈口"
    },
    {
      "start": 554.08,
      "end": 555.0,
      "text": "过去"
    },
    {
      "start": 555.0,
      "end": 556.5200000000001,
      "text": "懂中国政治的人"
    },
    {
      "start": 556.5200000000001,
      "end": 558.6400000000001,
      "text": "都高度关注官媒表态"
    },
    {
      "start": 558.6400000000001,
      "end": 561.1600000000001,
      "text": "因为定调往往先与落地"
    },
    {
      "start": 561.1600000000001,
      "end": 563.5200000000001,
      "text": "两者之间的关联是真实的"
    },
    {
      "start": 563.5200000000001,
      "end": 564.6800000000001,
      "text": "但近些年"
    },
    {
      "start": 564.6800000000001,
      "end": 567.0400000000001,
      "text": "这条链条的可靠性在下降"
    },
    {
      "start": 567.0400000000001,
      "end": 569.24,
      "text": "文章发了政策没来"
    },
    {
      "start": 569.24,
      "end": 570.1600000000001,
      "text": "调子定了"
    },
    {
      "start": 570.1600000000001,
      "end": 571.36,
      "text": "资金没跟上"
    },
    {
      "start": 571.36,
      "end": 573.8800000000001,
      "text": "这种情况出现的频率越来越高"
    },
    {
      "start": 573.88,
      "end": 576.52,
      "text": "更深层的问题在于内需体证"
    },
    {
      "start": 576.52,
      "end": 579.36,
      "text": "在目前的决策优先及排序中"
    },
    {
      "start": 579.36,
      "end": 581.04,
      "text": "并不举手位"
    },
    {
      "start": 581.04,
      "end": 582.28,
      "text": "摆在它前面的"
    },
    {
      "start": 582.28,
      "end": 584.0,
      "text": "至少有两座大山"
    },
    {
      "start": 584.0,
      "end": 586.48,
      "text": "第一座是财政和银行业"
    },
    {
      "start": 586.48,
      "end": 589.24,
      "text": "地方政府债务问题击累多年"
    },
    {
      "start": 589.24,
      "end": 591.52,
      "text": "至今未见实质性豪转"
    },
    {
      "start": 591.52,
      "end": 595.24,
      "text": "各级政府比起结流更倾向于开源"
    },
    {
      "start": 595.24,
      "end": 597.52,
      "text": "无论它的开源措施是什么"
    },
    {
      "start": 597.52,
      "end": 600.32,
      "text": "结果都是民营部门的资金空间"
    },
    {
      "start": 600.32,
      "end": 602.0,
      "text": "被进一步压缩"
    },
    {
      "start": 602.04,
      "end": 604.44,
      "text": "银行业的情况同样不容乐观"
    },
    {
      "start": 604.44,
      "end": 606.28,
      "text": "官方公布的不良贷款率"
    },
    {
      "start": 606.28,
      "end": 609.16,
      "text": "长期排怀在1.5%左右"
    },
    {
      "start": 609.16,
      "end": 613.2,
      "text": "但这个数字明显低估了银行系统的真实压力"
    },
    {
      "start": 613.2,
      "end": 616.12,
      "text": "相当多实质性于期贷款通过展极"
    },
    {
      "start": 616.12,
      "end": 619.08,
      "text": "利息资本化等方式被藏起来"
    },
    {
      "start": 619.08,
      "end": 620.4,
      "text": "外部机构的测算"
    },
    {
      "start": 620.4,
      "end": 622.72,
      "text": "远比官方数据悲观的多"
    },
    {
      "start": 622.72,
      "end": 625.88,
      "text": "为了避免银行业出现系统性风险"
    },
    {
      "start": 625.88,
      "end": 628.48,
      "text": "政府今年将发行3000亿专项债"
    },
    {
      "start": 628.48,
      "end": 630.28,
      "text": "用于银行资本重组"
    },
    {
      "start": 630.28,
      "end": 632.4399999999999,
      "text": "去年已经注资5000亿"
    },
    {
      "start": 632.4399999999999,
      "end": 633.76,
      "text": "银行需要钱"
    },
    {
      "start": 633.76,
      "end": 636.16,
      "text": "财政本身已经高度成压"
    },
    {
      "start": 636.16,
      "end": 638.64,
      "text": "第二座是科技民族主义"
    },
    {
      "start": 638.64,
      "end": 642.16,
      "text": "当前角色层在科技领域的雄心状质"
    },
    {
      "start": 642.16,
      "end": 644.0,
      "text": "几乎是不计成本的"
    },
    {
      "start": 644.0,
      "end": 646.28,
      "text": "数据中心5万亿投资计划"
    },
    {
      "start": 646.28,
      "end": 650.0799999999999,
      "text": "芯片等领域每年估计8000亿左右的持续投入"
    },
    {
      "start": 650.0799999999999,
      "end": 653.36,
      "text": "这些都在消耗本就紧张的财政空间"
    },
    {
      "start": 653.36,
      "end": 655.56,
      "text": "科技突破当然值得肯定"
    },
    {
      "start": 655.56,
      "end": 657.68,
      "text": "但天下没有免费的午餐"
    },
    {
      "start": 657.6800000000001,
      "end": 661.44,
      "text": "这些资金都是从有限的财政总盘子里出来的"
    },
    {
      "start": 661.44,
      "end": 663.24,
      "text": "在这两座大山的众压下"
    },
    {
      "start": 663.24,
      "end": 664.9200000000001,
      "text": "有没有技能体制内需"
    },
    {
      "start": 664.9200000000001,
      "end": 667.72,
      "text": "又不引发其他后果的政策空间呢"
    },
    {
      "start": 667.72,
      "end": 670.44,
      "text": "悲观派认为实质上没有"
    },
    {
      "start": 670.44,
      "end": 672.7600000000001,
      "text": "修复居民资产复债表"
    },
    {
      "start": 672.7600000000001,
      "end": 674.5200000000001,
      "text": "理论上最有效的办法是"
    },
    {
      "start": 674.5200000000001,
      "end": 675.9200000000001,
      "text": "仿兆日本模式"
    },
    {
      "start": 675.9200000000001,
      "end": 677.5200000000001,
      "text": "用国家财政预算"
    },
    {
      "start": 677.5200000000001,
      "end": 680.36,
      "text": "和销银行系统的烂尾楼坏仗"
    },
    {
      "start": 680.36,
      "end": 682.6400000000001,
      "text": "帮居民部门卸下包袱"
    },
    {
      "start": 682.6400000000001,
      "end": 685.1600000000001,
      "text": "但这意味着天亮的资金注入"
    },
    {
      "start": 685.1600000000001,
      "end": 686.8000000000001,
      "text": "在维持银行不暴雷"
    },
    {
      "start": 686.8000000000001,
      "end": 689.48,
      "text": "科技投资不缩水的双重约束下"
    },
    {
      "start": 689.48,
      "end": 690.84,
      "text": "政府额外举债"
    },
    {
      "start": 690.84,
      "end": 693.48,
      "text": "替居民买单的空间极为有限"
    },
    {
      "start": 693.48,
      "end": 695.08,
      "text": "收入政策方向呢"
    },
    {
      "start": 695.08,
      "end": 697.2800000000001,
      "text": "悲观派同样不乐观"
    },
    {
      "start": 697.2800000000001,
      "end": 699.6400000000001,
      "text": "今年来设保技术一再提高"
    },
    {
      "start": 699.6400000000001,
      "end": 701.5600000000001,
      "text": "中低收入人群的负单"
    },
    {
      "start": 701.5600000000001,
      "end": 704.36,
      "text": "反而比高收入群体增加得更快"
    },
    {
      "start": 704.36,
      "end": 707.72,
      "text": "对小型企业和小电商增收增值税"
    },
    {
      "start": 707.72,
      "end": 709.36,
      "text": "也在加重他们的压力"
    },
    {
      "start": 709.36,
      "end": 712.6800000000001,
      "text": "这与提振内需的方向恰恰相反"
    },
    {
      "start": 712.6800000000001,
      "end": 715.6400000000001,
      "text": "那对国有企业的特殊力率优势动刀呢"
    },
    {
      "start": 715.6400000000001,
      "end": 716.6800000000001,
      "text": "也不现实"
    },
    {
      "start": 716.6800000000001,
      "end": 719.96,
      "text": "至于打造国家冠军产业的战略相冲突"
    },
    {
      "start": 719.96,
      "end": 721.6800000000001,
      "text": "提高最低工资呢"
    },
    {
      "start": 721.6800000000001,
      "end": 724.4000000000001,
      "text": "消费对地方政府是外不幸的"
    },
    {
      "start": 724.4000000000001,
      "end": 727.8800000000001,
      "text": "各地很容易陷入争夺企业投资的主帝竞争"
    },
    {
      "start": 727.8800000000001,
      "end": 731.48,
      "text": "中央政府也很难跨越发展差异巨大的省份"
    },
    {
      "start": 731.48,
      "end": 733.08,
      "text": "统一制定标准"
    },
    {
      "start": 733.08,
      "end": 733.84,
      "text": "所以"
    },
    {
      "start": 733.84,
      "end": 737.0400000000001,
      "text": "悲观逻辑的结论是认知可以突破"
    },
    {
      "start": 737.0400000000001,
      "end": 740.36,
      "text": "但政策空间受制于多重结构性约束"
    },
    {
      "start": 740.36,
      "end": 742.9200000000001,
      "text": "实质性的内需提振政策"
    },
    {
      "start": 742.9200000000001,
      "end": 745.6,
      "text": "很难在现有框架内出现"
    },
    {
      "start": 745.6,
      "end": 747.72,
      "text": "两种声音都摆在这里了"
    },
    {
      "start": 747.72,
      "end": 749.32,
      "text": "我们的判断是"
    },
    {
      "start": 749.32,
      "end": 751.24,
      "text": "这篇求是文章的价值"
    },
    {
      "start": 751.24,
      "end": 752.44,
      "text": "不应该被低估"
    },
    {
      "start": 752.44,
      "end": 754.12,
      "text": "但也不应该高股"
    },
    {
      "start": 754.12,
      "end": 755.28,
      "text": "不应该低估"
    },
    {
      "start": 755.28,
      "end": 757.76,
      "text": "是因为它完成了一件关键的事"
    },
    {
      "start": 757.76,
      "end": 760.12,
      "text": "认知框架的正式转换"
    },
    {
      "start": 760.12,
      "end": 761.4,
      "text": "从消费不振"
    },
    {
      "start": 761.4,
      "end": 763.12,
      "text": "是因为大家不愿意花钱"
    },
    {
      "start": 763.12,
      "end": 764.44,
      "text": "转向消费不振"
    },
    {
      "start": 764.44,
      "end": 767.32,
      "text": "是因为大家的资产复债表售商了"
    },
    {
      "start": 767.32,
      "end": 770.6,
      "text": "从提振消费要靠发消费券搞粗销"
    },
    {
      "start": 770.6,
      "end": 771.88,
      "text": "转向提振消费"
    },
    {
      "start": 771.88,
      "end": 775.24,
      "text": "要先稳住资产价格修复财富与期"
    },
    {
      "start": 775.24,
      "end": 776.76,
      "text": "这个转换本身"
    },
    {
      "start": 776.76,
      "end": 779.12,
      "text": "比任何具体政策都重要"
    },
    {
      "start": 779.12,
      "end": 782.08,
      "text": "因为在这个认知框架建立起来之前"
    },
    {
      "start": 782.08,
      "end": 784.36,
      "text": "根本不可能有正确的政策"
    },
    {
      "start": 784.36,
      "end": 785.52,
      "text": "不应该高估"
    },
    {
      "start": 785.52,
      "end": 787.88,
      "text": "是因为认知升级只是第一步"
    },
    {
      "start": 787.88,
      "end": 789.6,
      "text": "真正的考验在于"
    },
    {
      "start": 789.6,
      "end": 791.32,
      "text": "有没有足够的政策工具"
    },
    {
      "start": 791.32,
      "end": 792.72,
      "text": "足够的政治决心"
    },
    {
      "start": 792.72,
      "end": 794.28,
      "text": "足够的财政空间"
    },
    {
      "start": 794.28,
      "end": 796.24,
      "text": "去打破那个资产价格下跌"
    },
    {
      "start": 796.24,
      "end": 797.48,
      "text": "消费收缩"
    },
    {
      "start": 797.48,
      "end": 800.72,
      "text": "经济下行互相咬合的互相罗选"
    },
    {
      "start": 800.72,
      "end": 801.6,
      "text": "这个问题"
    },
    {
      "start": 801.6,
      "end": 803.6800000000001,
      "text": "这篇文章没有给出答案"
    },
    {
      "start": 803.6800000000001,
      "end": 805.44,
      "text": "悲观派说官媒表态"
    },
    {
      "start": 805.44,
      "end": 807.96,
      "text": "和政策落地之间的列口越来越大"
    },
    {
      "start": 807.96,
      "end": 810.6,
      "text": "这个观察我们认为是准确的"
    },
    {
      "start": 810.6,
      "end": 812.5200000000001,
      "text": "但我们也注意到一个细节"
    },
    {
      "start": 812.5200000000001,
      "end": 814.6,
      "text": "求是提消费的相关文章"
    },
    {
      "start": 814.6,
      "end": 816.48,
      "text": "这是今年的第三篇"
    },
    {
      "start": 816.48,
      "end": 818.7600000000001,
      "text": "半年三篇密度異常"
    },
    {
      "start": 818.7600000000001,
      "end": 820.6800000000001,
      "text": "而且措辞从改山与期"
    },
    {
      "start": 820.6800000000001,
      "end": 823.96,
      "text": "稳于期升级到了修复资产傅债表"
    },
    {
      "start": 823.96,
      "end": 826.44,
      "text": "防止傅向罗选与期在硬化"
    },
    {
      "start": 826.44,
      "end": 827.9200000000001,
      "text": "认知在深化"
    },
    {
      "start": 827.9200000000001,
      "end": 828.96,
      "text": "按照逛例"
    },
    {
      "start": 828.96,
      "end": 830.4000000000001,
      "text": "7月通常会召开"
    },
    {
      "start": 830.4000000000001,
      "end": 833.6400000000001,
      "text": "以经济工作为核心议题的重量机会议"
    },
    {
      "start": 833.64,
      "end": 836.88,
      "text": "这次会议上会不会有十字性的政策跟进"
    },
    {
      "start": 836.88,
      "end": 840.68,
      "text": "将是对求是第三篇信号最直接的检验"
    },
    {
      "start": 840.68,
      "end": 843.92,
      "text": "看看能不能从认知突破变成政策行动"
    },
    {
      "start": 843.92,
      "end": 845.56,
      "text": "从定调落到资金"
    },
    {
      "start": 845.56,
      "end": 847.56,
      "text": "从方向变成路径"
    }
  ]
}