      "text": "買頭還債"
    },
    {
      "start": 437.96,
      "end": 440.6,
      "text": "這是一種接棒式的槓槓轉移"
    },
    {
      "start": 440.6,
      "end": 442.56,
      "text": "但接棒能接多久"
    },
    {
      "start": 442.56,
      "end": 444.24,
      "text": "能頂多大的缺口"
    },
    {
      "start": 444.24,
      "end": 446.76,
      "text": "是另一個值得長期跟蹤的問題"
    },
    {
      "start": 446.76,
      "end": 449.04,
      "text": "大家都知道的一個概念"
    },
    {
      "start": 449.04,
      "end": 450.72,
      "text": "資產負債表率退"
    },
    {
      "start": 450.72,
      "end": 452.40000000000003,
      "text": "資產拋莫破裂之後"
    },
    {
      "start": 452.40000000000003,
      "end": 454.28000000000003,
      "text": "所有個體從過去的追求"
    },
    {
      "start": 454.28000000000003,
      "end": 455.56,
      "text": "利潤最大化"
    },
    {
      "start": 455.56,
      "end": 458.16,
      "text": "轉變成追求負債最小化"
    },
    {
      "start": 458.16,
      "end": 459.96000000000004,
      "text": "所有人都在將槓槓"
    },
    {
      "start": 459.96000000000004,
      "end": 461.32,
      "text": "壓縮消費"
    },
    {
      "start": 461.32,
      "end": 462.8,
      "text": "優先還債"
    },
    {
      "start": 462.8,
      "end": 464.84000000000003,
      "text": "這不會是短期的情緒波動"
    },
    {
      "start": 464.84000000000003,
      "end": 467.16,
      "text": "而會是一個可能持續數年的"
    },
    {
      "start": 467.16,
      "end": 468.8,
      "text": "漫長修復過程"
    },
    {
      "start": 468.8,
      "end": 469.72,
      "text": "中所周知"
    },
    {
      "start": 469.72,
      "end": 471.72,
      "text": "日本當年也走過這條路"
    },
    {
      "start": 471.72,
      "end": 474.68,
      "text": "用了將近30年才真正走出來"
    },
    {
      "start": 474.68,
      "end": 477.00000000000006,
      "text": "接下來在單獨叔叔房地產"
    },
    {
      "start": 477.00000000000006,
      "end": 478.04,
      "text": "一到五月"
    },
    {
      "start": 478.04,
      "end": 481.96000000000004,
      "text": "全國房地產開發投資3.0356億元"
    },
    {
      "start": 481.96000000000004,
      "end": 484.32000000000005,
      "text": "同比下降16.2%"
    },
    {
      "start": 484.32000000000005,
      "end": 487.44000000000005,
      "text": "五月單月同比下降24.4%"
    },
    {
      "start": 487.44000000000005,
      "end": 489.40000000000003,
      "text": "創今年以來新低"
    },
    {
      "start": 489.40000000000003,
      "end": 491.28000000000003,
      "text": "新建商品房銷售面積"
    },
    {
      "start": 491.28000000000003,
      "end": 493.84000000000003,
      "text": "3.320萬平方米"
    },
    {
      "start": 493.84000000000003,
      "end": 496.08000000000004,
      "text": "同比下降10.8%"
    },
    {
      "start": 496.08000000000004,
      "end": 497.64000000000004,
      "text": "其中住宅銷售面積"
    },
    {
      "start": 497.64000000000004,
      "end": 499.64000000000004,
      "text": "下降12.1%"
    },
    {
      "start": 499.64000000000004,
      "end": 501.24,
      "text": "新建商品房銷售額"
    },
    {
      "start": 501.24,
      "end": 503.44000000000005,
      "text": "29366億元"
    },
    {
      "start": 503.44000000000005,
      "end": 505.24,
      "text": "下降13.5%"
    },
    {
      "start": 505.24,
      "end": 507.04,
      "text": "房地產開發期也到位資金"
    },
    {
      "start": 507.04,
      "end": 509.24,
      "text": "32756億元"
    },
    {
      "start": 509.24,
      "end": 511.44000000000005,
      "text": "同比下降19.0%"
    },
    {
      "start": 511.44000000000005,
      "end": 513.5600000000001,
      "text": "也創了一年以來的心底"
    },
    {
      "start": 513.5600000000001,
      "end": 515.08,
      "text": "整個行業的數據"
    },
    {
      "start": 515.08,
      "end": 516.76,
      "text": "仍然非常不樂觀"
    },
    {
      "start": 516.76,
      "end": 518.6,
      "text": "但市場內部的分化"
    },
    {
      "start": 518.6,
      "end": 520.48,
      "text": "已經相當顯著"
    },
    {
      "start": 520.48,
      "end": 522.2,
      "text": "而且越來越極端"
    },
    {
      "start": 522.2,
      "end": 523.64,
      "text": "一線城市在撐著"
    },
    {
      "start": 523.64,
      "end": 525.64,
      "text": "二三線還在往下走"
    },
    {
      "start": 525.64,
      "end": 527.12,
      "text": "具體數字來看"
    },
    {
      "start": 527.12,
      "end": 528.84,
      "text": "70個大中城市裡"
    },
    {
      "start": 528.84,
      "end": 529.6,
      "text": "五月份"
    },
    {
      "start": 529.6,
      "end": 531.24,
      "text": "新建商品住宅價格"
    },
    {
      "start": 531.24,
      "end": 533.52,
      "text": "還比上漲的城市有16個"
    },
    {
      "start": 533.52,
      "end": 534.24,
      "text": "也就是說"
    },
    {
      "start": 534.24,
      "end": 535.84,
      "text": "剩下54個城市"
    },
    {
      "start": 535.84,
      "end": 537.4399999999999,
      "text": "上個月還在跌"
    },
    {
      "start": 537.4399999999999,
      "end": 539.72,
      "text": "而且你跟前幾個月對比一下"
    },
    {
      "start": 539.72,
      "end": 543.4399999999999,
      "text": "3月份還比上漲的城市有17個"
    },
    {
      "start": 543.4399999999999,
      "end": 544.8,
      "text": "4月份16個"
    },
    {
      "start": 544.8,
      "end": 546.3199999999999,
      "text": "5月份還是16個"
    },
    {
      "start": 546.3199999999999,
      "end": 547.68,
      "text": "趨勢在變差"
    },
    {
      "start": 547.68,
      "end": 550.04,
      "text": "小楊春基本已經熄火了"
    },
    {
      "start": 550.04,
      "end": 551.64,
      "text": "一線城市的新房"
    },
    {
      "start": 551.64,
      "end": 554.56,
      "text": "五月整體還比上漲0.2%"
    },
    {
      "start": 554.56,
      "end": 555.48,
      "text": "其中上海"
    },
    {
      "start": 555.48,
      "end": 556.6,
      "text": "廣州和深圳"
    },
    {
      "start": 556.6,
      "end": 558.56,
      "text": "分別上漲0.2%"
    },
    {
      "start": 558.56,
      "end": 561.12,
      "text": "0.2%和0.4%"
    },
    {
      "start": 561.12,
      "end": 563.4399999999999,
      "text": "北京威將0.2%"
    },
    {
      "start": 563.4399999999999,
      "end": 565.16,
      "text": "二線城市新房還比"
    },
    {
      "start": 565.16,
      "end": 566.84,
      "text": "下漲0.1%"
    },
    {
      "start": 566.84,
      "end": 569.4,
      "text": "三線城市下漲0.4%"
    },
    {
      "start": 569.4,
      "end": 571.8,
      "text": "而且三線的漲幅還在擴大"
    },
    {
      "start": 571.8,
      "end": 573.4,
      "text": "為什麼一線和其他地方"
    },
    {
      "start": 573.4,
      "end": 574.48,
      "text": "分化這麼大"
    },
    {
      "start": 574.48,
      "end": 577.76,
      "text": "核心原因是新房攻擊結構的變化"
    },
    {
      "start": 577.76,
      "end": 578.68,
      "text": "今年以來"
    },
    {
      "start": 578.68,
      "end": 580.56,
      "text": "一線城市10萬元以上"
    },
    {
      "start": 580.5600000000001,
      "end": 583.48,
      "text": "單價的高端改善盤供應越來越多"
    },
    {
      "start": 583.48,
      "end": 585.44,
      "text": "成交佔比持續走高"
    },
    {
      "start": 585.44,
      "end": 587.6800000000001,
      "text": "直接拉高了整體軍駕"
    },
    {
      "start": 587.6800000000001,
      "end": 589.8000000000001,
      "text": "而且這個所謂改善需求"
    },
    {
      "start": 589.8000000000001,
      "end": 592.2,
      "text": "現在不只是要買個大房子"
    },
    {
      "start": 592.2,
      "end": 593.6800000000001,
      "text": "買的是確定性"
    },
    {
      "start": 593.6800000000001,
      "end": 594.8000000000001,
      "text": "核心城市"
    },
    {
      "start": 594.8000000000001,
      "end": 596.0000000000001,
      "text": "核心地段"
    },
    {
      "start": 596.0000000000001,
      "end": 597.84,
      "text": "基本面支撐牆"
    },
    {
      "start": 597.84,
      "end": 600.6800000000001,
      "text": "大家相信它能穿越樓市周期"
    },
    {
      "start": 600.6800000000001,
      "end": 602.5600000000001,
      "text": "所以一線城市的改善盤"
    },
    {
      "start": 602.5600000000001,
      "end": 604.32,
      "text": "有真是需求脫底"
    },
    {
      "start": 604.32,
      "end": 605.96,
      "text": "價格能穩住"
    },
    {
      "start": 605.96,
      "end": 607.84,
      "text": "但這套邏輯放到大部分"
    },
    {
      "start": 607.84,
      "end": 610.1200000000001,
      "text": "二三線城市就明顯失效了"
    },
    {
      "start": 610.16,
      "end": 611.92,
      "text": "改善需求的厚度不夠"
    },
    {
      "start": 611.92,
      "end": 613.76,
      "text": "大家對普通二三線的房產"
    },
    {
      "start": 613.76,
      "end": 616.28,
      "text": "能不能扛住周期沒有信心"
    },
    {
      "start": 616.28,
      "end": 618.68,
      "text": "光靠對產品力是賣不動的"
    },
    {
      "start": 618.68,
      "end": 621.72,
      "text": "二手房的走勢和新房幾乎同品"
    },
    {
      "start": 621.72,
      "end": 623.24,
      "text": "一線城市二手住宅"
    },
    {
      "start": 623.24,
      "end": 625.76,
      "text": "五月還比上漲百分之零點四"
    },
    {
      "start": 625.76,
      "end": 628.04,
      "text": "二線下降百分之零點二"
    },
    {
      "start": 628.04,
      "end": 630.52,
      "text": "三線下降百分之零點四"
    },
    {
      "start": 630.52,
      "end": 631.28,
      "text": "今年以來"
    },
    {
      "start": 631.28,
      "end": 632.6,
      "text": "一線城市二手房"
    },
    {
      "start": 632.6,
      "end": 634.28,
      "text": "已經連續三個月鋪漲"
    },
    {
      "start": 634.28,
      "end": 636.84,
      "text": "是整個市場裡最穩的版塊"
    },
    {
      "start": 636.84,
      "end": 640.0,
      "text": "但五月份一線內部出現了明顯的分化"
    },
    {
      "start": 640.04,
      "end": 641.52,
      "text": "上海深圳二手房"
    },
    {
      "start": 641.52,
      "end": 643.84,
      "text": "還比均漲百分之零點六"
    },
    {
      "start": 643.84,
      "end": 646.64,
      "text": "而北京廣州只漲了百分之零點一"
    },
    {
      "start": 646.64,
      "end": 648.04,
      "text": "差距拉開了"
    },
    {
      "start": 648.04,
      "end": 651.08,
      "text": "百分之零點一的漲幅基本等於吃平"
    },
    {
      "start": 651.08,
      "end": 653.28,
      "text": "後續穩不穩還是問題"
    },
    {
      "start": 653.28,
      "end": 655.36,
      "text": "二三線城市目前仍處於"
    },
    {
      "start": 655.36,
      "end": 656.76,
      "text": "以價換量的階段"
    },
    {
      "start": 656.76,
      "end": 659.0,
      "text": "而且時間節點很關鍵"
    },
    {
      "start": 659.0,
      "end": 660.64,
      "text": "正常樓市行情裡"
    },
    {
      "start": 660.64,
      "end": 661.88,
      "text": "想用春過後"
    },
    {
      "start": 661.88,
      "end": 665.36,
      "text": "五月到八月市場熱度會逐月回落"
    },
    {
      "start": 665.36,
      "end": 667.48,
      "text": "而且現在還有一個現實問題"
    },
    {
      "start": 667.48,
      "end": 670.08,
      "text": "前幾個月剛需集中進場"
    },
    {
      "start": 670.08,
      "end": 672.4,
      "text": "市場上低價優質的二手房"
    },
    {
      "start": 672.4,
      "end": 674.16,
      "text": "消化的差不多了"
    },
    {
      "start": 674.16,
      "end": 676.84,
      "text": "部分業主開始試探性漲價"
    },
    {
      "start": 676.84,
      "end": 680.12,
      "text": "但剛需群體對價格本來就高度敏感"
    },
    {
      "start": 680.12,
      "end": 682.32,
      "text": "加槓桿議員又普遍偏弱"
    },
    {
      "start": 682.32,
      "end": 684.12,
      "text": "根本不接受漲價"
    },
    {
      "start": 684.12,
      "end": 686.04,
      "text": "結果就是成交量下滑"
    },
    {
      "start": 686.04,
      "end": 688.36,
      "text": "買賣雙方進入了新一輪博弈"
    },
    {
      "start": 688.36,
      "end": 689.44,
      "text": "賣家想漲"
    },
    {
      "start": 689.44,
      "end": 690.52,
      "text": "買家不認"
    },
    {
      "start": 690.52,
      "end": 692.88,
      "text": "市場卡在了江持階段"
    },
    {
      "start": 692.88,
      "end": 694.36,
      "text": "最近在看房的朋友"
    },
    {
      "start": 694.36,
      "end": 696.2,
      "text": "應該有直觀感受"
    },
    {
      "start": 696.2,
      "end": 699.08,
      "text": "談價空間比前幾個月小了很多"
    },
    {
      "start": 699.08,
      "end": 701.96,
      "text": "但成交也比前幾個月難了很多"
    },
    {
      "start": 701.96,
      "end": 704.96,
      "text": "五月的金融數據也印證了這一點"
    },
    {
      "start": 704.96,
      "end": 708.0400000000001,
      "text": "居民貸款減少1412億元"
    },
    {
      "start": 708.0400000000001,
      "end": 710.5600000000001,
      "text": "同比多減1952億元"
    },
    {
      "start": 710.5600000000001,
      "end": 712.8000000000001,
      "text": "居民加槓桿的議員很弱"
    },
    {
      "start": 712.8000000000001,
      "end": 715.12,
      "text": "特別是住戶中長期貸款"
    },
    {
      "start": 715.12,
      "end": 717.48,
      "text": "五月減少571億元"
    },
    {
      "start": 717.48,
      "end": 720.36,
      "text": "同比多減1317億元"
    },
    {
      "start": 720.36,
      "end": 722.6800000000001,
      "text": "中長期貸款主要就是房貸"
    },
    {
      "start": 722.6800000000001,
      "end": 724.44,
      "text": "這個數字持續萎縮"
    },
    {
      "start": 724.48,
      "end": 726.48,
      "text": "說明買房的人還是少"
    },
    {
      "start": 726.48,
      "end": 729.12,
      "text": "樓市信心的修復仍然非常緩慢"
    },
    {
      "start": 729.12,
      "end": 732.0400000000001,
      "text": "另外五月居民存款也在下降"
    },
    {
      "start": 732.0400000000001,
      "end": 733.84,
      "text": "減少了1100億元"
    },
    {
      "start": 733.84,
      "end": 736.2800000000001,
      "text": "同比多減5800億元"
    },
    {
      "start": 736.2800000000001,
      "end": 737.96,
      "text": "居民存款搬家"
    },
    {
      "start": 737.96,
      "end": 739.44,
      "text": "資金流向了理財"
    },
    {
      "start": 739.44,
      "end": 742.2,
      "text": "保險和股市等非銀金融領域"
    },
    {
      "start": 742.2,
      "end": 743.84,
      "text": "而不是流向消費"
    },
    {
      "start": 743.84,
      "end": 745.72,
      "text": "錢在金融體系內部轉"
    },
    {
      "start": 745.72,
      "end": 747.5200000000001,
      "text": "沒有轉化為實體消費"
    },
    {
      "start": 747.5200000000001,
      "end": 749.8800000000001,
      "text": "這是另一個值得注意的信號"
    },
    {
      "start": 749.8800000000001,
      "end": 752.6,
      "text": "最後我們再說幾個結構性的判斷"
    },
    {
      "start": 752.6,
      "end": 753.72,
      "text": "第一個判斷"
    },
    {
      "start": 753.72,
      "end": 755.08,
      "text": "這輪消費下行"
    },
    {
      "start": 755.08,
      "end": 758.4,
      "text": "背後有一個經常被忽略的結構性挫衛"
    },
    {
      "start": 758.4,
      "end": 760.6800000000001,
      "text": "和大多數人講的收入預期問題"
    },
    {
      "start": 760.6800000000001,
      "end": 761.9200000000001,
      "text": "不是同一回事"
    },
    {
      "start": 761.9200000000001,
      "end": 763.28,
      "text": "但同樣重要"
    },
    {
      "start": 763.28,
      "end": 764.44,
      "text": "傳統上"
    },
    {
      "start": 764.44,
      "end": 766.72,
      "text": "中國的消費市場主要針對的群體"
    },
    {
      "start": 766.72,
      "end": 769.12,
      "text": "是230歲的年輕人"
    },
    {
      "start": 769.12,
      "end": 770.76,
      "text": "整個市場的產品設計"
    },
    {
      "start": 770.76,
      "end": 773.2,
      "text": "營銷策略渠道佈局"
    },
    {
      "start": 773.2,
      "end": 775.28,
      "text": "都是圍繞這個群體來的"
    },
    {
      "start": 775.28,
      "end": 778.0,
      "text": "但今天的年輕人收入偏低"
    },
    {
      "start": 778.0,
      "end": 779.84,
      "text": "就業市場競爭激烈"
    },
    {
      "start": 779.84,
      "end": 781.52,
      "text": "在AI技術衝擊下"
    },
    {
      "start": 781.52,
      "end": 783.8,
      "text": "收入增長預期還在往下走"
    },
    {
      "start": 783.8,
      "end": 786.0,
      "text": "消費能力本身就受限"
    },
    {
      "start": 786.0,
      "end": 787.12,
      "text": "反過來"
    },
    {
      "start": 787.12,
      "end": 788.76,
      "text": "手裡真正有錢"
    },
    {
      "start": 788.76,
      "end": 790.0799999999999,
      "text": "有消費能力的"
    },
    {
      "start": 790.0799999999999,
      "end": 791.68,
      "text": "是那批剛剛退休"
    },
    {
      "start": 791.68,
      "end": 794.88,
      "text": "但人生狀態完全保持在中年的人"
    },
    {
      "start": 794.88,
      "end": 796.16,
      "text": "他們有機序"
    },
    {
      "start": 796.16,
      "end": 797.1999999999999,
      "text": "有時間"
    },
    {
      "start": 797.1999999999999,
      "end": 798.3199999999999,
      "text": "身體還好"
    },
    {
      "start": 798.3199999999999,
      "end": 799.16,
      "text": "有旅遊"
    },
    {
      "start": 799.16,
      "end": 799.92,
      "text": "有娛樂"
    },
    {
      "start": 799.92,
      "end": 800.8,
      "text": "有學習"
    },
    {
      "start": 800.8,
      "end": 802.96,
      "text": "有體驗的真實需求"
    },
    {
      "start": 802.96,
      "end": 804.88,
      "text": "他們不是沒有消費於往"
    },
    {
      "start": 804.88,
      "end": 806.56,
      "text": "也不是沒有消費能力"
    },
    {
      "start": 806.56,
      "end": 808.0799999999999,
      "text": "但現在整個消費市場"
    },
    {
      "start": 808.0799999999999,
      "end": 809.4,
      "text": "並沒有特別針對性的"
    },
    {
      "start": 809.4,
      "end": 811.16,
      "text": "去為這個群體服務"
    },
    {
      "start": 811.3199999999999,
      "end": 814.3199999999999,
      "text": "消費的攻擊和消費的需求之間"
    },
    {
      "start": 814.3199999999999,
      "end": 815.4,
      "text": "存在一個沒有"
    },
    {
      "start": 815.4,
      "end": 817.48,
      "text": "被很好填補的結構性缺口"
    },
    {
      "start": 817.48,
      "end": 821.16,
      "text": "這是涉令數據長期乘壓的一個深層原因"
    },
    {
      "start": 821.16,
      "end": 822.3199999999999,
      "text": "第二個判斷"
    },
    {
      "start": 822.3199999999999,
      "end": 823.28,
      "text": "經濟數據裡"
    },
    {
      "start": 823.28,
      "end": 825.7199999999999,
      "text": "科技和傳統產業的分化"
    },
    {
      "start": 825.7199999999999,
      "end": 827.24,
      "text": "已經越來越極端"
    },
    {
      "start": 827.24,
      "end": 829.76,
      "text": "而且短期內沒有收窄的跡象"
    },
    {
      "start": 829.76,
      "end": 831.6,
      "text": "5月工業增加質理"
    },
    {
      "start": 831.6,
      "end": 832.56,
      "text": "計算機"
    },
    {
      "start": 832.56,
      "end": 836.36,
      "text": "通信和其他電子設備製造業增長17%"
    },
    {
      "start": 836.36,
      "end": 837.72,
      "text": "明顯領跑"
    },
    {
      "start": 837.76,
      "end": 839.84,
      "text": "機身電路1-5月產量"
    },
    {
      "start": 839.84,
      "end": 842.24,
      "text": "同筆增長25.4%"
    },
    {
      "start": 842.24,
      "end": 844.9200000000001,
      "text": "增加指標升87%"
    },
    {
      "start": 844.9200000000001,
      "end": 848.48,
      "text": "高技術製造業利潤同筆增長44.8%"
    },
    {
      "start": 848.48,
      "end": 850.48,
      "text": "這邊確實非常亮眼"
    },
    {
      "start": 850.48,
      "end": 851.76,
      "text": "但與此同時"
    },
    {
      "start": 851.76,
      "end": 852.64,
      "text": "1-5月"
    },
    {
      "start": 852.64,
      "end": 855.28,
      "text": "剛才產量同筆下降1.5%"
    },
    {
      "start": 855.28,
      "end": 857.5600000000001,
      "text": "水泥下降8.6%"
    },
    {
      "start": 857.5600000000001,
      "end": 860.28,
      "text": "較車下降21.7%"
    },
    {
      "start": 860.28,
      "end": 862.4,
      "text": "傳統行業典型品類"
    },
    {
      "start": 862.4,
      "end": 863.48,
      "text": "灰頭塗臉"
    },
    {
      "start": 863.48,
      "end": 865.28,
      "text": "沒有任何指跌跡象"
    },
    {
      "start": 865.28,
      "end": 867.08,
      "text": "這種極端的結構化行情"
    },
    {
      "start": 867.08,
      "end": 868.5600000000001,
      "text": "反應到資本市場"
    },
    {
      "start": 868.5600000000001,
      "end": 870.6,
      "text": "就是科技板塊持續領跑"
    },
    {
      "start": 870.6,
      "end": 872.12,
      "text": "而傳統消費"
    },
    {
      "start": 872.12,
      "end": 872.6800000000001,
      "text": "地產"
    },
    {
      "start": 872.6800000000001,
      "end": 875.5200000000001,
      "text": "金融等相關板塊長期成壓"
    },
    {
      "start": 875.5200000000001,
      "end": 876.8000000000001,
      "text": "資金很難有動力"
    },
    {
      "start": 876.8000000000001,
      "end": 879.2,
      "text": "從科技轉移到傳統產業"
    },
    {
      "start": 879.2,
      "end": 881.84,
      "text": "上市公司半年報馬上要披露了"
    },
    {
      "start": 881.84,
      "end": 883.08,
      "text": "從5月經濟數據"
    },
    {
      "start": 883.08,
      "end": 885.88,
      "text": "就可以大致預判各個行業的情況"
    },
    {
      "start": 885.88,
      "end": 887.64,
      "text": "整體的板塊分化格局"
    },
    {
      "start": 887.64,
      "end": 889.5600000000001,
      "text": "不會有根本性的改變"
    },
    {
      "start": 889.5600000000001,
      "end": 891.5200000000001,
      "text": "但持有這些老登鼓的朋友"
    },
    {
      "start": 891.5200000000001,
      "end": 893.0,
      "text": "也別太悲觀"
    },
    {
      "start": 893.0,
      "end": 894.24,
      "text": "雖然去年同期"
    },
    {
      "start": 894.24,
      "end": 895.84,
      "text": "國補力度非常大"
    },
    {
      "start": 895.84,
      "end": 897.0400000000001,
      "text": "技術特別高"
    },
    {
      "start": 897.0400000000001,
      "end": 898.52,
      "text": "這個因素從上個月"
    },
    {
      "start": 898.52,
      "end": 900.76,
      "text": "就開始壓制同筆增速了"
    },
    {
      "start": 900.76,
      "end": 902.84,
      "text": "估計到下個月還會持續"
    },
    {
      "start": 902.84,
      "end": 904.52,
      "text": "但如果到七八月份"
    },
    {
      "start": 904.52,
      "end": 906.0,
      "text": "技術效應減弱"
    },
    {
      "start": 906.0,
      "end": 908.4,
      "text": "數據有可能出現改善"
    },
    {
      "start": 908.4,
      "end": 909.6,
      "text": "借食紅官續勢"
    },
    {
      "start": 909.6,
      "end": 911.84,
      "text": "可能會出現一個新的轉折點"
    },
    {
      "start": 911.84,
      "end": 912.5600000000001,
      "text": "不過"
    },
    {
      "start": 912.5600000000001,
      "end": 914.72,
      "text": "在拐點真正到來之前"
    },
    {
      "start": 914.72,
      "end": 916.76,
      "text": "消費數據的壓力還在"
    },
    {
      "start": 916.76,
      "end": 918.1600000000001,
      "text": "市場仍然主要看"
    },
    {
      "start": 918.1600000000001,
      "end": 919.9200000000001,
      "text": "AI產業鏈的臉色"
    },
    {
      "start": 919.9200000000001,
      "end": 921.72,
      "text": "就消費板塊而言"
    },
    {
      "start": 921.72,
      "end": 923.96,
      "text": "系統性的機會依然沒到"
    },
    {
      "start": 923.96,
      "end": 925.96,
      "text": "這個判斷暫時維持不變"
    }
  ]
}