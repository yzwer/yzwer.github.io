      "start": 780.72,
      "end": 781.44,
      "text": "EPROM"
    },
    {
      "start": 781.44,
      "end": 783.08,
      "text": "固件和管理接口"
    },
    {
      "start": 783.08,
      "end": 785.44,
      "text": "理論上確實存在製造中斷"
    },
    {
      "start": 785.44,
      "end": 786.12,
      "text": "誤馬"
    },
    {
      "start": 786.12,
      "end": 788.8,
      "text": "甚至供應鏈植入風險的可能性"
    },
    {
      "start": 788.8,
      "end": 789.68,
      "text": "但要真做到"
    },
    {
      "start": 789.68,
      "end": 791.04,
      "text": "消息人士所說的"
    },
    {
      "start": 791.04,
      "end": 792.52,
      "text": "大規模切取數據"
    },
    {
      "start": 792.52,
      "end": 793.8,
      "text": "安裝惡意軟件"
    },
    {
      "start": 793.8,
      "end": 794.64,
      "text": "技術鏈條"
    },
    {
      "start": 794.64,
      "end": 797.24,
      "text": "遠比主動網絡設備複雜的多"
    },
    {
      "start": 797.24,
      "end": 798.8,
      "text": "目前也沒有公開證據"
    },
    {
      "start": 798.8,
      "end": 800.16,
      "text": "顯示中國光磨塊"
    },
    {
      "start": 800.16,
      "end": 802.36,
      "text": "實際參與過任何攻擊"
    },
    {
      "start": 802.36,
      "end": 805.36,
      "text": "也證因為國家安全層面的必要性"
    },
    {
      "start": 805.36,
      "end": 807.0,
      "text": "比起聯網汽車"
    },
    {
      "start": 807.0,
      "end": 809.6,
      "text": "機器人這些品類要弱一些"
    },
    {
      "start": 809.6,
      "end": 811.76,
      "text": "所以正如前面提到的"
    },
    {
      "start": 811.76,
      "end": 814.2,
      "text": "川普政府這次突然放風"
    },
    {
      "start": 814.2,
      "end": 816.52,
      "text": "更像是在九月峰會前"
    },
    {
      "start": 816.52,
      "end": 818.0,
      "text": "給自己手裡多倍一張"
    },
    {
      "start": 818.0,
      "end": 820.6,
      "text": "能隨時打出去的談判籌碼"
    },
    {
      "start": 820.6,
      "end": 821.72,
      "text": "既然是籌碼"
    },
    {
      "start": 821.72,
      "end": 823.12,
      "text": "就還有談的空間"
    },
    {
      "start": 823.12,
      "end": 825.92,
      "text": "關鍵要看雙方最後拿什麼去交換"
    },
    {
      "start": 825.92,
      "end": 827.4,
      "text": "能不能彈籠"
    },
    {
      "start": 827.4,
      "end": 828.52,
      "text": "對於投資者"
    },
    {
      "start": 828.52,
      "end": 830.32,
      "text": "眼下最該盯緊的"
    },
    {
      "start": 830.32,
      "end": 833.04,
      "text": "是這份草案最終怎麼發現"
    },
    {
      "start": 833.04,
      "end": 835.0,
      "text": "實案企業歸屬定性"
    },
    {
      "start": 835.0,
      "end": 836.8,
      "text": "還是暗生產地界定"
    },
    {
      "start": 836.8,
      "end": 838.4,
      "text": "是指針對新型號"
    },
    {
      "start": 838.4,
      "end": 839.92,
      "text": "還是把成品模塊"
    },
    {
      "start": 839.92,
      "end": 842.0,
      "text": "和上游組件一併納入"
    },
    {
      "start": 842.0,
      "end": 845.2,
      "text": "有沒有給出足夠長的過渡期緩衝"
    },
    {
      "start": 845.2,
      "end": 846.32,
      "text": "這幾個變量"
    },
    {
      "start": 846.32,
      "end": 847.6,
      "text": "決定了最終影響"
    },
    {
      "start": 847.6,
      "end": 850.56,
      "text": "是局部訂單的小範圍重新分配"
    },
    {
      "start": 850.56,
      "end": 853.56,
      "text": "還是持續幾個紀錄的供應鏈地震"
    },
    {
      "start": 853.56,
      "end": 854.92,
      "text": "九月峰會前"
    },
    {
      "start": 854.92,
      "end": 857.8,
      "text": "這張牌大概率還會被反覆量出"
    },
    {
      "start": 857.84,
      "end": 858.56,
      "text": "打不打"
    },
    {
      "start": 858.56,
      "end": 859.24,
      "text": "怎麼打"
    },
    {
      "start": 859.24,
      "end": 860.48,
      "text": "打到什麼程度"
    },
    {
      "start": 860.48,
      "end": 862.28,
      "text": "都得看談判桌上雙方"
    },
    {
      "start": 862.28,
      "end": 864.88,
      "text": "能不能換到各自想要的東西"
    },
    {
      "start": 864.88,
      "end": 867.04,
      "text": "川普政府在中期選舉前"
    },
    {
      "start": 867.04,
      "end": 869.8,
      "text": "也需要一個相對穩定的中美關係"
    },
    {
      "start": 869.8,
      "end": 871.52,
      "text": "不太可能在重要峰會前"
    },
    {
      "start": 871.52,
      "end": 873.48,
      "text": "把關係徹底彈崩"
    },
    {
      "start": 873.48,
      "end": 875.12,
      "text": "但可以確定的是"
    },
    {
      "start": 875.12,
      "end": 877.08,
      "text": "光模塊這條賽道"
    },
    {
      "start": 877.08,
      "end": 880.04,
      "text": "已經被捲進大國博弈的玄國中心"
    },
    {
      "start": 880.04,
      "end": 881.32,
      "text": "封口在某"
    },
    {
      "start": 881.32,
      "end": 883.48,
      "text": "也扛不住地緣政治這把例件"
    },
    {
      "start": 883.48,
      "end": 884.96,
      "text": "投資者手裡的標地"
    },
    {
      "start": 884.96,
      "end": 886.4,
      "text": "到底是去世流"
    },
    {
      "start": 886.4,
      "end": 888.64,
      "text": "這個問題現在必須想清楚了"
    }
  ],
  "language": "zh"
}