    {
      "start": 559.2,
      "end": 560.6,
      "text": "但不能指问这些"
    },
    {
      "start": 561.16,
      "end": 562.52,
      "text": "记者有没有瑕疵"
    },
    {
      "start": 562.88,
      "end": 563.88,
