    {
      "start": 305.08000000000004,
      "end": 307.8,
      "text": "三大品牌分别公布了最新检测报告"
    },
    {
      "start": 308.16,
      "end": 309.84000000000003,
      "text": "依然是未检出假先案"
    },
    {
      "start": 310.36,
      "end": 311.56000000000006,
      "text": "babycare还表示"
    },
    {
      "start": 311.8,
      "end": 314.48,
      "text": "已就布什信息向公安机关报案"
    },
    {
      "start": 315.20000000000005,
      "end": 316.6,
      "text": "但随机有媒体质疑"
    },
    {
      "start": 316.88000000000005,
      "end": 320.6,
      "text": "好奇只要库送检的机构与品牌本身存在关联"
    },
    {
      "start": 320.96000000000004,
      "end": 323.6,
      "text": "且检测报告既没有CNAS认可"
    },
    {
      "start": 323.6,
      "end": 325.20000000000005,
      "text": "也没有CNMA自治认定"
    },
    {
      "start": 325.52000000000004,
      "end": 327.44000000000005,
      "text": "不具备对社会的证明效力"
    },
    {
      "start": 327.88000000000005,
      "end": 328.64000000000004,
      "text": "21日晚"
