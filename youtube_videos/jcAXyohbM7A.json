    {
      "start": 328.96000000000004,
      "end": 330.68,
      "text": "王文志发出了一封公开信"
    },
    {
      "start": 331.08000000000004,
      "end": 333.92,
      "text": "题目是至相关监管部门的公开信"
    },
    {
      "start": 334.20000000000005,
      "end": 336.68,
      "text": "只为那些体内检出假先案的孩子"
    },
    {
      "start": 337.16,
      "end": 339.00000000000006,
      "text": "他在心里逐条回应质疑"
    },
    {
      "start": 339.28,
      "end": 341.8,
      "text": "检测设备是业内主流专业设备"
