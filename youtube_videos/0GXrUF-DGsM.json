    },
    {
      "start": 545.72,
      "end": 547.6,
      "text": "且回款越來越慢"
    },
    {
      "start": 547.6,
      "end": 548.6,
      "text": "與此同時"
    },
    {
      "start": 548.6,
      "end": 551.6,
      "text": "私企的資產負債率還在編輯台升"
