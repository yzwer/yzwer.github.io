    {
      "start": 581.0,
      "end": 583.84,
      "text": "電子半導體的需求擴張還在繼續"
    },
    {
      "start": 583.84,
      "end": 586.1999999999999,
      "text": "這幾條線的任性還在"
    },
    {
      "start": 586.1999999999999,
      "end": 587.24,
      "text": "政策端"
    },
    {
      "start": 587.24,
      "end": 588.84,
      "text": "設備更新和消費品"
    },
    {
      "start": 588.84,
      "end": 591.0,
      "text": "已就換新還沒完全消退"
